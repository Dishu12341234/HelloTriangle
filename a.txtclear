include/stb-master/stb_ds.h:/* stb_ds.h - v0.67 - public domain data structures - Sean Barrett 2019
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:   This is a single-header-file library that provides easy-to-use
include/stb-master/stb_ds.h:   dynamic arrays and hash tables for C (also works in C++).
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:   For a gentle introduction:
include/stb-master/stb_ds.h:      http://nothings.org/stb_ds
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:   To use this library, do this in *one* C or C++ file:
include/stb-master/stb_ds.h:      #define STB_DS_IMPLEMENTATION
include/stb-master/stb_ds.h:      #include "stb_ds.h"
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:TABLE OF CONTENTS
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  Table of Contents
include/stb-master/stb_ds.h:  Compile-time options
include/stb-master/stb_ds.h:  License
include/stb-master/stb_ds.h:  Documentation
include/stb-master/stb_ds.h:  Notes
include/stb-master/stb_ds.h:  Notes - Dynamic arrays
include/stb-master/stb_ds.h:  Notes - Hash maps
include/stb-master/stb_ds.h:  Credits
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:COMPILE-TIME OPTIONS
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  #define STBDS_NO_SHORT_NAMES
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     This flag needs to be set globally.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     By default stb_ds exposes shorter function names that are not qualified
include/stb-master/stb_ds.h:     with the "stbds_" prefix. If these names conflict with the names in your
include/stb-master/stb_ds.h:     code, define this flag.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  #define STBDS_SIPHASH_2_4
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     This flag only needs to be set in the file containing #define STB_DS_IMPLEMENTATION.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     By default stb_ds.h hashes using a weaker variant of SipHash and a custom hash for
include/stb-master/stb_ds.h:     4- and 8-byte keys. On 64-bit platforms, you can define the above flag to force
include/stb-master/stb_ds.h:     stb_ds.h to use specification-compliant SipHash-2-4 for all keys. Doing so makes
include/stb-master/stb_ds.h:     hash table insertion about 20% slower on 4- and 8-byte keys, 5% slower on
include/stb-master/stb_ds.h:     64-byte keys, and 10% slower on 256-byte keys on my test computer.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  #define STBDS_REALLOC(context,ptr,size) better_realloc
include/stb-master/stb_ds.h:  #define STBDS_FREE(context,ptr)         better_free
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     These defines only need to be set in the file containing #define STB_DS_IMPLEMENTATION.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     By default stb_ds uses stdlib realloc() and free() for memory management. You can
include/stb-master/stb_ds.h:     substitute your own functions instead by defining these symbols. You must either
include/stb-master/stb_ds.h:     define both, or neither. Note that at the moment, 'context' will always be NULL.
include/stb-master/stb_ds.h:     @TODO add an array/hash initialization function that takes a memory context pointer.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  #define STBDS_UNIT_TESTS
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:     Defines a function stbds_unit_tests() that checks the functioning of the data structures.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  Note that on older versions of gcc (e.g. 5.x.x) you may need to build with '-std=c++0x'
include/stb-master/stb_ds.h:     (or equivalentally '-std=c++11') when using anonymous structures as seen on the web
include/stb-master/stb_ds.h:     page or in STBDS_UNIT_TESTS.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:LICENSE
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  Placed in the public domain and also MIT licensed.
include/stb-master/stb_ds.h:  See end of file for detailed license information.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:DOCUMENTATION
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  Dynamic Arrays
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Non-function interface:
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      Declare an empty dynamic array of type T
include/stb-master/stb_ds.h:        T* foo = NULL;
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      Access the i'th item of a dynamic array 'foo' of type T, T* foo:
include/stb-master/stb_ds.h:        foo[i]
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Functions (actually macros)
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrfree:
include/stb-master/stb_ds.h:        void arrfree(T*);
include/stb-master/stb_ds.h:          Frees the array.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrlen:
include/stb-master/stb_ds.h:        ptrdiff_t arrlen(T*);
include/stb-master/stb_ds.h:          Returns the number of elements in the array.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrlenu:
include/stb-master/stb_ds.h:        size_t arrlenu(T*);
include/stb-master/stb_ds.h:          Returns the number of elements in the array as an unsigned type.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrpop:
include/stb-master/stb_ds.h:        T arrpop(T* a)
include/stb-master/stb_ds.h:          Removes the final element of the array and returns it.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrput:
include/stb-master/stb_ds.h:        T arrput(T* a, T b);
include/stb-master/stb_ds.h:          Appends the item b to the end of array a. Returns b.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrins:
include/stb-master/stb_ds.h:        T arrins(T* a, int p, T b);
include/stb-master/stb_ds.h:          Inserts the item b into the middle of array a, into a[p],
include/stb-master/stb_ds.h:          moving the rest of the array over. Returns b.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrinsn:
include/stb-master/stb_ds.h:        void arrinsn(T* a, int p, int n);
include/stb-master/stb_ds.h:          Inserts n uninitialized items into array a starting at a[p],
include/stb-master/stb_ds.h:          moving the rest of the array over.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arraddnptr:
include/stb-master/stb_ds.h:        T* arraddnptr(T* a, int n)
include/stb-master/stb_ds.h:          Appends n uninitialized items onto array at the end.
include/stb-master/stb_ds.h:          Returns a pointer to the first uninitialized item added.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arraddnindex:
include/stb-master/stb_ds.h:        size_t arraddnindex(T* a, int n)
include/stb-master/stb_ds.h:          Appends n uninitialized items onto array at the end.
include/stb-master/stb_ds.h:          Returns the index of the first uninitialized item added.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrdel:
include/stb-master/stb_ds.h:        void arrdel(T* a, int p);
include/stb-master/stb_ds.h:          Deletes the element at a[p], moving the rest of the array over.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrdeln:
include/stb-master/stb_ds.h:        void arrdeln(T* a, int p, int n);
include/stb-master/stb_ds.h:          Deletes n elements starting at a[p], moving the rest of the array over.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrdelswap:
include/stb-master/stb_ds.h:        void arrdelswap(T* a, int p);
include/stb-master/stb_ds.h:          Deletes the element at a[p], replacing it with the element from
include/stb-master/stb_ds.h:          the end of the array. O(1) performance.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrsetlen:
include/stb-master/stb_ds.h:        void arrsetlen(T* a, int n);
include/stb-master/stb_ds.h:          Changes the length of the array to n. Allocates uninitialized
include/stb-master/stb_ds.h:          slots at the end if necessary.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrsetcap:
include/stb-master/stb_ds.h:        size_t arrsetcap(T* a, int n);
include/stb-master/stb_ds.h:          Sets the length of allocated storage to at least n. It will not
include/stb-master/stb_ds.h:          change the length of the array.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      arrcap:
include/stb-master/stb_ds.h:        size_t arrcap(T* a);
include/stb-master/stb_ds.h:          Returns the number of total elements the array can contain without
include/stb-master/stb_ds.h:          needing to be reallocated.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  Hash maps & String hash maps
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Given T is a structure type: struct { TK key; TV value; }. Note that some
include/stb-master/stb_ds.h:    functions do not require TV value and can have other fields. For string
include/stb-master/stb_ds.h:    hash maps, TK must be 'char *'.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Special interface:
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      stbds_rand_seed:
include/stb-master/stb_ds.h:        void stbds_rand_seed(size_t seed);
include/stb-master/stb_ds.h:          For security against adversarially chosen data, you should seed the
include/stb-master/stb_ds.h:          library with a strong random number. Or at least seed it with time().
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      stbds_hash_string:
include/stb-master/stb_ds.h:        size_t stbds_hash_string(char *str, size_t seed);
include/stb-master/stb_ds.h:          Returns a hash value for a string.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      stbds_hash_bytes:
include/stb-master/stb_ds.h:        size_t stbds_hash_bytes(void *p, size_t len, size_t seed);
include/stb-master/stb_ds.h:          These functions hash an arbitrary number of bytes. The function
include/stb-master/stb_ds.h:          uses a custom hash for 4- and 8-byte data, and a weakened version
include/stb-master/stb_ds.h:          of SipHash for everything else. On 64-bit platforms you can get
include/stb-master/stb_ds.h:          specification-compliant SipHash-2-4 on all data by defining
include/stb-master/stb_ds.h:          STBDS_SIPHASH_2_4, at a significant cost in speed.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Non-function interface:
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      Declare an empty hash map of type T
include/stb-master/stb_ds.h:        T* foo = NULL;
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      Access the i'th entry in a hash table T* foo:
include/stb-master/stb_ds.h:        foo[i]
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:    Function interface (actually macros):
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      hmfree
include/stb-master/stb_ds.h:      shfree
include/stb-master/stb_ds.h:        void hmfree(T*);
include/stb-master/stb_ds.h:        void shfree(T*);
include/stb-master/stb_ds.h:          Frees the hashmap and sets the pointer to NULL.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      hmlen
include/stb-master/stb_ds.h:      shlen
include/stb-master/stb_ds.h:        ptrdiff_t hmlen(T*)
include/stb-master/stb_ds.h:        ptrdiff_t shlen(T*)
include/stb-master/stb_ds.h:          Returns the number of elements in the hashmap.
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:      hmlenu
