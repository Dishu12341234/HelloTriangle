include/stb-master/stb_image.h:{
include/stb-master/stb_image.h:   stbi_uc x;
include/stb-master/stb_image.h:   if (j->marker != STBI__MARKER_none) { x = j->marker; j->marker = STBI__MARKER_none; return x; }
include/stb-master/stb_image.h:   x = stbi__get8(j->s);
include/stb-master/stb_image.h:   if (x != 0xff) return STBI__MARKER_none;
include/stb-master/stb_image.h:   while (x == 0xff)
include/stb-master/stb_image.h:      x = stbi__get8(j->s); // consume repeated 0xff fill bytes
include/stb-master/stb_image.h:   return x;
include/stb-master/stb_image.h:}
