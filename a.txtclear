GameMeshObject.cxx:{
GameMeshObject.cxx:    vkDestroyBuffer(vkContext.device, indexBuffer, nullptr);
GameMeshObject.cxx:    vkFreeMemory(vkContext.device, indexBufferMemory, nullptr);
GameMeshObject.cxx:
