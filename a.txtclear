include/stb-master/stb_textedit.h:      return;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // we need to do two things: apply the undo record, and create a redo record
include/stb-master/stb_textedit.h:   u = s->undo_rec[s->undo_point-1];
include/stb-master/stb_textedit.h:   r = &s->undo_rec[s->redo_point-1];
include/stb-master/stb_textedit.h:   r->char_storage = -1;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   r->insert_length = u.delete_length;
include/stb-master/stb_textedit.h:   r->delete_length = u.insert_length;
include/stb-master/stb_textedit.h:   r->where = u.where;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   if (u.delete_length) {
