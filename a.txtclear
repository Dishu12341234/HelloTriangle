include/stb-master/deprecated/stb.h:   #define STB__IMPORT   STB_EXTERN __declspec(dllimport)
include/stb-master/deprecated/stb.h:   #define STB__DW       unsigned long
include/stb-master/deprecated/stb.h:   #endif
