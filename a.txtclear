include/stb-master/tests/caveview/stb_glprog.h:extern GLuint stbgl_create_program(char const **vertex_source, char const **frag_source, char const **binds, char *error, int error_buflen);
include/stb-master/tests/caveview/stb_glprog.h:// This function returns a compiled program or 0 if there's an error.
include/stb-master/tests/caveview/stb_glprog.h:// To free the created program, call stbgl_delete_program.
include/stb-master/tests/caveview/stb_glprog.h://
include/stb-master/tests/caveview/stb_glprog.h://     stbgl_create_program(
include/stb-master/tests/caveview/stb_glprog.h://             char **vertex_source,   // NULL or one or more strings with the vertex shader source, with a final NULL
include/stb-master/tests/caveview/stb_glprog.h://             char **frag_source,     // NULL or one or more strings with the fragment shader source, with a final NULL
include/stb-master/tests/caveview/stb_glprog.h://             char **binds,           // NULL or zero or more strings with attribute bind names, with a final NULL
include/stb-master/tests/caveview/stb_glprog.h://             char *error,            // output location where compile error message is placed
include/stb-master/tests/caveview/stb_glprog.h://             int error_buflen)       // length of error output buffer
include/stb-master/tests/caveview/stb_glprog.h://
include/stb-master/tests/caveview/stb_glprog.h:// Returns a GLuint with the GL program object handle.
include/stb-master/tests/caveview/stb_glprog.h://
include/stb-master/tests/caveview/stb_glprog.h:// If an individual bind string is "", no name is bound to that slot (this
include/stb-master/tests/caveview/stb_glprog.h:// allows you to create binds that aren't continuous integers starting at 0).
include/stb-master/tests/caveview/stb_glprog.h://
include/stb-master/tests/caveview/stb_glprog.h:// If the vertex shader is NULL, then fixed-function vertex pipeline
include/stb-master/tests/caveview/stb_glprog.h:// is used, if that's legal in your version of GL.
include/stb-master/tests/caveview/stb_glprog.h://
include/stb-master/tests/caveview/stb_glprog.h:// If the fragment shader is NULL, then fixed-function fragment pipeline
include/stb-master/tests/caveview/stb_glprog.h:// is used, if that's legal in your version of GL.
