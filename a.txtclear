HelloTriangleApplication.cxx:#include "HelloTriangleApplication.hpp"
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:void HelloTriangleApplication::mainLoop()
HelloTriangleApplication.cxx:{
HelloTriangleApplication.cxx:    while (!glfwWindowShouldClose(_window))
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        event->eventLoop();
HelloTriangleApplication.cxx:        if(!gameObjectPool.ready)
HelloTriangleApplication.cxx:        {
HelloTriangleApplication.cxx:            gameObjectPool.uploadChunk();
HelloTriangleApplication.cxx:            continue;
HelloTriangleApplication.cxx:        }
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:        drawFrame();
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:}
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:void HelloTriangleApplication::drawFrame()
HelloTriangleApplication.cxx:{
HelloTriangleApplication.cxx:    // 1️⃣ Wait for previous frame to finish
HelloTriangleApplication.cxx:    vkWaitForFences(device, 1, &inFlightFences[currentFrame], VK_TRUE, UINT64_MAX);
HelloTriangleApplication.cxx:    vkResetFences(device, 1, &inFlightFences[currentFrame]);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 2️⃣ Acquire an image from the swapchain
HelloTriangleApplication.cxx:    uint32_t imageIndex;
HelloTriangleApplication.cxx:    VkResult res = vkAcquireNextImageKHR(
HelloTriangleApplication.cxx:        device,
HelloTriangleApplication.cxx:        swapChain,
HelloTriangleApplication.cxx:        UINT64_MAX,
HelloTriangleApplication.cxx:        imageAvailableSemaphores[currentFrame], // still per-frame
HelloTriangleApplication.cxx:        VK_NULL_HANDLE,
HelloTriangleApplication.cxx:        &imageIndex);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    if (res != VK_SUCCESS && res != VK_SUBOPTIMAL_KHR)
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        throw std::runtime_error("failed to acquire swap chain image!");
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 3️⃣ Reset the command buffer for this frame
HelloTriangleApplication.cxx:    vkResetCommandBuffer(commandBuffers[currentFrame], 0); // or VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 4️⃣ Record drawing commands into the command buffer
HelloTriangleApplication.cxx:    recordCommandBuffer(commandBuffers[currentFrame], imageIndex);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    updateShaderStorageBuffer(currentFrame);
HelloTriangleApplication.cxx:    updateUniformBuffer(currentFrame);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 5️⃣ Submit the command buffer to the graphics queue
HelloTriangleApplication.cxx:    VkSubmitInfo submitInfo{};
HelloTriangleApplication.cxx:    submitInfo.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    VkSemaphore waitSemaphores[] = {imageAvailableSemaphores[currentFrame]};
HelloTriangleApplication.cxx:    VkPipelineStageFlags waitStages[] = {VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT};
HelloTriangleApplication.cxx:    submitInfo.waitSemaphoreCount = 1;
HelloTriangleApplication.cxx:    submitInfo.pWaitSemaphores = waitSemaphores;
HelloTriangleApplication.cxx:    submitInfo.pWaitDstStageMask = waitStages;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    submitInfo.commandBufferCount = 1;
HelloTriangleApplication.cxx:    submitInfo.pCommandBuffers = &commandBuffers[currentFrame];
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // ✅ Use renderFinishedSemaphore per swapchain image
HelloTriangleApplication.cxx:    VkSemaphore signalSemaphores[] = {renderFinishedSemaphores[imageIndex]};
HelloTriangleApplication.cxx:    submitInfo.signalSemaphoreCount = 1;
HelloTriangleApplication.cxx:    submitInfo.pSignalSemaphores = signalSemaphores;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    if (vkQueueSubmit(graphicsQueue, 1, &submitInfo, inFlightFences[currentFrame]) != VK_SUCCESS)
HelloTriangleApplication.cxx:        throw std::runtime_error("failed to submit draw command buffer!");
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 6️⃣ Present the image
HelloTriangleApplication.cxx:    VkPresentInfoKHR presentInfo{};
HelloTriangleApplication.cxx:    presentInfo.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR;
HelloTriangleApplication.cxx:    presentInfo.waitSemaphoreCount = 1;
HelloTriangleApplication.cxx:    presentInfo.pWaitSemaphores = signalSemaphores;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    VkSwapchainKHR swapChains[] = {swapChain};
HelloTriangleApplication.cxx:    presentInfo.swapchainCount = 1;
HelloTriangleApplication.cxx:    presentInfo.pSwapchains = swapChains;
HelloTriangleApplication.cxx:    presentInfo.pImageIndices = &imageIndex;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkQueuePresentKHR(presentQueue, &presentInfo);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // 7️⃣ Advance frame
HelloTriangleApplication.cxx:    currentFrame = (currentFrame + 1) % MAX_FRAMES_IN_FLIGHT;
HelloTriangleApplication.cxx:}
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:void HelloTriangleApplication::cleanup()
HelloTriangleApplication.cxx:{
HelloTriangleApplication.cxx:    vkDeviceWaitIdle(device);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    gameObjectPool.cleanUpResources();
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    delete event;
HelloTriangleApplication.cxx:    delete camera;
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroyBuffer(device, indexBuffer, nullptr);
HelloTriangleApplication.cxx:    vkFreeMemory(device, indexBufferMemory, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroyBuffer(device, vertexBuffer, nullptr);
HelloTriangleApplication.cxx:    vkFreeMemory(device, vertexBufferMemory, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        vkDestroyBuffer(device, ssboBuffers[i], nullptr);
HelloTriangleApplication.cxx:        vkFreeMemory(device, ssboBuffersMemory[i], nullptr);
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // Destroy per-frame semaphores and fences
HelloTriangleApplication.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        vkDestroySemaphore(device, imageAvailableSemaphores[i], nullptr);
HelloTriangleApplication.cxx:        vkDestroyFence(device, inFlightFences[i], nullptr);
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    // Destroy per-swapchain-image render-finished semaphores
HelloTriangleApplication.cxx:    for (size_t i = 0; i < renderFinishedSemaphores.size(); i++)
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        vkDestroySemaphore(device, renderFinishedSemaphores[i], nullptr);
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroyCommandPool(device, commandPool, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    for (auto framebuffer : swapChainFramebuffers)
HelloTriangleApplication.cxx:        vkDestroyFramebuffer(device, framebuffer, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    graphicsPipeline.destroyPipelineLayout();
HelloTriangleApplication.cxx:    vkDestroyRenderPass(device, renderPass, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    for (auto imageView : swapChainImageViews)
HelloTriangleApplication.cxx:        vkDestroyImageView(device, imageView, nullptr);
HelloTriangleApplication.cxx:    vkDestroyImageView(device, colorImageView, nullptr);
HelloTriangleApplication.cxx:    vkDestroyImage(device, colorImage, nullptr);
HelloTriangleApplication.cxx:    vkFreeMemory(device, colorImageMemory, nullptr);
HelloTriangleApplication.cxx:    vkDestroyImageView(device, depthImageView, nullptr);
HelloTriangleApplication.cxx:    vkDestroyImage(device, depthImage, nullptr);
HelloTriangleApplication.cxx:    vkFreeMemory(device, depthImageMemory, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroySwapchainKHR(device, swapChain, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    texture.destroy();
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
HelloTriangleApplication.cxx:    {
HelloTriangleApplication.cxx:        vkDestroyBuffer(device, uniformBuffers[i], nullptr);
HelloTriangleApplication.cxx:        vkFreeMemory(device, uniformBuffersMemory[i], nullptr);
HelloTriangleApplication.cxx:    }
HelloTriangleApplication.cxx:    vkDestroyDescriptorPool(device, descriptorPool, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroyDescriptorSetLayout(device, descriptorSetLayout, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    vkDestroyDevice(device, nullptr);
HelloTriangleApplication.cxx:    vkDestroySurfaceKHR(instance, surface, nullptr);
HelloTriangleApplication.cxx:    vkDestroyInstance(instance, nullptr);
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:    glfwDestroyWindow(_window);
HelloTriangleApplication.cxx:    glfwTerminate();
HelloTriangleApplication.cxx:}
HelloTriangleApplication.cxx:
HelloTriangleApplication.cxx:HelloTriangleApplication::HelloTriangleApplication()
HelloTriangleApplication.cxx:{
HelloTriangleApplication.cxx:}
