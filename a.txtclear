include/stb-master/stb_rect_pack.h:   STBRP_HEURISTIC_Skyline_BL_sortHeight = STBRP_HEURISTIC_Skyline_default,
include/stb-master/stb_rect_pack.h:   STBRP_HEURISTIC_Skyline_BF_sortHeight
include/stb-master/stb_rect_pack.h:};
