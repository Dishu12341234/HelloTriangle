include/stb-master/stb_truetype.h:         for (;;++i) {
include/stb-master/stb_truetype.h:            if (!STBTT__COMPARE(&p[i], &p[0])) break;
include/stb-master/stb_truetype.h:         }
include/stb-master/stb_truetype.h:         for (;;--j) {
include/stb-master/stb_truetype.h:            if (!STBTT__COMPARE(&p[0], &p[j])) break;
include/stb-master/stb_truetype.h:         }
include/stb-master/stb_truetype.h:         /* make sure we haven't crossed */
include/stb-master/stb_truetype.h:         if (i >= j) break;
include/stb-master/stb_truetype.h:         t = p[i];
include/stb-master/stb_truetype.h:         p[i] = p[j];
