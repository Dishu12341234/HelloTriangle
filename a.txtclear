include/stb-master/stb_include.h:static void stb_include_itoa(char str[9], int n)
include/stb-master/stb_include.h:{
include/stb-master/stb_include.h:   int i;
include/stb-master/stb_include.h:   for (i=0; i < 8; ++i)
include/stb-master/stb_include.h:      str[i] = ' ';
include/stb-master/stb_include.h:   str[i] = 0;
include/stb-master/stb_include.h:
include/stb-master/stb_include.h:   for (i=1; i < 8; ++i) {
include/stb-master/stb_include.h:      str[7-i] = '0' + (n % 10);
include/stb-master/stb_include.h:      n /= 10;
include/stb-master/stb_include.h:      if (n == 0)
include/stb-master/stb_include.h:         break;
include/stb-master/stb_include.h:   }
include/stb-master/stb_include.h:}
