include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:   stb_leakcheck_malloc_info *mi = (stb_leakcheck_malloc_info *) malloc(sz + sizeof(*mi));
include/stb-master/stb_leakcheck.h:   if (mi == NULL) return mi;
include/stb-master/stb_leakcheck.h:   mi->file = file;
include/stb-master/stb_leakcheck.h:   mi->line = line;
include/stb-master/stb_leakcheck.h:   mi->next = mi_head;
include/stb-master/stb_leakcheck.h:   if (mi_head)
include/stb-master/stb_leakcheck.h:      mi->next->prev = mi;
include/stb-master/stb_leakcheck.h:   mi->prev = NULL;
include/stb-master/stb_leakcheck.h:   mi->size = (int) sz;
include/stb-master/stb_leakcheck.h:   mi_head = mi;
include/stb-master/stb_leakcheck.h:   return mi+1;
include/stb-master/stb_leakcheck.h:}
include/stb-master/stb_leakcheck.h:
include/stb-master/stb_leakcheck.h:void stb_leakcheck_free(void *ptr)
include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:   if (ptr != NULL) {
include/stb-master/stb_leakcheck.h:      stb_leakcheck_malloc_info *mi = (stb_leakcheck_malloc_info *) ptr - 1;
include/stb-master/stb_leakcheck.h:      mi->size = ~mi->size;
include/stb-master/stb_leakcheck.h:      #ifndef STB_LEAKCHECK_SHOWALL
include/stb-master/stb_leakcheck.h:      if (mi->prev == NULL) {
include/stb-master/stb_leakcheck.h:         assert(mi_head == mi);
include/stb-master/stb_leakcheck.h:         mi_head = mi->next;
include/stb-master/stb_leakcheck.h:      } else
include/stb-master/stb_leakcheck.h:         mi->prev->next = mi->next;
include/stb-master/stb_leakcheck.h:      if (mi->next)
include/stb-master/stb_leakcheck.h:         mi->next->prev = mi->prev;
include/stb-master/stb_leakcheck.h:      free(mi);
include/stb-master/stb_leakcheck.h:      #endif
include/stb-master/stb_leakcheck.h:   }
include/stb-master/stb_leakcheck.h:}
