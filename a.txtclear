include/stb-master/tests/caveview/stb_gl.h:extern unsigned int stbgl_rand(void); // internal, but exposed just in case; LCG, so use middle bits
include/stb-master/tests/caveview/stb_gl.h:
include/stb-master/tests/caveview/stb_gl.h:extern int stbgl_TexImage2D(int texid, int w, int h, void *data, char *props);
include/stb-master/tests/caveview/stb_gl.h:extern int stbgl_TexImage2D_Extra(int texid, int w, int h, void *data, int chan, char *props, int preserve_data);
include/stb-master/tests/caveview/stb_gl.h:// "props" is a series of characters (and blocks of characters), a la fopen()'s mode,
include/stb-master/tests/caveview/stb_gl.h:// e.g.:
include/stb-master/tests/caveview/stb_gl.h://   GLuint texid = stbgl_LoadTexture("myfile.jpg", "mbc")
include/stb-master/tests/caveview/stb_gl.h://      means: load the image "myfile.jpg", and do the following:
include/stb-master/tests/caveview/stb_gl.h://                generate mipmaps
include/stb-master/tests/caveview/stb_gl.h://                use bilinear filtering (not trilinear)
include/stb-master/tests/caveview/stb_gl.h://                use clamp-to-edge on both channels
include/stb-master/tests/caveview/stb_gl.h://
include/stb-master/tests/caveview/stb_gl.h:// input descriptor: AT MOST ONE
include/stb-master/tests/caveview/stb_gl.h://   TEXT     MEANING
include/stb-master/tests/caveview/stb_gl.h://    1         1 channel of input (intensity/alpha)
include/stb-master/tests/caveview/stb_gl.h://    2         2 channels of input (luminance, alpha)
include/stb-master/tests/caveview/stb_gl.h://    3         3 channels of input (RGB)
include/stb-master/tests/caveview/stb_gl.h://    4         4 channels of input (RGBA)
include/stb-master/tests/caveview/stb_gl.h://    l         1 channel of input (luminance)
include/stb-master/tests/caveview/stb_gl.h://    a         1 channel of input (alpha)
include/stb-master/tests/caveview/stb_gl.h://    la        2 channels of input (lum/alpha)
include/stb-master/tests/caveview/stb_gl.h://    rgb       3 channels of input (RGB)
include/stb-master/tests/caveview/stb_gl.h://    ycocg     3 channels of input (YCoCg - forces YCoCg output)
include/stb-master/tests/caveview/stb_gl.h://    ycocgj    4 channels of input (YCoCgJunk - forces YCoCg output)
include/stb-master/tests/caveview/stb_gl.h://    rgba      4 channels of input (RGBA)
include/stb-master/tests/caveview/stb_gl.h://    
include/stb-master/tests/caveview/stb_gl.h:// output descriptor: AT MOST ONE
include/stb-master/tests/caveview/stb_gl.h://   TEXT     MEANING
include/stb-master/tests/caveview/stb_gl.h://    A         1 channel of output (alpha)
include/stb-master/tests/caveview/stb_gl.h://    I         1 channel of output (intensity)
include/stb-master/tests/caveview/stb_gl.h://    LA        2 channels of output (lum/alpha)
include/stb-master/tests/caveview/stb_gl.h://    RGB       3 channels of output (RGB)
include/stb-master/tests/caveview/stb_gl.h://    RGBA      4 channels of output (RGBA)
include/stb-master/tests/caveview/stb_gl.h://    DXT1      encode as a DXT1 texture (RGB unless input has RGBA)
include/stb-master/tests/caveview/stb_gl.h://    DXT3      encode as a DXT3 texture
include/stb-master/tests/caveview/stb_gl.h://    DXT5      encode as a DXT5 texture
include/stb-master/tests/caveview/stb_gl.h://    YCoCg     encode as a DXT5 texture with Y in alpha, CoCg in RG
include/stb-master/tests/caveview/stb_gl.h://    D         GL_DEPTH_COMPONENT
include/stb-master/tests/caveview/stb_gl.h://    NONE      no input/output, don't call TexImage2D at all
include/stb-master/tests/caveview/stb_gl.h://
include/stb-master/tests/caveview/stb_gl.h:// when reading from a file or using another interface with an explicit
include/stb-master/tests/caveview/stb_gl.h:// channel count, the input descriptor is ignored and instead the channel
include/stb-master/tests/caveview/stb_gl.h:// count is used as the input descriptor. if the file read is a DXT DDS,
include/stb-master/tests/caveview/stb_gl.h:// then it is passed directly to OpenGL in the file format.
include/stb-master/tests/caveview/stb_gl.h://
include/stb-master/tests/caveview/stb_gl.h:// if an input descriptor is supplied but no output descriptor, the output
include/stb-master/tests/caveview/stb_gl.h:// is assumed to be the same as the input. if an output descriptor is supplied
include/stb-master/tests/caveview/stb_gl.h:// but no input descriptor, the input is assumed to be the same as the
include/stb-master/tests/caveview/stb_gl.h:// output. if neither is supplied, the input is assumed to be 4-channel.
include/stb-master/tests/caveview/stb_gl.h:// If DXT1 or YCoCG output is requested with no input, the input is assumed
include/stb-master/tests/caveview/stb_gl.h:// to be 4-channel but the alpha channel is ignored.
include/stb-master/tests/caveview/stb_gl.h://
include/stb-master/tests/caveview/stb_gl.h:// filtering descriptor (default is no mipmaps)
include/stb-master/tests/caveview/stb_gl.h://   TEXT     MEANING
include/stb-master/tests/caveview/stb_gl.h://    m         generate mipmaps
include/stb-master/tests/caveview/stb_gl.h://    M         mipmaps are provided, concatenated at end of data (from largest to smallest)
include/stb-master/tests/caveview/stb_gl.h://    t         use trilinear filtering (default if mipmapped)
include/stb-master/tests/caveview/stb_gl.h://    b         use bilinear filtering (default if not-mipmapped)
include/stb-master/tests/caveview/stb_gl.h://    n         use nearest-neighbor sampling
include/stb-master/tests/caveview/stb_gl.h://
include/stb-master/tests/caveview/stb_gl.h:// wrapping descriptor
include/stb-master/tests/caveview/stb_gl.h://   TEXT     MEANING
