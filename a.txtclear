include/stb-master/stb_c_lexer.h:int main(int argc, char **argv)
include/stb-master/stb_c_lexer.h:{
include/stb-master/stb_c_lexer.h:   FILE *f = fopen("stb_c_lexer.h","rb");
include/stb-master/stb_c_lexer.h:   char *text = (char *) malloc(1 << 20);
include/stb-master/stb_c_lexer.h:   int len = f ? (int) fread(text, 1, 1<<20, f) : -1;
include/stb-master/stb_c_lexer.h:   stb_lexer lex;
include/stb-master/stb_c_lexer.h:   if (len < 0) {
include/stb-master/stb_c_lexer.h:      fprintf(stderr, "Error opening file\n");
include/stb-master/stb_c_lexer.h:      free(text);
include/stb-master/stb_c_lexer.h:      fclose(f);
include/stb-master/stb_c_lexer.h:      return 1;
include/stb-master/stb_c_lexer.h:   }
include/stb-master/stb_c_lexer.h:   fclose(f);
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:   stb_c_lexer_init(&lex, text, text+len, (char *) malloc(0x10000), 0x10000);
include/stb-master/stb_c_lexer.h:   while (stb_c_lexer_get_token(&lex)) {
include/stb-master/stb_c_lexer.h:      if (lex.token == CLEX_parse_error) {
include/stb-master/stb_c_lexer.h:         printf("\n<<<PARSE ERROR>>>\n");
include/stb-master/stb_c_lexer.h:         break;
include/stb-master/stb_c_lexer.h:      }
include/stb-master/stb_c_lexer.h:      print_token(&lex);
include/stb-master/stb_c_lexer.h:      printf("  ");
include/stb-master/stb_c_lexer.h:   }
include/stb-master/stb_c_lexer.h:   return 0;
include/stb-master/stb_c_lexer.h:}
