include/stb-master/stb_include.h:{
include/stb-master/stb_include.h:   char *text;
include/stb-master/stb_include.h:   size_t len;
include/stb-master/stb_include.h:   FILE *f = fopen(filename, "rb");
include/stb-master/stb_include.h:   if (f == 0) return 0;
include/stb-master/stb_include.h:   fseek(f, 0, SEEK_END);
include/stb-master/stb_include.h:   len = (size_t) ftell(f);
include/stb-master/stb_include.h:   if (plen) *plen = len;
include/stb-master/stb_include.h:   text = (char *) malloc(len+1);
include/stb-master/stb_include.h:   if (text == 0) return 0;
include/stb-master/stb_include.h:   fseek(f, 0, SEEK_SET);
include/stb-master/stb_include.h:   fread(text, 1, len, f);
include/stb-master/stb_include.h:   fclose(f);
include/stb-master/stb_include.h:   text[len] = 0;
include/stb-master/stb_include.h:   return text;
include/stb-master/stb_include.h:}
