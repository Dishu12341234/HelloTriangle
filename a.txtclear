Camera.cxx:#define DEG_TO_RAD 0.017453293
Camera.cxx:
Camera.cxx:
Camera.cxx:Camera::Camera(VulkanContext vkContext)
Camera.cxx:{
Camera.cxx:    this->vkContext = vkContext;
Camera.cxx:}
Camera.cxx:
Camera.cxx:void Camera::updateUBO(UniformBufferObject &UBO,
Camera.cxx:                       VkExtent2D &swapChainExtent,
Camera.cxx:                       Event &event)
Camera.cxx:{
Camera.cxx:    // ======== Persistent State ========
Camera.cxx:    static float yaw   = -90.0f;
Camera.cxx:    static float pitch = 0.0f;
Camera.cxx:
Camera.cxx:    static double lastX = event.mouseX;
Camera.cxx:    static double lastY = event.mouseY;
Camera.cxx:
Camera.cxx:    static float smoothDX = 0.0f;
Camera.cxx:    static float smoothDY = 0.0f;
Camera.cxx:
Camera.cxx:    float dt = event.dt * 0.001f; // ms -> seconds
Camera.cxx:
Camera.cxx:    // ======== Mouse Delta ========
Camera.cxx:    double dx = lastX - event.mouseX;
Camera.cxx:    double dy = lastY - event.mouseY;
Camera.cxx:
Camera.cxx:    lastX = event.mouseX;
Camera.cxx:    lastY = event.mouseY;
Camera.cxx:
Camera.cxx:    // ======== Mouse Smoothing ========
Camera.cxx:    float smoothing = 12.0f;
Camera.cxx:    float alpha = 1.0f - exp(-smoothing * dt);
Camera.cxx:
Camera.cxx:    smoothDX += (dx - smoothDX) * alpha;
Camera.cxx:    smoothDY += (dy - smoothDY) * alpha;
Camera.cxx:
Camera.cxx:    float sensitivity = 0.1f;
Camera.cxx:
Camera.cxx:    yaw   += smoothDX * sensitivity;
Camera.cxx:    pitch += smoothDY * sensitivity;
Camera.cxx:
Camera.cxx:    pitch = glm::clamp(pitch, -89.9f, 89.9f);
Camera.cxx:
Camera.cxx:    // ======== Direction Vectors ========
Camera.cxx:    glm::vec3 forward;
Camera.cxx:    forward.x = cos(glm::radians(yaw)) * cos(glm::radians(pitch));
Camera.cxx:    forward.y = sin(glm::radians(yaw)) * cos(glm::radians(pitch));
Camera.cxx:    forward.z = sin(glm::radians(pitch));
Camera.cxx:    forward   = glm::normalize(forward);
Camera.cxx:
Camera.cxx:    glm::vec3 worldUp(0.0f, 0.0f, 1.0f);
Camera.cxx:
Camera.cxx:    // --- Flatten forward for ground movement ---
Camera.cxx:    glm::vec3 forwardFlat = glm::normalize(
Camera.cxx:        glm::vec3(forward.x, forward.y, 0.0f)
Camera.cxx:    );
Camera.cxx:
Camera.cxx:    glm::vec3 right = glm::normalize(glm::cross(forwardFlat, worldUp));
Camera.cxx:
Camera.cxx:    // ======== Movement ========
Camera.cxx:    float speed = 2.0f;
Camera.cxx:    float velocity = speed * dt;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_W))
Camera.cxx:        cameraPos += forwardFlat * velocity;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_S))
Camera.cxx:        cameraPos -= forwardFlat * velocity;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_A))
Camera.cxx:        cameraPos -= right * velocity;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_D))
Camera.cxx:        cameraPos += right * velocity;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_SPACE))
Camera.cxx:        cameraPos.z += velocity;
Camera.cxx:
Camera.cxx:    if (event.getKeyPressed(GLFW_KEY_LEFT_SHIFT))
Camera.cxx:        cameraPos.z -= velocity;
Camera.cxx:
Camera.cxx:    // ======== View Matrix ========
Camera.cxx:    UBO.view = glm::lookAt(
Camera.cxx:        cameraPos,
Camera.cxx:        cameraPos + forward,
Camera.cxx:        worldUp);
Camera.cxx:
Camera.cxx:    // ======== Projection Matrix ========
Camera.cxx:    UBO.proj = glm::perspective(
Camera.cxx:        glm::radians(45.0f),
Camera.cxx:        swapChainExtent.width / (float)swapChainExtent.height,
Camera.cxx:        0.1f,
Camera.cxx:        100.0f);
Camera.cxx:
Camera.cxx:    UBO.proj[1][1] *= -1; // Vulkan clip correction
Camera.cxx:}
Camera.cxx:
Camera.cxx:glm::vec3 Camera::gePositionInWorldCoords()
Camera.cxx:{
Camera.cxx:    return cameraPos * 10.f;
Camera.cxx:}
Camera.cxx:
Camera.cxx:Camera::~Camera()
Camera.cxx:{
Camera.cxx:}
