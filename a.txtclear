include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_GetKerningTable(const stbtt_fontinfo *info, stbtt_kerningentry* table, int table_length);
include/stb-master/stb_truetype.h:// Retrieves a complete list of all of the kerning pairs provided by the font
include/stb-master/stb_truetype.h:// stbtt_GetKerningTable never writes more than table_length entries and returns how many entries it did write.
include/stb-master/stb_truetype.h:// The table will be sorted by (a.glyph1 == b.glyph1)?(a.glyph2 < b.glyph2):(a.glyph1 < b.glyph1)
