include/stb-master/stb_truetype.h:      /* partition loop */
include/stb-master/stb_truetype.h:      i=1;
include/stb-master/stb_truetype.h:      j=n-1;
include/stb-master/stb_truetype.h:      for(;;) {
include/stb-master/stb_truetype.h:         /* handling of equality is crucial here */
