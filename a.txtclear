include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:static stbtt__buf stbtt__buf_range(const stbtt__buf *b, int o, int s)
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   stbtt__buf r = stbtt__new_buf(NULL, 0);
include/stb-master/stb_truetype.h:   if (o < 0 || s < 0 || o > b->size || s > b->size - o) return r;
include/stb-master/stb_truetype.h:   r.data = b->data + o;
include/stb-master/stb_truetype.h:   r.size = s;
include/stb-master/stb_truetype.h:   return r;
include/stb-master/stb_truetype.h:}
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:static stbtt__buf stbtt__cff_get_index(stbtt__buf *b)
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   int count, start, offsize;
include/stb-master/stb_truetype.h:   start = b->cursor;
include/stb-master/stb_truetype.h:   count = stbtt__buf_get16(b);
include/stb-master/stb_truetype.h:   if (count) {
include/stb-master/stb_truetype.h:      offsize = stbtt__buf_get8(b);
include/stb-master/stb_truetype.h:      STBTT_assert(offsize >= 1 && offsize <= 4);
include/stb-master/stb_truetype.h:      stbtt__buf_skip(b, offsize * count);
include/stb-master/stb_truetype.h:      stbtt__buf_skip(b, stbtt__buf_get(b, offsize) - 1);
include/stb-master/stb_truetype.h:   }
include/stb-master/stb_truetype.h:   return stbtt__buf_range(b, start, b->cursor - start);
include/stb-master/stb_truetype.h:}
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:static stbtt_uint32 stbtt__cff_int(stbtt__buf *b)
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   int b0 = stbtt__buf_get8(b);
include/stb-master/stb_truetype.h:   if (b0 >= 32 && b0 <= 246)       return b0 - 139;
include/stb-master/stb_truetype.h:   else if (b0 >= 247 && b0 <= 250) return (b0 - 247)*256 + stbtt__buf_get8(b) + 108;
include/stb-master/stb_truetype.h:   else if (b0 >= 251 && b0 <= 254) return -(b0 - 251)*256 - stbtt__buf_get8(b) - 108;
include/stb-master/stb_truetype.h:   else if (b0 == 28)               return stbtt__buf_get16(b);
include/stb-master/stb_truetype.h:   else if (b0 == 29)               return stbtt__buf_get32(b);
include/stb-master/stb_truetype.h:   STBTT_assert(0);
include/stb-master/stb_truetype.h:   return 0;
include/stb-master/stb_truetype.h:}
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:static void stbtt__cff_skip_operand(stbtt__buf *b) {
include/stb-master/stb_truetype.h:   int v, b0 = stbtt__buf_peek8(b);
include/stb-master/stb_truetype.h:   STBTT_assert(b0 >= 28);
include/stb-master/stb_truetype.h:   if (b0 == 30) {
