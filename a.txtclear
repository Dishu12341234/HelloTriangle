include/stb-master/stb_dxt.h:// Compile with STB_DXT_IMPLEMENTATION and STB_DXT_GENERATE_TABLES
include/stb-master/stb_dxt.h:// defined to generate the tables above.
include/stb-master/stb_dxt.h:#ifdef STB_DXT_GENERATE_TABLES
include/stb-master/stb_dxt.h:#include <stdio.h>
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:int main()
include/stb-master/stb_dxt.h:{
include/stb-master/stb_dxt.h:   int i, j;
include/stb-master/stb_dxt.h:   const char *omatch_names[] = { "stb__OMatch5", "stb__OMatch6" };
include/stb-master/stb_dxt.h:   int dequant_mults[2] = { 33*4, 65 }; // .4 fixed-point dequant multipliers
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   // optimal endpoint tables
include/stb-master/stb_dxt.h:   for (i = 0; i < 2; ++i) {
include/stb-master/stb_dxt.h:      int dequant = dequant_mults[i];
include/stb-master/stb_dxt.h:      int size = i ? 64 : 32;
include/stb-master/stb_dxt.h:      printf("static const unsigned char %s[256][2] = {\n", omatch_names[i]);
include/stb-master/stb_dxt.h:      for (int j = 0; j < 256; ++j) {
include/stb-master/stb_dxt.h:         int mn, mx;
include/stb-master/stb_dxt.h:         int best_mn = 0, best_mx = 0;
include/stb-master/stb_dxt.h:         int best_err = 256 * 100;
include/stb-master/stb_dxt.h:         for (mn=0;mn<size;mn++) {
include/stb-master/stb_dxt.h:            for (mx=0;mx<size;mx++) {
include/stb-master/stb_dxt.h:               int mine = (mn * dequant) >> 4;
include/stb-master/stb_dxt.h:               int maxe = (mx * dequant) >> 4;
include/stb-master/stb_dxt.h:               int err = abs(stb__Lerp13(maxe, mine) - j) * 100;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:               // DX10 spec says that interpolation must be within 3% of "correct" result,
include/stb-master/stb_dxt.h:               // add this as error term. Normally we'd expect a random distribution of
include/stb-master/stb_dxt.h:               // +-1.5% error, but nowhere in the spec does it say that the error has to be
include/stb-master/stb_dxt.h:               // unbiased - better safe than sorry.
include/stb-master/stb_dxt.h:               err += abs(maxe - mine) * 3;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:               if(err < best_err) {
include/stb-master/stb_dxt.h:                  best_mn = mn;
include/stb-master/stb_dxt.h:                  best_mx = mx;
include/stb-master/stb_dxt.h:                  best_err = err;
include/stb-master/stb_dxt.h:               }
include/stb-master/stb_dxt.h:            }
include/stb-master/stb_dxt.h:         }
include/stb-master/stb_dxt.h:         if ((j % 8) == 0) printf("  "); // 2 spaces, third is done below
include/stb-master/stb_dxt.h:         printf(" { %2d, %2d },", best_mx, best_mn);
include/stb-master/stb_dxt.h:         if ((j % 8) == 7) printf("\n");
include/stb-master/stb_dxt.h:      }
include/stb-master/stb_dxt.h:      printf("};\n");
include/stb-master/stb_dxt.h:   }
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   return 0;
include/stb-master/stb_dxt.h:}
include/stb-master/stb_dxt.h:#endif
