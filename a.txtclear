include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h:// TILESET DATA STRUCTURE
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h:// if you use the image-to-tileset system from this file, you
include/stb-master/stb_herringbone_wang_tile.h:// don't need to worry about these data structures. but if you
include/stb-master/stb_herringbone_wang_tile.h:// want to build/load a tileset yourself, you'll need to fill
include/stb-master/stb_herringbone_wang_tile.h:// these out.
include/stb-master/stb_herringbone_wang_tile.h:
include/stb-master/stb_herringbone_wang_tile.h:typedef struct
include/stb-master/stb_herringbone_wang_tile.h:{
include/stb-master/stb_herringbone_wang_tile.h:   // the edge or vertex constraints, according to diagram below
include/stb-master/stb_herringbone_wang_tile.h:   signed char a,b,c,d,e,f;
include/stb-master/stb_herringbone_wang_tile.h:
include/stb-master/stb_herringbone_wang_tile.h:   // The herringbone wang tile data; it is a bitmap which is either
include/stb-master/stb_herringbone_wang_tile.h:   // w=2*short_sidelen,h=short_sidelen, or w=short_sidelen,h=2*short_sidelen.
include/stb-master/stb_herringbone_wang_tile.h:   // it is always RGB, stored row-major, with no padding between rows.
include/stb-master/stb_herringbone_wang_tile.h:   // (allocate stbhw_tile structure to be large enough for the pixel data)
include/stb-master/stb_herringbone_wang_tile.h:   unsigned char pixels[1];
include/stb-master/stb_herringbone_wang_tile.h:} stbhw_tile;
include/stb-master/stb_herringbone_wang_tile.h:
include/stb-master/stb_herringbone_wang_tile.h:struct stbhw_tileset
