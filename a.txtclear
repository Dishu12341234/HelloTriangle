GraphicsPipeline.cxx:
GraphicsPipeline.cxx:void u_GraphicsPipeline::createGraphicsPipeline()
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    std::cout << "Creating Graphics Pipeline..." << std::endl;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    auto vertShaderCode = readFile("shaders/simple_shader_v.spv");
GraphicsPipeline.cxx:    auto fragShaderCode = readFile("shaders/simple_shader_f.spv");
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkShaderModule vertShaderModule = createShaderModule(vertShaderCode);
GraphicsPipeline.cxx:    VkShaderModule fragShaderModule = createShaderModule(fragShaderCode);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // shaderStageCreation
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineShaderStageCreateInfo vertShaderStageInfo{};
GraphicsPipeline.cxx:    vertShaderStageInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
GraphicsPipeline.cxx:    vertShaderStageInfo.stage = VK_SHADER_STAGE_VERTEX_BIT; // telling vulkan 'which stage must this shader go'
GraphicsPipeline.cxx:    vertShaderStageInfo.module = vertShaderModule;
GraphicsPipeline.cxx:    vertShaderStageInfo.pName = "main";
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineShaderStageCreateInfo fragShaderStageInfo{};
GraphicsPipeline.cxx:    fragShaderStageInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
GraphicsPipeline.cxx:    fragShaderStageInfo.stage = VK_SHADER_STAGE_FRAGMENT_BIT;
GraphicsPipeline.cxx:    fragShaderStageInfo.module = fragShaderModule;
GraphicsPipeline.cxx:    fragShaderStageInfo.pName = "main";
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineShaderStageCreateInfo shaderStages[] = {vertShaderStageInfo, fragShaderStageInfo};
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    auto bindingDescription = Vertex::getBindingDescription();
GraphicsPipeline.cxx:    auto attributeDescriptions = Vertex::getAttributeDescriptions();
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineVertexInputStateCreateInfo vertexInputInfo{};
GraphicsPipeline.cxx:    vertexInputInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    vertexInputInfo.vertexBindingDescriptionCount = 1;
GraphicsPipeline.cxx:    vertexInputInfo.vertexAttributeDescriptionCount = static_cast<uint32_t>(attributeDescriptions.size());
GraphicsPipeline.cxx:    vertexInputInfo.pVertexBindingDescriptions = &bindingDescription;
GraphicsPipeline.cxx:    vertexInputInfo.pVertexAttributeDescriptions = attributeDescriptions.data();
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // input assembly
GraphicsPipeline.cxx:    VkPipelineInputAssemblyStateCreateInfo inputAssembly{};
GraphicsPipeline.cxx:    inputAssembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    inputAssembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
GraphicsPipeline.cxx:    inputAssembly.primitiveRestartEnable = VK_FALSE;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // viewport and scissors
GraphicsPipeline.cxx:    VkViewport viewport{};
GraphicsPipeline.cxx:    viewport.x = .0f;
GraphicsPipeline.cxx:    viewport.y = .0f;
GraphicsPipeline.cxx:    viewport.width = (float)swapChainExtent.width;
GraphicsPipeline.cxx:    viewport.height = (float)swapChainExtent.height; // this swapchain is used as a framebuffer hensforth using it as the size for our viewport
GraphicsPipeline.cxx:    viewport.minDepth = .0f;
GraphicsPipeline.cxx:    viewport.maxDepth = 1.0f;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkRect2D scissor{};
GraphicsPipeline.cxx:    scissor.offset = {0, 0};
GraphicsPipeline.cxx:    scissor.extent = swapChainExtent;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // //dyanmic scissor and viewport
GraphicsPipeline.cxx:    // std::vector<VkDynamicState> dynamicStates =
GraphicsPipeline.cxx:    // {
GraphicsPipeline.cxx:    //     VK_DYNAMIC_STATE_VIEWPORT,
GraphicsPipeline.cxx:    //     VK_DYNAMIC_STATE_SCISSOR
GraphicsPipeline.cxx:    // };
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // VkPipelineDynamicStateCreateInfo dynamicState{};
GraphicsPipeline.cxx:    // dynamicState.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    // dynamicState.dynamicStateCount = static_cast<uint32_t>(dynamicStates.size());
GraphicsPipeline.cxx:    // dynamicState.pDynamicStates = dynamicStates.data();
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineViewportStateCreateInfo viewportState{};
GraphicsPipeline.cxx:    viewportState.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    viewportState.viewportCount = 1;
GraphicsPipeline.cxx:    viewportState.pViewports = &viewport;
GraphicsPipeline.cxx:    viewportState.scissorCount = 1;
GraphicsPipeline.cxx:    viewportState.pScissors = &scissor;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // Rasterizer
GraphicsPipeline.cxx:    VkPipelineRasterizationStateCreateInfo rasterizer{};
GraphicsPipeline.cxx:    rasterizer.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    rasterizer.depthClampEnable = VK_FALSE;
GraphicsPipeline.cxx:    rasterizer.rasterizerDiscardEnable = VK_FALSE;
GraphicsPipeline.cxx:    rasterizer.polygonMode = VK_POLYGON_MODE_FILL;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    rasterizer.lineWidth = 1.0f;
GraphicsPipeline.cxx:    rasterizer.cullMode = VK_CULL_MODE_NONE;
GraphicsPipeline.cxx:    rasterizer.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    rasterizer.depthBiasEnable = VK_FALSE;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // MSSA(disabled for now)
GraphicsPipeline.cxx:    VkPipelineMultisampleStateCreateInfo multisampling{};
GraphicsPipeline.cxx:    multisampling.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    multisampling.sampleShadingEnable = VK_TRUE;
GraphicsPipeline.cxx:    multisampling.rasterizationSamples = msaaSamples;
GraphicsPipeline.cxx:    multisampling.minSampleShading = .2f;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineDepthStencilStateCreateInfo depthStencil{};
GraphicsPipeline.cxx:    depthStencil.sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    depthStencil.depthTestEnable = VK_TRUE;
GraphicsPipeline.cxx:    depthStencil.depthWriteEnable = VK_TRUE;
GraphicsPipeline.cxx:    depthStencil.depthCompareOp = VK_COMPARE_OP_LESS;
GraphicsPipeline.cxx:    depthStencil.depthBoundsTestEnable = VK_FALSE;
GraphicsPipeline.cxx:    depthStencil.minDepthBounds = 0.0f; // Optional
GraphicsPipeline.cxx:    depthStencil.maxDepthBounds = 1.0f; // Optional
GraphicsPipeline.cxx:    depthStencil.stencilTestEnable = VK_FALSE;
GraphicsPipeline.cxx:    depthStencil.front = {}; // Optional
GraphicsPipeline.cxx:    depthStencil.back = {};  // Optional
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    /// color blending
GraphicsPipeline.cxx:    VkPipelineColorBlendAttachmentState colorBlendAttachment{};
GraphicsPipeline.cxx:    colorBlendAttachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
GraphicsPipeline.cxx:    colorBlendAttachment.blendEnable = VK_FALSE;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPipelineColorBlendStateCreateInfo colorBlending{};
GraphicsPipeline.cxx:    colorBlending.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
GraphicsPipeline.cxx:    colorBlending.logicOpEnable = VK_FALSE;
GraphicsPipeline.cxx:    colorBlending.attachmentCount = 1;
GraphicsPipeline.cxx:    colorBlending.pAttachments = &colorBlendAttachment;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // Pipeline Layout
GraphicsPipeline.cxx:    //(passing data to uniform objects in shaders)
GraphicsPipeline.cxx:    VkPipelineLayoutCreateInfo pipelineLayoutInfo{};
GraphicsPipeline.cxx:    pipelineLayoutInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
GraphicsPipeline.cxx:    pipelineLayoutInfo.setLayoutCount = 1;
GraphicsPipeline.cxx:    pipelineLayoutInfo.pSetLayouts = descriptorSetLayout;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkPushConstantRange pushConstatn;
GraphicsPipeline.cxx:    pushConstatn.offset = 0;
GraphicsPipeline.cxx:    pushConstatn.size = sizeof(PushConstantC1);
GraphicsPipeline.cxx:    pushConstatn.stageFlags = VK_SHADER_STAGE_VERTEX_BIT;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    pipelineLayoutInfo.pPushConstantRanges = &pushConstatn;
GraphicsPipeline.cxx:    pipelineLayoutInfo.pushConstantRangeCount = 1;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    if (vkCreatePipelineLayout(device, &pipelineLayoutInfo, nullptr, &pipelineLayout) != VK_SUCCESS)
GraphicsPipeline.cxx:    {
GraphicsPipeline.cxx:        throw std::runtime_error("failed to create pipeline layout!");
GraphicsPipeline.cxx:    }
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // creating graphics pipeline
GraphicsPipeline.cxx:    VkGraphicsPipelineCreateInfo pipelineInfo{};
GraphicsPipeline.cxx:    pipelineInfo.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
GraphicsPipeline.cxx:    pipelineInfo.stageCount = 2; // the shader stage count
GraphicsPipeline.cxx:    pipelineInfo.pStages = shaderStages;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    pipelineInfo.pVertexInputState = &vertexInputInfo;
GraphicsPipeline.cxx:    pipelineInfo.pInputAssemblyState = &inputAssembly;
GraphicsPipeline.cxx:    pipelineInfo.pViewportState = &viewportState;
GraphicsPipeline.cxx:    pipelineInfo.pRasterizationState = &rasterizer;
GraphicsPipeline.cxx:    pipelineInfo.pMultisampleState = &multisampling;
GraphicsPipeline.cxx:    pipelineInfo.pDepthStencilState = &depthStencil; // disabled
GraphicsPipeline.cxx:    pipelineInfo.pColorBlendState = &colorBlending;
GraphicsPipeline.cxx:    // pipelineInfo.pDynamicState = &dynamic_state;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    pipelineInfo.layout = pipelineLayout;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    pipelineInfo.renderPass = renderPass; // passs the render pass
GraphicsPipeline.cxx:    pipelineInfo.subpass = 0;
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    if (vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &graphicsPipeline) != VK_SUCCESS)
GraphicsPipeline.cxx:    {
GraphicsPipeline.cxx:        throw std::runtime_error("failed to create graphics pipeline!");
GraphicsPipeline.cxx:    }
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    vkDestroyShaderModule(device, fragShaderModule, nullptr);
GraphicsPipeline.cxx:    vkDestroyShaderModule(device, vertShaderModule, nullptr);
GraphicsPipeline.cxx:    // vulkan copies it internally so it can be destroid safely
GraphicsPipeline.cxx:}
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:void u_GraphicsPipeline::u_PassGraphicsPipelineCreateInfo(u_GraphicsPipelineCreateInfo pCreateInfo)
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    device = pCreateInfo.device;
GraphicsPipeline.cxx:    height = pCreateInfo.height;
GraphicsPipeline.cxx:    width = pCreateInfo.width;
GraphicsPipeline.cxx:    swapChainExtent = pCreateInfo.swapChainExtent;
GraphicsPipeline.cxx:    renderPass = pCreateInfo.renderPass;
GraphicsPipeline.cxx:    descriptorSetLayout = pCreateInfo.descriptorSetLayout;
GraphicsPipeline.cxx:    msaaSamples = pCreateInfo.msaaSamples;
GraphicsPipeline.cxx:}
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:std::vector<char> u_GraphicsPipeline::readFile(const std::string &filename)
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    std::ifstream file(filename, std::ios::ate | std::ios::binary);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    if (!file.is_open())
GraphicsPipeline.cxx:    {
GraphicsPipeline.cxx:        std::cout << "File: " << filename << std::endl;
GraphicsPipeline.cxx:        throw std::runtime_error("Failed to open file");
GraphicsPipeline.cxx:    }
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    size_t fileSize = (size_t)file.tellg();
GraphicsPipeline.cxx:    std::vector<char> buffer(fileSize);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    file.seekg(0);
GraphicsPipeline.cxx:    file.read(buffer.data(), fileSize);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    file.close();
GraphicsPipeline.cxx:    return buffer;
GraphicsPipeline.cxx:}
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:VkShaderModule u_GraphicsPipeline::createShaderModule(const std::vector<char> &code)
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    VkShaderModuleCreateInfo createInfo{};
GraphicsPipeline.cxx:    createInfo.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
GraphicsPipeline.cxx:    createInfo.codeSize = code.size();
GraphicsPipeline.cxx:    createInfo.pCode = reinterpret_cast<const uint32_t *>(code.data());
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    VkShaderModule shaderModule;
GraphicsPipeline.cxx:    if (vkCreateShaderModule(device, &createInfo, nullptr, &shaderModule) != VK_SUCCESS)
GraphicsPipeline.cxx:    {
GraphicsPipeline.cxx:        throw std::runtime_error("Failed to create shader module");
GraphicsPipeline.cxx:    }
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    return shaderModule;
GraphicsPipeline.cxx:}
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:// Telling vulkan how to pass data to the vertex shader once it's been uploaded into the GPU
GraphicsPipeline.cxx:VkVertexInputBindingDescription Vertex::getBindingDescription()
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    VkVertexInputBindingDescription bindingDescription{};
GraphicsPipeline.cxx:    // A vertex binding describes at which rate to load data from memory throughout the verticies.
GraphicsPipeline.cxx:    // It specifies the number of bytes between data entries and whether to move to the next data entery after each vertex or after each instance.
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    bindingDescription.binding = 0; // binding index to zero
GraphicsPipeline.cxx:    bindingDescription.stride = sizeof(Vertex);
GraphicsPipeline.cxx:    bindingDescription.inputRate = VK_VERTEX_INPUT_RATE_VERTEX; // advance to the next input per vertex
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    return bindingDescription;
GraphicsPipeline.cxx:}
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:// this structure describies how to handle vertex input
GraphicsPipeline.cxx:// each attribute required its own description
GraphicsPipeline.cxx:std::array<VkVertexInputAttributeDescription, 4> Vertex::getAttributeDescriptions()
GraphicsPipeline.cxx:{
GraphicsPipeline.cxx:    std::array<VkVertexInputAttributeDescription, 4> attributeDescriptions{};
GraphicsPipeline.cxx:    attributeDescriptions[0].binding = 0;                         // same as getBindingDescription
GraphicsPipeline.cxx:    attributeDescriptions[0].location = 0;                        // directly co-relates to 'layout(location = 0)'
GraphicsPipeline.cxx:    attributeDescriptions[0].format = VK_FORMAT_R32G32B32_SFLOAT; // vec3
GraphicsPipeline.cxx:    attributeDescriptions[0].offset = offsetof(Vertex, pos);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    attributeDescriptions[1].binding = 0;
GraphicsPipeline.cxx:    attributeDescriptions[1].location = 1;
GraphicsPipeline.cxx:    attributeDescriptions[1].format = VK_FORMAT_R32G32B32_SFLOAT; // vec3
GraphicsPipeline.cxx:    attributeDescriptions[1].offset = offsetof(Vertex, color);
GraphicsPipeline.cxx:    
GraphicsPipeline.cxx:    attributeDescriptions[2].binding = 0;
GraphicsPipeline.cxx:    attributeDescriptions[2].location = 2;
GraphicsPipeline.cxx:    attributeDescriptions[2].format = VK_FORMAT_R32G32_SFLOAT;
GraphicsPipeline.cxx:    attributeDescriptions[2].offset = offsetof(Vertex, texCoord);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    attributeDescriptions[3].binding = 0;
GraphicsPipeline.cxx:    attributeDescriptions[3].location = 3;
GraphicsPipeline.cxx:    attributeDescriptions[3].format = VK_FORMAT_R32_UINT;
GraphicsPipeline.cxx:    attributeDescriptions[3].offset = offsetof(Vertex, vertexIndex);
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    // Formats
GraphicsPipeline.cxx:    //  float -> VK_FORMAT_R32_SFLOAT
GraphicsPipeline.cxx:    //  vec2  -> VK_FORMAT_R32G32_SFLOAT
GraphicsPipeline.cxx:    //  vec3  -> VK_FORMAT_R32G32B32_SFLOAT
GraphicsPipeline.cxx:    //  vec4  -> VK_FORMAT_R32G32B32A32_SFLOAT
GraphicsPipeline.cxx:    // ivec2  -> VK_FORMAT_R32G32_SINT
GraphicsPipeline.cxx:    // uvec4  -> VK_FORMAT_R32G32B32A32_UINT
GraphicsPipeline.cxx:    // double -> VK_FORMAT_R64_SFLOAT
GraphicsPipeline.cxx:    // u32    -> VK_FORMAT_R32_UINT
GraphicsPipeline.cxx:    // u64    -> VK_FORMAT_R64_UINT
GraphicsPipeline.cxx:
GraphicsPipeline.cxx:    return attributeDescriptions;
GraphicsPipeline.cxx:}
