include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// per vertex:
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://     x:7
include/stb-master/stb_voxel_render.h://     y:7
include/stb-master/stb_voxel_render.h://     z:9
include/stb-master/stb_voxel_render.h://     ao:6
include/stb-master/stb_voxel_render.h://     tex_lerp:3
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// per face:
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://     tex1:8
include/stb-master/stb_voxel_render.h://     tex2:8
include/stb-master/stb_voxel_render.h://     face:8
include/stb-master/stb_voxel_render.h://     color:8
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:// Faces:
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Faces use the bottom 3 bits to choose the texgen
include/stb-master/stb_voxel_render.h:// mode, and all the bits to choose the normal.
include/stb-master/stb_voxel_render.h:// Thus the bottom 3 bits have to be:
include/stb-master/stb_voxel_render.h://      e, n, w, s, u, d, u, d
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// These use compact names so tables are readable
