GameMeshObject.cxx:void GameMeshObject::destroyGPU(VkDevice device)
GameMeshObject.cxx:{
GameMeshObject.cxx:    if (vertexBuffer != VK_NULL_HANDLE)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        vkDestroyBuffer(device, vertexBuffer, nullptr);
GameMeshObject.cxx:        vertexBuffer = VK_NULL_HANDLE;
GameMeshObject.cxx:    }
GameMeshObject.cxx:
GameMeshObject.cxx:    if (vertexBufferMemory != VK_NULL_HANDLE)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        vkFreeMemory(device, vertexBufferMemory, nullptr);
GameMeshObject.cxx:        vertexBufferMemory = VK_NULL_HANDLE;
GameMeshObject.cxx:    }
GameMeshObject.cxx:
GameMeshObject.cxx:    if (indexBuffer != VK_NULL_HANDLE)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        vkDestroyBuffer(device, indexBuffer, nullptr);
GameMeshObject.cxx:        indexBuffer = VK_NULL_HANDLE;
GameMeshObject.cxx:    }
GameMeshObject.cxx:
GameMeshObject.cxx:    if (indexBufferMemory != VK_NULL_HANDLE)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        vkFreeMemory(device, indexBufferMemory, nullptr);
GameMeshObject.cxx:        indexBufferMemory = VK_NULL_HANDLE;
GameMeshObject.cxx:    }
GameMeshObject.cxx:}
