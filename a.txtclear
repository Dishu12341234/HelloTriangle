include/stb-master/stb_textedit.h:{
include/stb-master/stb_textedit.h:   // In single-line mode, just always make y = 0. This lets the drag keep working if the mouse
include/stb-master/stb_textedit.h:   // goes off the top or bottom of the text
include/stb-master/stb_textedit.h:   if( state->single_line )
include/stb-master/stb_textedit.h:   {
include/stb-master/stb_textedit.h:      StbTexteditRow r;
