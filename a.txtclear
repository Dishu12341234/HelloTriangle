include/stb-master/stb_textedit.h:   state->select_start = state->cursor;
include/stb-master/stb_textedit.h:   state->select_end = state->cursor;
include/stb-master/stb_textedit.h:   state->has_preferred_x = 0;
include/stb-master/stb_textedit.h:}
