include/stb-master/stb_dxt.h:   int stops[4];
include/stb-master/stb_dxt.h:   int i;
include/stb-master/stb_dxt.h:   int c0Point, halfPoint, c3Point;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   for(i=0;i<16;i++)
include/stb-master/stb_dxt.h:      dots[i] = block[i*4+0]*dirr + block[i*4+1]*dirg + block[i*4+2]*dirb;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   for(i=0;i<4;i++)
include/stb-master/stb_dxt.h:      stops[i] = color[i*4+0]*dirr + color[i*4+1]*dirg + color[i*4+2]*dirb;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   // think of the colors as arranged on a line; project point onto that line, then choose
include/stb-master/stb_dxt.h:   // next color out of available ones. we compute the crossover points for "best color in top
include/stb-master/stb_dxt.h:   // half"/"best in bottom half" and then the same inside that subinterval.
include/stb-master/stb_dxt.h:   //
include/stb-master/stb_dxt.h:   // relying on this 1d approximation isn't always optimal in terms of euclidean distance,
include/stb-master/stb_dxt.h:   // but it's very close and a lot faster.
