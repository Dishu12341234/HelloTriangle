include/stb-master/stb_textedit.h:         }
include/stb-master/stb_textedit.h:         r = &s->undo_rec[s->redo_point-1];
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:         r->char_storage = s->redo_char_point - u.delete_length;
include/stb-master/stb_textedit.h:         s->redo_char_point = s->redo_char_point - u.delete_length;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:         // now save the characters
include/stb-master/stb_textedit.h:         for (i=0; i < u.delete_length; ++i)
include/stb-master/stb_textedit.h:            s->undo_char[r->char_storage + i] = STB_TEXTEDIT_GETCHAR(str, u.where + i);
include/stb-master/stb_textedit.h:      }
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:      // now we can carry out the deletion
include/stb-master/stb_textedit.h:      STB_TEXTEDIT_DELETECHARS(str, u.where, u.delete_length);
include/stb-master/stb_textedit.h:   }
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // check type of recorded action:
include/stb-master/stb_textedit.h:   if (u.insert_length) {
include/stb-master/stb_textedit.h:      // easy case: was a deletion, so we need to insert n characters
