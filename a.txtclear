include/tinyobjloader/tiny_obj_loader.h:    // UTF-8 BOM = 0xEF,0xBB,0xBF
include/tinyobjloader/tiny_obj_loader.h:    if (input.size() >= 3 &&
include/tinyobjloader/tiny_obj_loader.h:        static_cast<unsigned char>(input[0]) == 0xEF &&
include/tinyobjloader/tiny_obj_loader.h:        static_cast<unsigned char>(input[1]) == 0xBB &&
include/tinyobjloader/tiny_obj_loader.h:        static_cast<unsigned char>(input[2]) == 0xBF) {
include/tinyobjloader/tiny_obj_loader.h:        return input.substr(3); // Skip BOM
