include/stb-master/stb_hexwave.h:            vert[j].t = 1.0f;
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   // compute the exact slopes from the final fixed-up positions
