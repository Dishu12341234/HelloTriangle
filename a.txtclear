include/stb-master/stb_herringbone_wang_tile.h:   int is_corner;
include/stb-master/stb_herringbone_wang_tile.h:   int num_color[6];  // number of colors for each of 6 edge types or 4 corner types
include/stb-master/stb_herringbone_wang_tile.h:   int short_side_len;
include/stb-master/stb_herringbone_wang_tile.h:   stbhw_tile **h_tiles;
