include/stb-master/stb_rect_pack.h:// Mostly for internal use, but this is the maximum supported coordinate value.
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:STBRP_DEF int stbrp_pack_rects (stbrp_context *context, stbrp_rect *rects, int num_rects);
include/stb-master/stb_rect_pack.h:// Assign packed locations to rectangles. The rectangles are of type
include/stb-master/stb_rect_pack.h:// 'stbrp_rect' defined below, stored in the array 'rects', and there
include/stb-master/stb_rect_pack.h:// are 'num_rects' many of them.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// Rectangles which are successfully packed have the 'was_packed' flag
include/stb-master/stb_rect_pack.h:// set to a non-zero value and 'x' and 'y' store the minimum location
include/stb-master/stb_rect_pack.h:// on each axis (i.e. bottom-left in cartesian coordinates, top-left
include/stb-master/stb_rect_pack.h:// if you imagine y increasing downwards). Rectangles which do not fit
include/stb-master/stb_rect_pack.h:// have the 'was_packed' flag set to 0.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// You should not try to access the 'rects' array from another thread
include/stb-master/stb_rect_pack.h:// while this function is running, as the function temporarily reorders
include/stb-master/stb_rect_pack.h:// the array while it executes.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// To pack into another rectangle, you need to call stbrp_init_target
include/stb-master/stb_rect_pack.h:// again. To continue packing into the same rectangle, you can call
include/stb-master/stb_rect_pack.h:// this function again. Calling this multiple times with multiple rect
include/stb-master/stb_rect_pack.h:// arrays will probably produce worse packing results than calling it
include/stb-master/stb_rect_pack.h:// a single time with the full rectangle array, but the option is
include/stb-master/stb_rect_pack.h:// available.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// The function returns 1 if all of the rectangles were successfully
include/stb-master/stb_rect_pack.h:// packed and 0 otherwise.
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:struct stbrp_rect
include/stb-master/stb_rect_pack.h:{
include/stb-master/stb_rect_pack.h:   // reserved for your use:
include/stb-master/stb_rect_pack.h:   int            id;
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:   // input:
include/stb-master/stb_rect_pack.h:   stbrp_coord    w, h;
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:   // output:
include/stb-master/stb_rect_pack.h:   stbrp_coord    x, y;
include/stb-master/stb_rect_pack.h:   int            was_packed;  // non-zero if valid packing
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:}; // 16 bytes, nominally
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:STBRP_DEF void stbrp_init_target (stbrp_context *context, int width, int height, stbrp_node *nodes, int num_nodes);
include/stb-master/stb_rect_pack.h:// Initialize a rectangle packer to:
include/stb-master/stb_rect_pack.h://    pack a rectangle that is 'width' by 'height' in dimensions
include/stb-master/stb_rect_pack.h://    using temporary storage provided by the array 'nodes', which is 'num_nodes' long
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// You must call this function every time you start packing into a new target.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// There is no "shutdown" function. The 'nodes' memory must stay valid for
include/stb-master/stb_rect_pack.h:// the following stbrp_pack_rects() call (or calls), but can be freed after
include/stb-master/stb_rect_pack.h:// the call (or calls) finish.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// Note: to guarantee best results, either:
include/stb-master/stb_rect_pack.h://       1. make sure 'num_nodes' >= 'width'
include/stb-master/stb_rect_pack.h://   or  2. call stbrp_allow_out_of_mem() defined below with 'allow_out_of_mem = 1'
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// If you don't do either of the above things, widths will be quantized to multiples
include/stb-master/stb_rect_pack.h:// of small integers to guarantee the algorithm doesn't run out of temporary storage.
include/stb-master/stb_rect_pack.h://
include/stb-master/stb_rect_pack.h:// If you do #2, then the non-quantized algorithm will be used, but the algorithm
include/stb-master/stb_rect_pack.h:// may run out of temporary storage and be unable to pack some rectangles.
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:STBRP_DEF void stbrp_setup_allow_out_of_mem (stbrp_context *context, int allow_out_of_mem);
include/stb-master/stb_rect_pack.h:// Optionally call this function after init but before doing any packing to
include/stb-master/stb_rect_pack.h:// change the handling of the out-of-temp-memory scenario, described above.
include/stb-master/stb_rect_pack.h:// If you call init again, this will be reset to the default (false).
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:STBRP_DEF void stbrp_setup_heuristic (stbrp_context *context, int heuristic);
include/stb-master/stb_rect_pack.h:// Optionally select which packing heuristic the library should use. Different
include/stb-master/stb_rect_pack.h:// heuristics will produce better/worse results for different data sets.
include/stb-master/stb_rect_pack.h:// If you call init again, this will be reset to the default.
