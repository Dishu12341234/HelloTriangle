include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// when inputting AND outputting non-premultiplied alpha pixels, we use a slower but higher quality technique
include/stb-master/stb_image_resize2.h://   that fills the zero alpha pixel's RGB values with something plausible.  If you don't care about areas of
include/stb-master/stb_image_resize2.h://   zero alpha, you can call this function to get about a 25% speed improvement for STBIR_RGBA to STBIR_RGBA
include/stb-master/stb_image_resize2.h://   types of resizes.
include/stb-master/stb_image_resize2.h:STBIRDEF int stbir_set_non_pm_alpha_speed_over_quality( STBIR_RESIZE * resize, int non_pma_alpha_speed_over_quality );
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:// You can call build_samplers to prebuild all the internal data we need to resample.
include/stb-master/stb_image_resize2.h://   Then, if you call resize_extended many times with the same resize, you only pay the
include/stb-master/stb_image_resize2.h://   cost once.
include/stb-master/stb_image_resize2.h:// If you do call build_samplers, you MUST call free_samplers eventually.
include/stb-master/stb_image_resize2.h://--------------------------------
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// This builds the samplers and does one allocation
include/stb-master/stb_image_resize2.h:STBIRDEF int stbir_build_samplers( STBIR_RESIZE * resize );
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// You MUST call this, if you call stbir_build_samplers or stbir_build_samplers_with_splits
include/stb-master/stb_image_resize2.h:STBIRDEF void stbir_free_samplers( STBIR_RESIZE * resize );
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// And this is the main function to perform the resize synchronously on one thread.
include/stb-master/stb_image_resize2.h:STBIRDEF int stbir_resize_extended( STBIR_RESIZE * resize );
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:// Use these functions for multithreading.
include/stb-master/stb_image_resize2.h://   1) You call stbir_build_samplers_with_splits first on the main thread
include/stb-master/stb_image_resize2.h://   2) Then stbir_resize_with_split on each thread
include/stb-master/stb_image_resize2.h://   3) stbir_free_samplers when done on the main thread
include/stb-master/stb_image_resize2.h://--------------------------------
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// This will build samplers for threading.
include/stb-master/stb_image_resize2.h://   You can pass in the number of threads you'd like to use (try_splits).
include/stb-master/stb_image_resize2.h://   It returns the number of splits (threads) that you can call it with.
include/stb-master/stb_image_resize2.h:///  It might be less if the image resize can't be split up that many ways.
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:STBIRDEF int stbir_build_samplers_with_splits( STBIR_RESIZE * resize, int try_splits );
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// This function does a split of the resizing (you call this fuction for each
include/stb-master/stb_image_resize2.h:// split, on multiple threads). A split is a piece of the output resize pixel space.
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// Note that you MUST call stbir_build_samplers_with_splits before stbir_resize_extended_split!
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:// Usually, you will always call stbir_resize_split with split_start as the thread_index
include/stb-master/stb_image_resize2.h://   and "1" for the split_count.
include/stb-master/stb_image_resize2.h:// But, if you have a weird situation where you MIGHT want 8 threads, but sometimes
include/stb-master/stb_image_resize2.h://   only 4 threads, you can use 0,2,4,6 for the split_start's and use "2" for the
include/stb-master/stb_image_resize2.h://   split_count each time to turn in into a 4 thread resize. (This is unusual).
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:STBIRDEF int stbir_resize_extended_split( STBIR_RESIZE * resize, int split_start, int split_count );
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h://===============================================================
include/stb-master/stb_image_resize2.h:// Pixel Callbacks info:
include/stb-master/stb_image_resize2.h://--------------------------------
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h://   The input callback is super flexible - it calls you with the input address
include/stb-master/stb_image_resize2.h://   (based on the stride and base pointer), it gives you an optional_output
include/stb-master/stb_image_resize2.h://   pointer that you can fill, or you can just return your own pointer into
include/stb-master/stb_image_resize2.h://   your own data.
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://   You can also do conversion from non-supported data types if necessary - in
include/stb-master/stb_image_resize2.h://   this case, you ignore the input_ptr and just use the x and y parameters to
include/stb-master/stb_image_resize2.h://   calculate your own input_ptr based on the size of each non-supported pixel.
include/stb-master/stb_image_resize2.h://   (Something like the third example below.)
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://   You can also install just an input or just an output callback by setting the
include/stb-master/stb_image_resize2.h://   callback that you don't want to zero.
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://     First example, progress: (getting a callback that you can monitor the progress):
include/stb-master/stb_image_resize2.h://        void const * my_callback( void * optional_output, void const * input_ptr, int num_pixels, int x, int y, void * context )
include/stb-master/stb_image_resize2.h://        {
include/stb-master/stb_image_resize2.h://           percentage_done = y / input_height;
include/stb-master/stb_image_resize2.h://           return input_ptr;  // use buffer from call
include/stb-master/stb_image_resize2.h://        }
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://     Next example, copying: (copy from some other buffer or stream):
include/stb-master/stb_image_resize2.h://        void const * my_callback( void * optional_output, void const * input_ptr, int num_pixels, int x, int y, void * context )
include/stb-master/stb_image_resize2.h://        {
include/stb-master/stb_image_resize2.h://           CopyOrStreamData( optional_output, other_data_src, num_pixels * pixel_width_in_bytes );
include/stb-master/stb_image_resize2.h://           return optional_output;  // return the optional buffer that we filled
include/stb-master/stb_image_resize2.h://        }
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://     Third example, input another buffer without copying: (zero-copy from other buffer):
include/stb-master/stb_image_resize2.h://        void const * my_callback( void * optional_output, void const * input_ptr, int num_pixels, int x, int y, void * context )
include/stb-master/stb_image_resize2.h://        {
include/stb-master/stb_image_resize2.h://           void * pixels = ( (char*) other_image_base ) + ( y * other_image_stride ) + ( x * other_pixel_width_in_bytes );
include/stb-master/stb_image_resize2.h://           return pixels;       // return pointer to your data without copying
include/stb-master/stb_image_resize2.h://        }
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://   The output callback is considerably simpler - it just calls you so that you can dump
include/stb-master/stb_image_resize2.h://   out each scanline. You could even directly copy out to disk if you have a simple format
include/stb-master/stb_image_resize2.h://   like TGA or BMP. You can also convert to other output types here if you want.
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://   Simple example:
include/stb-master/stb_image_resize2.h://        void const * my_output( void * output_ptr, int num_pixels, int y, void * context )
include/stb-master/stb_image_resize2.h://        {
include/stb-master/stb_image_resize2.h://           percentage_done = y / output_height;
include/stb-master/stb_image_resize2.h://           fwrite( output_ptr, pixel_width_in_bytes, num_pixels, output_file );
include/stb-master/stb_image_resize2.h://        }
include/stb-master/stb_image_resize2.h://===============================================================
