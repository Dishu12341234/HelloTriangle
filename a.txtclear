GameObjectPool.cxx:void GameObjectPool::appendGameObject(GameObject *gameObject)
GameObjectPool.cxx:{
GameObjectPool.cxx:    this->gameObjects.insert({gameObject->getID(), gameObject});
GameObjectPool.cxx:}
GameObjectPool.cxx:
GameObjectPool.cxx:void GameObjectPool::initUpload()
GameObjectPool.cxx:{
GameObjectPool.cxx:    uploadIndex = 0;
GameObjectPool.cxx:    uploadInProgress = true;
GameObjectPool.cxx:
GameObjectPool.cxx:    uploadCmd = meshUploader.beginBatch(
GameObjectPool.cxx:        vkContext.device,
GameObjectPool.cxx:        vkContext.commandPool);
GameObjectPool.cxx:}
GameObjectPool.cxx:
GameObjectPool.cxx:void GameObjectPool::uploadChunk()
GameObjectPool.cxx:{
GameObjectPool.cxx:    if (!uploadInProgress)
GameObjectPool.cxx:        return;
GameObjectPool.cxx:
GameObjectPool.cxx:    const size_t MAX_UPLOADS_PER_FRAME = 8192; // tune this
GameObjectPool.cxx:
GameObjectPool.cxx:    size_t total = gameObjects.size();
GameObjectPool.cxx:    size_t uploads = 0;
GameObjectPool.cxx:
GameObjectPool.cxx:    while (uploadIndex < total && uploads < MAX_UPLOADS_PER_FRAME)
GameObjectPool.cxx:    {
GameObjectPool.cxx:        meshUploader.recordUpload(
GameObjectPool.cxx:            vkContext,
GameObjectPool.cxx:            *(gameObjects[uploadIndex]->mesh),
GameObjectPool.cxx:            uploadCmd,
GameObjectPool.cxx:            uploadGarbage);
GameObjectPool.cxx:
GameObjectPool.cxx:        uploadIndex++;
GameObjectPool.cxx:        uploads++;
GameObjectPool.cxx:    }
GameObjectPool.cxx:
GameObjectPool.cxx:    std::cout << "Uploaded " << 100.f * float(uploadIndex) / float(total) << "%" << std::endl;
GameObjectPool.cxx:
GameObjectPool.cxx:    // If finished uploading everything
GameObjectPool.cxx:    if (uploadIndex >= total)
GameObjectPool.cxx:    {
GameObjectPool.cxx:        meshUploader.endBatch(
GameObjectPool.cxx:            vkContext,
GameObjectPool.cxx:            uploadCmd,
GameObjectPool.cxx:            uploadGarbage);
GameObjectPool.cxx:
GameObjectPool.cxx:        uploadInProgress = false;
GameObjectPool.cxx:        ready = true;
GameObjectPool.cxx:    }
GameObjectPool.cxx:}
GameObjectPool.cxx:
GameObjectPool.cxx:void GameObjectPool::drawIndexed(VkCommandBuffer &commandBuffer, std::vector<VkDescriptorSet> &descriptorSets, u_GraphicsPipeline &graphicsPipeline, VkExtent2D &swapChainExtent, uint64_t instanceCount, uint32_t &currentFrame)
GameObjectPool.cxx:{
GameObjectPool.cxx:    for (auto &&[goid, gameObject] : gameObjects)
GameObjectPool.cxx:    {
GameObjectPool.cxx:        gameObject->drawIndexed(commandBuffer, descriptorSets, graphicsPipeline, swapChainExtent, instanceCount, currentFrame);
GameObjectPool.cxx:    }
GameObjectPool.cxx:
GameObjectPool.cxx:    // auto mesh = gameObjects[1]->mesh;
