include/stb-master/stb_textedit.h:static StbUndoRecord *stb_text_create_undo_record(StbUndoState *state, int numchars)
include/stb-master/stb_textedit.h:{
include/stb-master/stb_textedit.h:   // any time we create a new undo record, we discard redo
include/stb-master/stb_textedit.h:   stb_textedit_flush_redo(state);
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // if we have no free records, we have to make room, by sliding the
include/stb-master/stb_textedit.h:   // existing records down
include/stb-master/stb_textedit.h:   if (state->undo_point == STB_TEXTEDIT_UNDOSTATECOUNT)
include/stb-master/stb_textedit.h:      stb_textedit_discard_undo(state);
