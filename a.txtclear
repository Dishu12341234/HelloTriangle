include/stb-master/stb_truetype.h:   // The prefilter is a box filter of width "oversample",
include/stb-master/stb_truetype.h:   // which shifts phase by (oversample - 1)/2 pixels in
include/stb-master/stb_truetype.h:   // oversampled space. We want to shift in the opposite
include/stb-master/stb_truetype.h:   // direction to counter this.
include/stb-master/stb_truetype.h:   return (float)-(oversample - 1) / (2.0f * (float)oversample);
include/stb-master/stb_truetype.h:}
