include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   STBTT_assert(!(o > b->size || o < 0));
include/stb-master/stb_truetype.h:   b->cursor = (o > b->size || o < 0) ? b->size : o;
include/stb-master/stb_truetype.h:}
