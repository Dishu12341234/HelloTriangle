include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// CONFIGURATION MACROS
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://  #define STBVOX_CONFIG_MODE <integer>           // REQUIRED
include/stb-master/stb_voxel_render.h://     Configures the overall behavior of stb_voxel_render. This
include/stb-master/stb_voxel_render.h://     can affect the shaders, the uniform info, and other things.
include/stb-master/stb_voxel_render.h://     (If you need more than one mode in the same app, you can
include/stb-master/stb_voxel_render.h://     use STB_VOXEL_RENDER_STATIC to create multiple versions
include/stb-master/stb_voxel_render.h://     in separate files, and then wrap them.)
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://         Mode value       Meaning
include/stb-master/stb_voxel_render.h://             0               Textured blocks, 32-byte quads
include/stb-master/stb_voxel_render.h://             1               Textured blocks, 20-byte quads
include/stb-master/stb_voxel_render.h://            20               Untextured blocks, 32-byte quads
include/stb-master/stb_voxel_render.h://            21               Untextured blocks, 20-byte quads
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://  #define STBVOX_CONFIG_PRECISION_Z  <integer>   // OPTIONAL
include/stb-master/stb_voxel_render.h://     Defines the number of bits of fractional position for Z.
include/stb-master/stb_voxel_render.h://     Only 0 or 1 are valid. 1 is the default. If 0, then a
include/stb-master/stb_voxel_render.h://     single mesh has twice the legal Z range; e.g. in
include/stb-master/stb_voxel_render.h://     modes 0,1,20,21, Z in the mesh can extend to 511 instead
include/stb-master/stb_voxel_render.h://     of 255. However, half-height blocks cannot be used.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// All of the following are just #ifdef tested so need no values, and are optional.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_BLOCKTYPE_SHORT
include/stb-master/stb_voxel_render.h://        use unsigned 16-bit values for 'blocktype' in the input instead of 8-bit values
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_OPENGL_MODELVIEW
include/stb-master/stb_voxel_render.h://        use the gl_ModelView matrix rather than the explicit uniform
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_HLSL
include/stb-master/stb_voxel_render.h://        NOT IMPLEMENTED! Define HLSL shaders instead of GLSL shaders
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_PREFER_TEXBUFFER
include/stb-master/stb_voxel_render.h://        Stores many of the uniform arrays in texture buffers instead,
include/stb-master/stb_voxel_render.h://        so they can be larger and may be more efficient on some hardware.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_LIGHTING_SIMPLE
include/stb-master/stb_voxel_render.h://        Creates a simple lighting engine with a single point light source
include/stb-master/stb_voxel_render.h://        in addition to the default half-lambert ambient light.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_LIGHTING
include/stb-master/stb_voxel_render.h://        Declares a lighting function hook; you must append a lighting function
include/stb-master/stb_voxel_render.h://        to the shader before compiling it:
include/stb-master/stb_voxel_render.h://            vec3 compute_lighting(vec3 pos, vec3 norm, vec3 albedo, vec3 ambient);
include/stb-master/stb_voxel_render.h://        'ambient' is the half-lambert ambient light with vertex ambient-occlusion applied
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_FOG_SMOOTHSTEP
include/stb-master/stb_voxel_render.h://        Defines a simple unrealistic fog system designed to maximize
include/stb-master/stb_voxel_render.h://        unobscured view distance while not looking too weird when things
include/stb-master/stb_voxel_render.h://        emerge from the fog. Configured using an extra array element
include/stb-master/stb_voxel_render.h://        in the STBVOX_UNIFORM_ambient uniform.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_FOG
include/stb-master/stb_voxel_render.h://        Defines a fog function hook; you must append a fog function to
include/stb-master/stb_voxel_render.h://        the shader before compiling it:
include/stb-master/stb_voxel_render.h://            vec3 compute_fog(vec3 color, vec3 relative_pos, float fragment_alpha);
include/stb-master/stb_voxel_render.h://        "color" is the incoming pre-fogged color, fragment_alpha is the alpha value,
include/stb-master/stb_voxel_render.h://        and relative_pos is the vector from the point to the camera in worldspace
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_DISABLE_TEX2
include/stb-master/stb_voxel_render.h://        This disables all processing of texture 2 in the shader in case
include/stb-master/stb_voxel_render.h://        you don't use it. Eventually this could be replaced with a mode
include/stb-master/stb_voxel_render.h://        that omits the unused data entirely.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_TEX1_EDGE_CLAMP
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_TEX2_EDGE_CLAMP
include/stb-master/stb_voxel_render.h://        If you want to edge clamp the textures, instead of letting them wrap,
include/stb-master/stb_voxel_render.h://        set this flag. By default stb_voxel_render relies on texture wrapping
include/stb-master/stb_voxel_render.h://        to simplify texture coordinate generation. This flag forces it to do
include/stb-master/stb_voxel_render.h://        it correctly, although there can still be minor artifacts.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_ROTATION_IN_LIGHTING
include/stb-master/stb_voxel_render.h://        Changes the meaning of the 'lighting' mesher input variable to also
include/stb-master/stb_voxel_render.h://        store the rotation; see later discussion.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_VHEIGHT_IN_LIGHTING
include/stb-master/stb_voxel_render.h://        Changes the meaning of the 'lighting' mesher input variable to also
include/stb-master/stb_voxel_render.h://        store the vheight; see later discussion. Cannot use both this and
include/stb-master/stb_voxel_render.h://        the previous variable.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_PREMULTIPLIED_ALPHA
include/stb-master/stb_voxel_render.h://        Adjusts the shader calculations on the assumption that tex1.rgba,
include/stb-master/stb_voxel_render.h://        tex2.rgba, and color.rgba all use premultiplied values, and that
include/stb-master/stb_voxel_render.h://        the output of the fragment shader should be premultiplied.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    STBVOX_CONFIG_UNPREMULTIPLY
include/stb-master/stb_voxel_render.h://        Only meaningful if STBVOX_CONFIG_PREMULTIPLIED_ALPHA is defined.
include/stb-master/stb_voxel_render.h://        Changes the behavior described above so that the inputs are
include/stb-master/stb_voxel_render.h://        still premultiplied alpha, but the output of the fragment
include/stb-master/stb_voxel_render.h://        shader is not premultiplied alpha. This is needed when allowing
include/stb-master/stb_voxel_render.h://        non-unit alpha values but not doing alpha-blending (for example
include/stb-master/stb_voxel_render.h://        when alpha testing).
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// MESHING
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// A mesh represents a (typically) small chunk of a larger world.
include/stb-master/stb_voxel_render.h:// Meshes encode coordinates using small integers, so those
include/stb-master/stb_voxel_render.h:// coordinates must be relative to some base location.
include/stb-master/stb_voxel_render.h:// All of the coordinates in the functions below use
include/stb-master/stb_voxel_render.h:// these relative coordinates unless explicitly stated
include/stb-master/stb_voxel_render.h:// otherwise.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Input to the meshing step is documented further down
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_init_mesh_maker(stbvox_mesh_maker *mm);
include/stb-master/stb_voxel_render.h:// Call this function to initialize a mesh-maker context structure
include/stb-master/stb_voxel_render.h:// used to build meshes. You should have one context per thread
include/stb-master/stb_voxel_render.h:// that's building meshes.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_set_buffer(stbvox_mesh_maker *mm, int mesh, int slot, void *buffer, size_t len);
include/stb-master/stb_voxel_render.h:// Call this to set the buffer into which stbvox will write the mesh
include/stb-master/stb_voxel_render.h:// it creates. It can build more than one mesh in parallel (distinguished
include/stb-master/stb_voxel_render.h:// by the 'mesh' parameter), and each mesh can be made up of more than
include/stb-master/stb_voxel_render.h:// one buffer (distinguished by the 'slot' parameter).
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Multiple meshes are under your control; use the 'selector' input
include/stb-master/stb_voxel_render.h:// variable to choose which mesh each voxel's vertices are written to.
include/stb-master/stb_voxel_render.h:// For example, you can use this to generate separate meshes for opaque
include/stb-master/stb_voxel_render.h:// and transparent data.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// You can query the number of slots by calling stbvox_get_buffer_count
include/stb-master/stb_voxel_render.h:// described below. The meaning of the buffer for each slot depends
include/stb-master/stb_voxel_render.h:// on STBVOX_CONFIG_MODE.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://   In mode 0 & mode 20, there is only one slot. The mesh data for that
include/stb-master/stb_voxel_render.h://   slot is two interleaved vertex attributes: attr_vertex, a single
include/stb-master/stb_voxel_render.h://   32-bit uint, and attr_face, a single 32-bit uint.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://   In mode 1 & mode 21, there are two slots. The first buffer should
include/stb-master/stb_voxel_render.h://   be four times as large as the second buffer. The first buffer
include/stb-master/stb_voxel_render.h://   contains a single vertex attribute: 'attr_vertex', a single 32-bit uint.
include/stb-master/stb_voxel_render.h://   The second buffer contains texture buffer data (an array of 32-bit uints)
include/stb-master/stb_voxel_render.h://   that will be accessed through the sampler identified by STBVOX_UNIFORM_face_data.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC int stbvox_get_buffer_count(stbvox_mesh_maker *mm);
include/stb-master/stb_voxel_render.h:// Returns the number of buffers needed per mesh as described above.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC int stbvox_get_buffer_size_per_quad(stbvox_mesh_maker *mm, int slot);
include/stb-master/stb_voxel_render.h:// Returns how much of a given buffer will get used per quad. This
include/stb-master/stb_voxel_render.h:// allows you to choose correct relative sizes for each buffer, although
include/stb-master/stb_voxel_render.h:// the values are fixed based on the configuration you've selected at
include/stb-master/stb_voxel_render.h:// compile time, and the details are described in stbvox_set_buffer.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_set_default_mesh(stbvox_mesh_maker *mm, int mesh);
include/stb-master/stb_voxel_render.h:// Selects which mesh the mesher will output to (see previous function)
include/stb-master/stb_voxel_render.h:// if the input doesn't specify a per-voxel selector. (I doubt this is
include/stb-master/stb_voxel_render.h:// useful, but it's here just in case.)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC stbvox_input_description *stbvox_get_input_description(stbvox_mesh_maker *mm);
include/stb-master/stb_voxel_render.h:// This function call returns a pointer to the stbvox_input_description part
include/stb-master/stb_voxel_render.h:// of stbvox_mesh_maker (which you should otherwise treat as opaque). You
include/stb-master/stb_voxel_render.h:// zero this structure, then fill out the relevant pointers to the data
include/stb-master/stb_voxel_render.h:// describing your voxel object/world.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// See further documentation at the description of stbvox_input_description below.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_set_input_stride(stbvox_mesh_maker *mm, int x_stride_in_elements, int y_stride_in_elements);
include/stb-master/stb_voxel_render.h:// This sets the stride between successive elements of the 3D arrays
include/stb-master/stb_voxel_render.h:// in the stbvox_input_description. Z values are always stored consecutively.
include/stb-master/stb_voxel_render.h:// (The preferred coordinate system for stbvox is X right, Y forwards, Z up.)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_set_input_range(stbvox_mesh_maker *mm, int x0, int y0, int z0, int x1, int y1, int z1);
include/stb-master/stb_voxel_render.h:// This sets the range of values in the 3D array for the voxels that
include/stb-master/stb_voxel_render.h:// the mesh generator will convert. The lower values are inclusive,
include/stb-master/stb_voxel_render.h:// the higher values are exclusive, so (0,0,0) to (16,16,16) generates
include/stb-master/stb_voxel_render.h:// mesh data associated with voxels up to (15,15,15) but no higher.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// The mesh generate generates faces at the boundary between open space
include/stb-master/stb_voxel_render.h:// and solid space but associates them with the solid space, so if (15,0,0)
include/stb-master/stb_voxel_render.h:// is open and (16,0,0) is solid, then the mesh will contain the boundary
include/stb-master/stb_voxel_render.h:// between them if x0 <= 16 and x1 > 16.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Note that the mesh generator will access array elements 1 beyond the
include/stb-master/stb_voxel_render.h:// limits set in these parameters. For example, if you set the limits
include/stb-master/stb_voxel_render.h:// to be (0,0,0) and (16,16,16), then the generator will access all of
include/stb-master/stb_voxel_render.h:// the voxels between (-1,-1,-1) and (16,16,16), including (16,16,16).
include/stb-master/stb_voxel_render.h:// You may have to do pointer arithmetic to make it work.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// For example, caveview processes mesh chunks that are 32x32x16, but it
include/stb-master/stb_voxel_render.h:// does this using input buffers that are 34x34x18.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// The lower limits are x0 >= 0, y0 >= 0, and z0 >= 0.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// The upper limits are mode dependent, but all the current methods are
include/stb-master/stb_voxel_render.h:// limited to x1 < 127, y1 < 127, z1 < 255. Note that these are not
include/stb-master/stb_voxel_render.h:// powers of two; if you want to use power-of-two chunks (to make
include/stb-master/stb_voxel_render.h:// it efficient to decide which chunk a coordinate falls in), you're
include/stb-master/stb_voxel_render.h:// limited to at most x1=64, y1=64, z1=128. For classic Minecraft-style
include/stb-master/stb_voxel_render.h:// worlds with limited vertical extent, I recommend using a single
include/stb-master/stb_voxel_render.h:// chunk for the entire height, which limits the height to 255 blocks
include/stb-master/stb_voxel_render.h:// (one less than Minecraft), and only chunk the map in X & Y.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC int stbvox_make_mesh(stbvox_mesh_maker *mm);
include/stb-master/stb_voxel_render.h:// Call this function to create mesh data for the currently configured
include/stb-master/stb_voxel_render.h:// set of input data. This appends to the currently configured mesh output
include/stb-master/stb_voxel_render.h:// buffer. Returns 1 on success. If there is not enough room in the buffer,
include/stb-master/stb_voxel_render.h:// it outputs as much as it can, and returns 0; you need to switch output
include/stb-master/stb_voxel_render.h:// buffers (either by calling stbvox_set_buffer to set new buffers, or
include/stb-master/stb_voxel_render.h:// by copying the data out and calling stbvox_reset_buffers), and then
include/stb-master/stb_voxel_render.h:// call this function again without changing any of the input parameters.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Note that this function appends; you can call it multiple times to
include/stb-master/stb_voxel_render.h:// build a single mesh. For example, caveview uses chunks that are
include/stb-master/stb_voxel_render.h:// 32x32x255, but builds the mesh for it by processing 32x32x16 at atime
include/stb-master/stb_voxel_render.h:// (this is faster as it is reuses the same 34x34x18 input buffers rather
include/stb-master/stb_voxel_render.h:// than needing 34x34x257 input buffers).
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:// Once you're done creating a mesh into a given buffer,
include/stb-master/stb_voxel_render.h:// consider the following functions:
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC int stbvox_get_quad_count(stbvox_mesh_maker *mm, int mesh);
include/stb-master/stb_voxel_render.h:// Returns the number of quads in the mesh currently generated by mm.
include/stb-master/stb_voxel_render.h:// This is the sum of all consecutive stbvox_make_mesh runs appending
include/stb-master/stb_voxel_render.h:// to the same buffer. 'mesh' distinguishes between the multiple user
include/stb-master/stb_voxel_render.h:// meshes available via 'selector' or stbvox_set_default_mesh.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Typically you use this function when you're done building the mesh
include/stb-master/stb_voxel_render.h:// and want to record how to draw it.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Note that there are no index buffers; the data stored in the buffers
include/stb-master/stb_voxel_render.h:// should be drawn as quads (e.g. with GL_QUAD); if your API does not
include/stb-master/stb_voxel_render.h:// support quads, you can create a single index buffer large enough to
include/stb-master/stb_voxel_render.h:// draw your largest vertex buffer, and reuse it for every rendering.
include/stb-master/stb_voxel_render.h:// (Note that if you use 32-bit indices, you'll use 24 bytes of bandwidth
include/stb-master/stb_voxel_render.h:// per quad, more than the 20 bytes for the vertex/face mesh data.)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_set_mesh_coordinates(stbvox_mesh_maker *mm, int x, int y, int z);
include/stb-master/stb_voxel_render.h:// Sets the global coordinates for this chunk, such that (0,0,0) relative
include/stb-master/stb_voxel_render.h:// coordinates will be at (x,y,z) in global coordinates.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_get_bounds(stbvox_mesh_maker *mm, float bounds[2][3]);
include/stb-master/stb_voxel_render.h:// Returns the bounds for the mesh in global coordinates. Use this
include/stb-master/stb_voxel_render.h:// for e.g. frustum culling the mesh. @BUG: this just uses the
include/stb-master/stb_voxel_render.h:// values from stbvox_set_input_range(), so if you build by
include/stb-master/stb_voxel_render.h:// appending multiple values, this will be wrong, and you need to
include/stb-master/stb_voxel_render.h:// set stbvox_set_input_range() to the full size. Someday this
include/stb-master/stb_voxel_render.h:// will switch to tracking the actual bounds of the *mesh*, though.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_get_transform(stbvox_mesh_maker *mm, float transform[3][3]);
include/stb-master/stb_voxel_render.h:// Returns the 'transform' data for the shader uniforms. It is your
include/stb-master/stb_voxel_render.h:// job to set this to the shader before drawing the mesh. It is the
include/stb-master/stb_voxel_render.h:// only uniform that needs to change per-mesh. Note that it is not
include/stb-master/stb_voxel_render.h:// a 3x3 matrix, but rather a scale to decode fixed point numbers as
include/stb-master/stb_voxel_render.h:// floats, a translate from relative to global space, and a special
include/stb-master/stb_voxel_render.h:// translation for texture coordinate generation that avoids
include/stb-master/stb_voxel_render.h:// floating-point precision issues. @TODO: currently we add the
include/stb-master/stb_voxel_render.h:// global translation to the vertex, than multiply by modelview,
include/stb-master/stb_voxel_render.h:// but this means if camera location and vertex are far from the
include/stb-master/stb_voxel_render.h:// origin, we lose precision. Need to make a special modelview with
include/stb-master/stb_voxel_render.h:// the translation (or some of it) factored out to avoid this.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC void stbvox_reset_buffers(stbvox_mesh_maker *mm);
include/stb-master/stb_voxel_render.h:// Call this function if you're done with the current output buffer
include/stb-master/stb_voxel_render.h:// but want to reuse it (e.g. you're done appending with
include/stb-master/stb_voxel_render.h:// stbvox_make_mesh and you've copied the data out to your graphics API
include/stb-master/stb_voxel_render.h:// so can reuse the buffer).
