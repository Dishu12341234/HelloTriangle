include/stb-master/stb_textedit.h:// API drag: on mouse drag, move the cursor and selection endpoint to the clicked location
include/stb-master/stb_textedit.h:static void stb_textedit_drag(STB_TEXTEDIT_STRING *str, STB_TexteditState *state, float x, float y)
include/stb-master/stb_textedit.h:{
