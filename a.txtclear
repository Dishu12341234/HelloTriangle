include/tinyobjloader/tiny_obj_loader.h:// https://rosettacode.org/wiki/Tokenize_a_string_with_escaping#C.2B.2B
include/tinyobjloader/tiny_obj_loader.h:static void SplitString(const std::string &s, char delim, char escape,
include/tinyobjloader/tiny_obj_loader.h:                        std::vector<std::string> &elems) {
include/tinyobjloader/tiny_obj_loader.h:  std::string token;
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  bool escaping = false;
include/tinyobjloader/tiny_obj_loader.h:  for (size_t i = 0; i < s.size(); ++i) {
include/tinyobjloader/tiny_obj_loader.h:    char ch = s[i];
include/tinyobjloader/tiny_obj_loader.h:    if (escaping) {
include/tinyobjloader/tiny_obj_loader.h:      escaping = false;
include/tinyobjloader/tiny_obj_loader.h:    } else if (ch == escape) {
include/tinyobjloader/tiny_obj_loader.h:      escaping = true;
include/tinyobjloader/tiny_obj_loader.h:      continue;
include/tinyobjloader/tiny_obj_loader.h:    } else if (ch == delim) {
include/tinyobjloader/tiny_obj_loader.h:      if (!token.empty()) {
include/tinyobjloader/tiny_obj_loader.h:        elems.push_back(token);
include/tinyobjloader/tiny_obj_loader.h:      }
include/tinyobjloader/tiny_obj_loader.h:      token.clear();
include/tinyobjloader/tiny_obj_loader.h:      continue;
include/tinyobjloader/tiny_obj_loader.h:    }
include/tinyobjloader/tiny_obj_loader.h:    token += ch;
include/tinyobjloader/tiny_obj_loader.h:  }
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  elems.push_back(token);
include/tinyobjloader/tiny_obj_loader.h:}
