GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:void GameObject::loadGeometry(std::string modelPath)
GameObject.cxx:{
GameObject.cxx:    if (!mesh)
GameObject.cxx:        this->mesh = new GameMeshObject(modelPath);
GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:void GameObject::loadGeometry(std::vector<Vertex> vertices, std::vector<uint32_t> indices)
GameObject.cxx:{
GameObject.cxx:    if (!mesh)
GameObject.cxx:        this->mesh = new GameMeshObject();
GameObject.cxx:    this->mesh->vertices = vertices;
GameObject.cxx:    this->mesh->indices = indices;
GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:void GameObject::initUpload()
GameObject.cxx:{
GameObject.cxx:    if (!mesh)
GameObject.cxx:        return;
GameObject.cxx:
GameObject.cxx:    VkCommandBuffer uploadCmd =
GameObject.cxx:        meshUploader.beginBatch(
GameObject.cxx:            vkContext.device,
GameObject.cxx:            vkContext.commandPool);
GameObject.cxx:
GameObject.cxx:    meshUploader.recordUpload(vkContext, *this->mesh, uploadCmd, uploadGarbage);
GameObject.cxx:
GameObject.cxx:    meshUploader.endBatch(vkContext, uploadCmd, uploadGarbage);
GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:void GameObject::drawIndexed(VkCommandBuffer &commandBuffer, std::vector<VkDescriptorSet> &descriptorSets, u_GraphicsPipeline &graphicsPipeline, VkExtent2D &swapChainExtent, uint64_t &instanceCount, uint32_t &currentFrame)
GameObject.cxx:{
GameObject.cxx:    if (!mesh)
GameObject.cxx:        return;
GameObject.cxx:
GameObject.cxx:    if (mesh->vertexBuffer == VK_NULL_HANDLE ||
GameObject.cxx:        mesh->indexBuffer == VK_NULL_HANDLE)
GameObject.cxx:    {
GameObject.cxx:        return; // skip this object
GameObject.cxx:    }
GameObject.cxx:    if (mesh->indices.size() == 0)
GameObject.cxx:        return;
GameObject.cxx:    // std::cout << GOID << std::endl;
GameObject.cxx:    VkBuffer vertexBuffers[] = {mesh->vertexBuffer};
GameObject.cxx:    VkDeviceSize offsets[] = {0};
GameObject.cxx:
GameObject.cxx:    vkCmdBindVertexBuffers(commandBuffer, 0, 1, vertexBuffers, offsets);
GameObject.cxx:    vkCmdBindIndexBuffer(commandBuffer, mesh->indexBuffer, 0, VK_INDEX_TYPE_UINT32);
GameObject.cxx:
GameObject.cxx:    vkCmdBindDescriptorSets(commandBuffer, VK_PIPELINE_BIND_POINT_GRAPHICS, graphicsPipeline.pipelineLayout, 0, 1, &(descriptorSets[currentFrame]), 0, nullptr);
GameObject.cxx:
GameObject.cxx:    PushConstantC1 c1;
GameObject.cxx:    c1.model = glm::translate(glm::mat4(1.f), glm::vec3(transform.position));
GameObject.cxx:    c1.tileIndex[0] = faceUVTextureOffsets[0];
GameObject.cxx:    c1.tileIndex[1] = faceUVTextureOffsets[1];
GameObject.cxx:    c1.tileIndex[2] = faceUVTextureOffsets[2];
GameObject.cxx:    c1.tileIndex[3] = faceUVTextureOffsets[3];
GameObject.cxx:    c1.tileIndex[4] = faceUVTextureOffsets[4];
GameObject.cxx:    c1.tileIndex[5] = faceUVTextureOffsets[5];
GameObject.cxx:
GameObject.cxx:    vkCmdPushConstants(commandBuffer, graphicsPipeline.pipelineLayout, VK_SHADER_STAGE_VERTEX_BIT, 0, sizeof(PushConstantC1), &c1);
GameObject.cxx:
GameObject.cxx:    vkCmdDrawIndexed(commandBuffer, static_cast<uint32_t>(mesh->indices.size()), 1, 0, 0, 0);
GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:uint32_t GameObject::getID()
GameObject.cxx:{
GameObject.cxx:    return GOID;
GameObject.cxx:}
GameObject.cxx:
GameObject.cxx:void GameObject::cleanUpResources()
GameObject.cxx:{
GameObject.cxx:    this->mesh->cleanUpResources();
GameObject.cxx:    delete mesh;
GameObject.cxx:    mesh = nullptr;
GameObject.cxx:}
