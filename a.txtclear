GameMeshObject.cxx:
GameMeshObject.cxx:void GameMeshObject::loadMeshModel(std::string modelPath)
GameMeshObject.cxx:{
GameMeshObject.cxx:    vertices.clear();
GameMeshObject.cxx:    indices.clear();
GameMeshObject.cxx:
GameMeshObject.cxx:
GameMeshObject.cxx:    tinyobj::attrib_t attrib;
GameMeshObject.cxx:    std::vector<tinyobj::shape_t> shapes;
GameMeshObject.cxx:    std::vector<tinyobj::material_t> materials;
GameMeshObject.cxx:    std::string err, warn;
GameMeshObject.cxx:
GameMeshObject.cxx:    if (!tinyobj::LoadObj(&attrib, &shapes, &materials, &warn, &err, modelPath.c_str()))
GameMeshObject.cxx:    {
GameMeshObject.cxx:        throw std::runtime_error(err);
GameMeshObject.cxx:    }
GameMeshObject.cxx:    if (warn.empty() == false)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        std::cout << "WARN: " << warn << std::endl;
GameMeshObject.cxx:    }
GameMeshObject.cxx:
GameMeshObject.cxx:    std::unordered_map<Vertex, uint32_t> uniqueVertices{};
GameMeshObject.cxx:
GameMeshObject.cxx:    for (const auto &shape : shapes)
GameMeshObject.cxx:    {
GameMeshObject.cxx:        for (const auto &index : shape.mesh.indices)
GameMeshObject.cxx:        {
GameMeshObject.cxx:            Vertex vertex{};
GameMeshObject.cxx:
GameMeshObject.cxx:            vertex.pos = {
GameMeshObject.cxx:                attrib.vertices[3 * index.vertex_index + 0],
GameMeshObject.cxx:                attrib.vertices[3 * index.vertex_index + 1],
GameMeshObject.cxx:                attrib.vertices[3 * index.vertex_index + 2]};
GameMeshObject.cxx:
GameMeshObject.cxx:            vertex.texCoord = {
GameMeshObject.cxx:                attrib.texcoords[2 * index.texcoord_index + 0],
GameMeshObject.cxx:                1.0f - attrib.texcoords[2 * index.texcoord_index + 1]};
GameMeshObject.cxx:
GameMeshObject.cxx:            vertex.color = {1.0f, 1.0f, 1.0f};
GameMeshObject.cxx:
GameMeshObject.cxx:            if (uniqueVertices.count(vertex) == 0)
GameMeshObject.cxx:            {
GameMeshObject.cxx:                uniqueVertices[vertex] = static_cast<uint32_t>(vertices.size());
GameMeshObject.cxx:                vertices.push_back(vertex);
GameMeshObject.cxx:            }
GameMeshObject.cxx:
GameMeshObject.cxx:            indices.push_back(uniqueVertices[vertex]);
GameMeshObject.cxx:        }
GameMeshObject.cxx:    }
GameMeshObject.cxx:}
GameMeshObject.cxx:
