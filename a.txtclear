include/stb-master/stb_truetype.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// FONT LOADING
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int stbtt_GetNumberOfFonts(const unsigned char *data);
include/stb-master/stb_truetype.h:// This function will determine the number of fonts in a font file.  TrueType
include/stb-master/stb_truetype.h:// collection (.ttc) files may contain multiple fonts, while TrueType font
include/stb-master/stb_truetype.h:// (.ttf) files only contain one font. The number of fonts can be used for
include/stb-master/stb_truetype.h:// indexing with the previous function where the index is between zero and one
include/stb-master/stb_truetype.h:// less than the total fonts. If an error occurs, -1 is returned.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int stbtt_GetFontOffsetForIndex(const unsigned char *data, int index);
include/stb-master/stb_truetype.h:// Each .ttf/.ttc file may have more than one font. Each font has a sequential
include/stb-master/stb_truetype.h:// index number starting from 0. Call this function to get the font offset for
include/stb-master/stb_truetype.h:// a given index; it returns -1 if the index is out of range. A regular .ttf
include/stb-master/stb_truetype.h:// file will only define one font and it always be at offset 0, so it will
include/stb-master/stb_truetype.h:// return '0' for index 0, and -1 for all other indices.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:// The following structure is defined publicly so you can declare one on
include/stb-master/stb_truetype.h:// the stack or as a global or etc, but you should treat it as opaque.
include/stb-master/stb_truetype.h:struct stbtt_fontinfo
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   void           * userdata;
