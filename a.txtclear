include/stb-master/stb_voxel_render.h:struct stbvox_uniform_info
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   int type;                    // which type of uniform
include/stb-master/stb_voxel_render.h:   int bytes_per_element;       // the size of each uniform array element (e.g. vec3 = 12 bytes)
include/stb-master/stb_voxel_render.h:   int array_length;            // length of the uniform array
include/stb-master/stb_voxel_render.h:   char *name;                  // name in the shader @TODO use numeric binding
include/stb-master/stb_voxel_render.h:   float *default_value;        // if not NULL, you can use this as the uniform pointer
include/stb-master/stb_voxel_render.h:   int use_tex_buffer;          // if true, then the uniform is a sampler but the data can come from default_value
include/stb-master/stb_voxel_render.h:};
