include/stb-master/stb_image.h:{
include/stb-master/stb_image.h:   stbi__uint16 px = (stbi__uint16)stbi__get16le(s);
include/stb-master/stb_image.h:   stbi__uint16 fiveBitMask = 31;
include/stb-master/stb_image.h:   // we have 3 channels with 5bits each
include/stb-master/stb_image.h:   int r = (px >> 10) & fiveBitMask;
include/stb-master/stb_image.h:   int g = (px >> 5) & fiveBitMask;
include/stb-master/stb_image.h:   int b = px & fiveBitMask;
include/stb-master/stb_image.h:   // Note that this saves the data in RGB(A) order, so it doesn't need to be swapped later
include/stb-master/stb_image.h:   out[0] = (stbi_uc)((r * 255)/31);
include/stb-master/stb_image.h:   out[1] = (stbi_uc)((g * 255)/31);
include/stb-master/stb_image.h:   out[2] = (stbi_uc)((b * 255)/31);
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:   // some people claim that the most significant bit might be used for alpha
include/stb-master/stb_image.h:   // (possibly if an alpha-bit is set in the "image descriptor byte")
include/stb-master/stb_image.h:   // but that only made 16bit test images completely translucent..
include/stb-master/stb_image.h:   // so let's treat all 15 and 16bit TGAs as RGB with no alpha.
include/stb-master/stb_image.h:}
