include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_set(void *address_of_pointer, void *value_to_write);
include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_didset(void *address_of_pointer);
include/stb-master/deprecated/stb.h:
include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_didfree(void *address_being_freed, int len);
include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_free(void *address_being_freed, int len);
include/stb-master/deprecated/stb.h:
include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_didrealloc(void *new_address, void *old_address, int len);
include/stb-master/deprecated/stb.h:STB_EXTERN void stb_nptr_recache(void); // recache all known pointers
include/stb-master/deprecated/stb.h:                                       // do this after pointer sets outside your control, slow
include/stb-master/deprecated/stb.h:
include/stb-master/deprecated/stb.h:#ifdef STB_DEFINE
include/stb-master/deprecated/stb.h:// for fast updating on free/realloc, we need to be able to find
include/stb-master/deprecated/stb.h:// all the objects (pointers and targets) within a given block;
include/stb-master/deprecated/stb.h:// this precludes hashing
include/stb-master/deprecated/stb.h:
include/stb-master/deprecated/stb.h:// we use a three-level hierarchy of memory to minimize storage:
include/stb-master/deprecated/stb.h://   level 1: 65536 pointers to stb__memory_node (always uses 256 KB)
include/stb-master/deprecated/stb.h://   level 2: each stb__memory_node represents a 64K block of memory
include/stb-master/deprecated/stb.h://            with 256 stb__memory_leafs (worst case 64MB)
include/stb-master/deprecated/stb.h://   level 3: each stb__memory_leaf represents 256 bytes of memory
include/stb-master/deprecated/stb.h://            using a list of target locations and a list of pointers
include/stb-master/deprecated/stb.h://            (which are hopefully fairly short normally!)
include/stb-master/deprecated/stb.h:
include/stb-master/deprecated/stb.h:// this approach won't work in 64-bit, which has a much larger address
include/stb-master/deprecated/stb.h:// space. need to redesign
