include/stb-master/tests/prerelease/stb_lib.h://                                stb_arr
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://  An stb_arr is directly useable as a pointer (use the actual type in your
include/stb-master/tests/prerelease/stb_lib.h://  definition), but when it resizes, it returns a new pointer and you can't
include/stb-master/tests/prerelease/stb_lib.h://  use the old one, so you have to be careful to copy-in-out as necessary.
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://  Use a NULL pointer as a 0-length array.
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     float *my_array = NULL, *temp;
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     // add elements on the end one at a time
include/stb-master/tests/prerelease/stb_lib.h://     stb_arr_push(my_array, 0.0f);
include/stb-master/tests/prerelease/stb_lib.h://     stb_arr_push(my_array, 1.0f);
include/stb-master/tests/prerelease/stb_lib.h://     stb_arr_push(my_array, 2.0f);
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     assert(my_array[1] == 2.0f);
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     // add an uninitialized element at the end, then assign it
include/stb-master/tests/prerelease/stb_lib.h://     *stb_arr_add(my_array) = 3.0f;
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     // add three uninitialized elements at the end
include/stb-master/tests/prerelease/stb_lib.h://     temp = stb_arr_addn(my_array,3);
include/stb-master/tests/prerelease/stb_lib.h://     temp[0] = 4.0f;
include/stb-master/tests/prerelease/stb_lib.h://     temp[1] = 5.0f;
include/stb-master/tests/prerelease/stb_lib.h://     temp[2] = 6.0f;
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     assert(my_array[5] == 5.0f);
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     // remove the last one
include/stb-master/tests/prerelease/stb_lib.h://     stb_arr_pop(my_array);
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://     assert(stb_arr_len(my_array) == 6);
