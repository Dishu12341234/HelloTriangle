include/stb-master/stb_easy_font.h:static int stb_easy_font_draw_segs(float x, float y, unsigned char *segs, int num_segs, int vertical, stb_easy_font_color c, char *vbuf, int vbuf_size, int offset)
include/stb-master/stb_easy_font.h:{
include/stb-master/stb_easy_font.h:    int i,j;
include/stb-master/stb_easy_font.h:    for (i=0; i < num_segs; ++i) {
include/stb-master/stb_easy_font.h:        int len = segs[i] & 7;
include/stb-master/stb_easy_font.h:        x += (float) ((segs[i] >> 3) & 1);
include/stb-master/stb_easy_font.h:        if (len && offset+64 <= vbuf_size) {
include/stb-master/stb_easy_font.h:            float y0 = y + (float) (segs[i]>>4);
include/stb-master/stb_easy_font.h:            for (j=0; j < 4; ++j) {
include/stb-master/stb_easy_font.h:                * (float *) (vbuf+offset+0) = x  + (j==1 || j==2 ? (vertical ? 1 : len) : 0);
include/stb-master/stb_easy_font.h:                * (float *) (vbuf+offset+4) = y0 + (    j >= 2   ? (vertical ? len : 1) : 0);
include/stb-master/stb_easy_font.h:                * (float *) (vbuf+offset+8) = 0.f;
include/stb-master/stb_easy_font.h:                * (stb_easy_font_color *) (vbuf+offset+12) = c;
include/stb-master/stb_easy_font.h:                offset += 16;
include/stb-master/stb_easy_font.h:            }
include/stb-master/stb_easy_font.h:        }
include/stb-master/stb_easy_font.h:    }
include/stb-master/stb_easy_font.h:    return offset;
