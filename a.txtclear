include/stb-master/stb_leakcheck.h:void *stb_leakcheck_realloc(void *ptr, size_t sz, const char *file, int line)
include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:   if (ptr == NULL) {
include/stb-master/stb_leakcheck.h:      return stb_leakcheck_malloc(sz, file, line);
include/stb-master/stb_leakcheck.h:   } else if (sz == 0) {
include/stb-master/stb_leakcheck.h:      stb_leakcheck_free(ptr);
include/stb-master/stb_leakcheck.h:      return NULL;
include/stb-master/stb_leakcheck.h:   } else {
include/stb-master/stb_leakcheck.h:      stb_leakcheck_malloc_info *mi = (stb_leakcheck_malloc_info *) ptr - 1;
include/stb-master/stb_leakcheck.h:      if (sz <= mi->size)
include/stb-master/stb_leakcheck.h:         return ptr;
include/stb-master/stb_leakcheck.h:      else {
include/stb-master/stb_leakcheck.h:         #ifdef STB_LEAKCHECK_REALLOC_PRESERVE_MALLOC_FILELINE
include/stb-master/stb_leakcheck.h:         void *q = stb_leakcheck_malloc(sz, mi->file, mi->line);
include/stb-master/stb_leakcheck.h:         #else
include/stb-master/stb_leakcheck.h:         void *q = stb_leakcheck_malloc(sz, file, line);
include/stb-master/stb_leakcheck.h:         #endif
include/stb-master/stb_leakcheck.h:         if (q) {
include/stb-master/stb_leakcheck.h:            memcpy(q, ptr, mi->size);
include/stb-master/stb_leakcheck.h:            stb_leakcheck_free(ptr);
include/stb-master/stb_leakcheck.h:         }
include/stb-master/stb_leakcheck.h:         return q;
include/stb-master/stb_leakcheck.h:      }
include/stb-master/stb_leakcheck.h:   }
include/stb-master/stb_leakcheck.h:}
include/stb-master/stb_leakcheck.h:
include/stb-master/stb_leakcheck.h:static void stblkck_internal_print(const char *reason, stb_leakcheck_malloc_info *mi)
include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:#if defined(_MSC_VER) && _MSC_VER < 1900 // 1900=VS 2015
include/stb-master/stb_leakcheck.h:   // Compilers that use the old MS C runtime library don't have %zd
include/stb-master/stb_leakcheck.h:   // and the older ones don't even have %lld either... however, the old compilers
include/stb-master/stb_leakcheck.h:   // without "long long" don't support 64-bit targets either, so here's the
include/stb-master/stb_leakcheck.h:   // compromise:
include/stb-master/stb_leakcheck.h:   #if _MSC_VER < 1400 // before VS 2005
include/stb-master/stb_leakcheck.h:      fprintf(STB_LEAKCHECK_OUTPUT_PIPE, "%s: %s (%4d): %8d bytes at %p\n", reason, mi->file, mi->line, (int)mi->size, (void*)(mi+1));
include/stb-master/stb_leakcheck.h:   #else
include/stb-master/stb_leakcheck.h:      fprintf(STB_LEAKCHECK_OUTPUT_PIPE, "%s: %s (%4d): %16lld bytes at %p\n", reason, mi->file, mi->line, (long long)mi->size, (void*)(mi+1));
include/stb-master/stb_leakcheck.h:   #endif
include/stb-master/stb_leakcheck.h:#else
include/stb-master/stb_leakcheck.h:   // Assume we have %zd on other targets.
include/stb-master/stb_leakcheck.h:   #ifdef __MINGW32__
include/stb-master/stb_leakcheck.h:      __mingw_fprintf(STB_LEAKCHECK_OUTPUT_PIPE, "%s: %s (%4d): %zd bytes at %p\n", reason, mi->file, mi->line, mi->size, (void*)(mi+1));
include/stb-master/stb_leakcheck.h:   #else
include/stb-master/stb_leakcheck.h:      fprintf(STB_LEAKCHECK_OUTPUT_PIPE, "%s: %s (%4d): %zd bytes at %p\n", reason, mi->file, mi->line, mi->size, (void*)(mi+1));
include/stb-master/stb_leakcheck.h:   #endif
include/stb-master/stb_leakcheck.h:#endif
include/stb-master/stb_leakcheck.h:}
include/stb-master/stb_leakcheck.h:
include/stb-master/stb_leakcheck.h:void stb_leakcheck_dumpmem(void)
include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:   stb_leakcheck_malloc_info *mi = mi_head;
include/stb-master/stb_leakcheck.h:   while (mi) {
include/stb-master/stb_leakcheck.h:      if ((ptrdiff_t) mi->size >= 0)
include/stb-master/stb_leakcheck.h:         stblkck_internal_print("LEAKED", mi);
include/stb-master/stb_leakcheck.h:      mi = mi->next;
include/stb-master/stb_leakcheck.h:   }
include/stb-master/stb_leakcheck.h:   #ifdef STB_LEAKCHECK_SHOWALL
include/stb-master/stb_leakcheck.h:   mi = mi_head;
include/stb-master/stb_leakcheck.h:   while (mi) {
include/stb-master/stb_leakcheck.h:      if ((ptrdiff_t) mi->size < 0)
include/stb-master/stb_leakcheck.h:         stblkck_internal_print("FREED ", mi);
include/stb-master/stb_leakcheck.h:      mi = mi->next;
include/stb-master/stb_leakcheck.h:   }
include/stb-master/stb_leakcheck.h:   #endif
include/stb-master/stb_leakcheck.h:}
include/stb-master/stb_leakcheck.h:#endif // STB_LEAKCHECK_IMPLEMENTATION
