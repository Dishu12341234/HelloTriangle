include/stb-master/stb_textedit.h:      s->undo_char_point -= u.insert_length;
include/stb-master/stb_textedit.h:   }
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   state->cursor = u.where + u.insert_length;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   s->undo_point--;
include/stb-master/stb_textedit.h:   s->redo_point--;
