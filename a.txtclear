include/stb-master/stb_tilemap_editor.h:{
include/stb-master/stb_tilemap_editor.h:   int pos = tm->undo_pos;
include/stb-master/stb_tilemap_editor.h:   tm->undo_buffer[pos] = value;
include/stb-master/stb_tilemap_editor.h:   tm->undo_pos = stbte__wrap(pos+1);
include/stb-master/stb_tilemap_editor.h:   tm->undo_len += (tm->undo_len < STBTE__UNDO_BUFFER_COUNT-2);
include/stb-master/stb_tilemap_editor.h:   tm->redo_len -= (tm->redo_len > 0);
include/stb-master/stb_tilemap_editor.h:   tm->undo_available_valid = 0;
