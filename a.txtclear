StandarBoxModel.cxx:void StandardBoxModel::removeFace(Face face)
StandarBoxModel.cxx:{
StandarBoxModel.cxx:    std::cout << "&mesh " << mesh << std::endl;
StandarBoxModel.cxx:    if(!mesh)
StandarBoxModel.cxx:        return;
StandarBoxModel.cxx:    size_t faceCount = mesh->indices.size() / 6;
StandarBoxModel.cxx:    if (face >= faceCount)
StandarBoxModel.cxx:        return;
StandarBoxModel.cxx:
StandarBoxModel.cxx:    size_t indexStart  = face * 6;
StandarBoxModel.cxx:    size_t vertexStart = mesh->indices[indexStart];
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Remove indices
StandarBoxModel.cxx:    mesh->indices.erase(
StandarBoxModel.cxx:        mesh->indices.begin() + indexStart,
StandarBoxModel.cxx:        mesh->indices.begin() + indexStart + 6
StandarBoxModel.cxx:    );
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Remove vertices
StandarBoxModel.cxx:    mesh->vertices.erase(
StandarBoxModel.cxx:        mesh->vertices.begin() + vertexStart,
StandarBoxModel.cxx:        mesh->vertices.begin() + vertexStart + 4
StandarBoxModel.cxx:    );
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Fix shifted indices
StandarBoxModel.cxx:    for (auto& idx : mesh->indices)
StandarBoxModel.cxx:    {
StandarBoxModel.cxx:        if (idx > vertexStart)
StandarBoxModel.cxx:            idx -= 4;
StandarBoxModel.cxx:    }
StandarBoxModel.cxx:
StandarBoxModel.cxx:}
StandarBoxModel.cxx:
StandarBoxModel.cxx:void StandardBoxModel::removeFace(GameObject *go, Face face)
StandarBoxModel.cxx:{
StandarBoxModel.cxx:    if(!go)
StandarBoxModel.cxx:        return;
StandarBoxModel.cxx:    
StandarBoxModel.cxx:    if(go->objectType != ObjectType::StandardBoxModel)
StandarBoxModel.cxx:        return;
StandarBoxModel.cxx:
StandarBoxModel.cxx:    size_t faceCount = go->mesh->indices.size() / 6;
StandarBoxModel.cxx:    if (face >= faceCount)
StandarBoxModel.cxx:        return;
StandarBoxModel.cxx:
StandarBoxModel.cxx:    size_t indexStart  = face * 6;
StandarBoxModel.cxx:    size_t vertexStart = go->mesh->indices[indexStart];
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Remove indices
StandarBoxModel.cxx:    go->mesh->indices.erase(
StandarBoxModel.cxx:        go->mesh->indices.begin() + indexStart,
StandarBoxModel.cxx:        go->mesh->indices.begin() + indexStart + 6
StandarBoxModel.cxx:    );
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Remove vertices
StandarBoxModel.cxx:    go->mesh->vertices.erase(
StandarBoxModel.cxx:        go->mesh->vertices.begin() + vertexStart,
StandarBoxModel.cxx:        go->mesh->vertices.begin() + vertexStart + 4
StandarBoxModel.cxx:    );
StandarBoxModel.cxx:
StandarBoxModel.cxx:    // Fix shifted indices
StandarBoxModel.cxx:    for (auto& idx : go->mesh->indices)
StandarBoxModel.cxx:    {
StandarBoxModel.cxx:        if (idx > vertexStart)
StandarBoxModel.cxx:            idx -= 4;
StandarBoxModel.cxx:    }
StandarBoxModel.cxx:
StandarBoxModel.cxx:    go->loadGeometry(go->mesh->vertices, go->mesh->indices);
StandarBoxModel.cxx:}
StandarBoxModel.cxx:
StandarBoxModel.cxx:void StandardBoxModel::cleanUpResources()
StandarBoxModel.cxx:{
StandarBoxModel.cxx:    GameObject::cleanUpResources();
StandarBoxModel.cxx:}
StandarBoxModel.cxx:
StandarBoxModel.cxx:glm::vec2 StandardBoxModel::tileIndexToUV(uint32_t tileIndex)
StandarBoxModel.cxx:{
StandarBoxModel.cxx:    float tileSize = TILE_SIZE / ATLAS_SIZE;
StandarBoxModel.cxx:
StandarBoxModel.cxx:    uint32_t tileX = tileIndex % TILES_PER_ROW;
StandarBoxModel.cxx:    uint32_t tileY = tileIndex / TILES_PER_ROW;
StandarBoxModel.cxx:
StandarBoxModel.cxx:    return glm::vec2(
StandarBoxModel.cxx:        tileX * tileSize,
StandarBoxModel.cxx:        tileY * tileSize);
StandarBoxModel.cxx:}
StandarBoxModel.cxx:StandardBoxModel::~StandardBoxModel()
StandarBoxModel.cxx:{
StandarBoxModel.cxx:}
