include/stb-master/stb_ds.h:#define STBDS_ROTATE_LEFT(val, n)   (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))
include/stb-master/stb_ds.h:#define STBDS_ROTATE_RIGHT(val, n)  (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:size_t stbds_hash_string(char *str, size_t seed)
include/stb-master/stb_ds.h:{
include/stb-master/stb_ds.h:  size_t hash = seed;
include/stb-master/stb_ds.h:  while (*str)
include/stb-master/stb_ds.h:     hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++;
include/stb-master/stb_ds.h:
include/stb-master/stb_ds.h:  // Thomas Wang 64-to-32 bit mix function, hopefully also works in 32 bits
include/stb-master/stb_ds.h:  hash ^= seed;
