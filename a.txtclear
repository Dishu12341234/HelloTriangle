include/stb-master/stb_image_resize2.h:static int stbir__should_do_vertical_first( float weights_table[STBIR_RESIZE_CLASSIFICATIONS][4], int horizontal_filter_pixel_width, float horizontal_scale, int horizontal_output_size, int vertical_filter_pixel_width, float vertical_scale, int vertical_output_size, int is_gather, STBIR__V_FIRST_INFO * info )
include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  double v_cost, h_cost;
include/stb-master/stb_image_resize2.h:  float * weights;
include/stb-master/stb_image_resize2.h:  int vertical_first;
include/stb-master/stb_image_resize2.h:  int v_classification;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // categorize the resize into buckets
include/stb-master/stb_image_resize2.h:  if ( ( vertical_output_size <= 4 ) || ( horizontal_output_size <= 4 ) )
include/stb-master/stb_image_resize2.h:    v_classification = ( vertical_output_size < horizontal_output_size ) ? 6 : 7;
include/stb-master/stb_image_resize2.h:  else if ( vertical_scale <= 1.0f )
include/stb-master/stb_image_resize2.h:    v_classification = ( is_gather ) ? 1 : 0;
include/stb-master/stb_image_resize2.h:  else if ( vertical_scale <= 2.0f)
include/stb-master/stb_image_resize2.h:    v_classification = 2;
include/stb-master/stb_image_resize2.h:  else if ( vertical_scale <= 3.0f)
include/stb-master/stb_image_resize2.h:    v_classification = 3;
include/stb-master/stb_image_resize2.h:  else if ( vertical_scale <= 4.0f)
include/stb-master/stb_image_resize2.h:    v_classification = 5;
include/stb-master/stb_image_resize2.h:  else
include/stb-master/stb_image_resize2.h:    v_classification = 6;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // use the right weights
include/stb-master/stb_image_resize2.h:  weights = weights_table[ v_classification ];
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // this is the costs when you don't take into account modern CPUs with high ipc and simd and caches - wish we had a better estimate
include/stb-master/stb_image_resize2.h:  h_cost = (float)horizontal_filter_pixel_width * weights[0] + horizontal_scale * (float)vertical_filter_pixel_width * weights[1];
include/stb-master/stb_image_resize2.h:  v_cost = (float)vertical_filter_pixel_width  * weights[2] + vertical_scale * (float)horizontal_filter_pixel_width * weights[3];
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // use computation estimate to decide vertical first or not
include/stb-master/stb_image_resize2.h:  vertical_first = ( v_cost <= h_cost ) ? 1 : 0;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // save these, if requested
include/stb-master/stb_image_resize2.h:  if ( info )
include/stb-master/stb_image_resize2.h:  {
include/stb-master/stb_image_resize2.h:    info->h_cost = h_cost;
include/stb-master/stb_image_resize2.h:    info->v_cost = v_cost;
include/stb-master/stb_image_resize2.h:    info->v_resize_classification = v_classification;
include/stb-master/stb_image_resize2.h:    info->v_first = vertical_first;
include/stb-master/stb_image_resize2.h:    info->is_gather = is_gather;
include/stb-master/stb_image_resize2.h:  }
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // and this allows us to override everything for testing (see dotiming.c)
include/stb-master/stb_image_resize2.h:  if ( ( info ) && ( info->control_v_first ) )
include/stb-master/stb_image_resize2.h:    vertical_first = ( info->control_v_first == 2 ) ? 1 : 0;
include/stb-master/stb_image_resize2.h:
