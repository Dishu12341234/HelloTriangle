include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  static const stbir__FP32 almostone = { 0x3f7fffff }; // 1-eps
include/stb-master/stb_image_resize2.h:  static const stbir__FP32 minval = { (127-13) << 23 };
include/stb-master/stb_image_resize2.h:  stbir_uint32 tab,bias,scale,t;
include/stb-master/stb_image_resize2.h:  stbir__FP32 f;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // Clamp to [2^(-13), 1-eps]; these two values map to 0 and 1, respectively.
include/stb-master/stb_image_resize2.h:  // The tests are carefully written so that NaNs map to 0, same as in the reference
include/stb-master/stb_image_resize2.h:  // implementation.
include/stb-master/stb_image_resize2.h:  if (!(in > minval.f)) // written this way to catch NaNs
include/stb-master/stb_image_resize2.h:      return 0;
include/stb-master/stb_image_resize2.h:  if (in > almostone.f)
include/stb-master/stb_image_resize2.h:      return 255;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // Do the table lookup and unpack bias, scale
include/stb-master/stb_image_resize2.h:  f.f = in;
include/stb-master/stb_image_resize2.h:  tab = fp32_to_srgb8_tab4[(f.u - minval.u) >> 20];
include/stb-master/stb_image_resize2.h:  bias = (tab >> 16) << 9;
include/stb-master/stb_image_resize2.h:  scale = tab & 0xffff;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  // Grab next-highest mantissa bits and perform linear interpolation
include/stb-master/stb_image_resize2.h:  t = (f.u >> 12) & 0xff;
include/stb-master/stb_image_resize2.h:  return (unsigned char) ((bias + scale*t) >> 16);
include/stb-master/stb_image_resize2.h:}
