include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  void * user_data;
include/stb-master/stb_image_resize2.h:  void const * input_pixels;
include/stb-master/stb_image_resize2.h:  int input_w, input_h;
