include/stb-master/tests/prerelease/stb_lib.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://                               Hashing
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://      typical use for this is to make a power-of-two hash table.
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://      let N = size of table (2^n)
include/stb-master/tests/prerelease/stb_lib.h://      let H = stb_hash(str)
include/stb-master/tests/prerelease/stb_lib.h://      let S = stb_rehash(H) | 1
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://      then hash probe sequence P(i) for i=0..N-1
include/stb-master/tests/prerelease/stb_lib.h://         P(i) = (H + S*i) & (N-1)
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://      the idea is that H has 32 bits of hash information, but the
include/stb-master/tests/prerelease/stb_lib.h://      table has only, say, 2^20 entries so only uses 20 of the bits.
include/stb-master/tests/prerelease/stb_lib.h://      then by rehashing the original H we get 2^12 different probe
include/stb-master/tests/prerelease/stb_lib.h://      sequences for a given initial probe location. (So it's optimal
include/stb-master/tests/prerelease/stb_lib.h://      for 64K tables and its optimality decreases past that.)
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://      ok, so I've added something that generates _two separate_
include/stb-master/tests/prerelease/stb_lib.h://      32-bit hashes simultaneously which should scale better to
include/stb-master/tests/prerelease/stb_lib.h://      very large tables.
