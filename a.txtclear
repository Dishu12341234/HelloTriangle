include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// RENDERING
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC char *stbvox_get_vertex_shader(void);
include/stb-master/stb_voxel_render.h:// Returns the (currently GLSL-only) vertex shader.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC char *stbvox_get_fragment_shader(void);
include/stb-master/stb_voxel_render.h:// Returns the (currently GLSL-only) fragment shader.
include/stb-master/stb_voxel_render.h:// You can override the lighting and fogging calculations
include/stb-master/stb_voxel_render.h:// by appending data to the end of these; see the #define
include/stb-master/stb_voxel_render.h:// documentation for more information.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC char *stbvox_get_fragment_shader_alpha_only(void);
include/stb-master/stb_voxel_render.h:// Returns a slightly cheaper fragment shader that computes
include/stb-master/stb_voxel_render.h:// alpha but not color. This is useful for e.g. a depth-only
include/stb-master/stb_voxel_render.h:// pass when using alpha test.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:typedef struct stbvox_uniform_info stbvox_uniform_info;
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:STBVXDEC int stbvox_get_uniform_info(stbvox_uniform_info *info, int uniform);
include/stb-master/stb_voxel_render.h:// Gets the information about a uniform necessary for you to
include/stb-master/stb_voxel_render.h:// set up each uniform with a minimal amount of explicit code.
include/stb-master/stb_voxel_render.h:// See the sample code after the structure definition for stbvox_uniform_info,
include/stb-master/stb_voxel_render.h:// further down in this header section.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// "uniform" is from the list immediately following. For many
include/stb-master/stb_voxel_render.h:// of these, default values are provided which you can set.
include/stb-master/stb_voxel_render.h:// Most values are shared for most draw calls; e.g. for stateful
include/stb-master/stb_voxel_render.h:// APIs you can set most of the state only once. Only
include/stb-master/stb_voxel_render.h:// STBVOX_UNIFORM_transform needs to change per draw call.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// STBVOX_UNIFORM_texscale
include/stb-master/stb_voxel_render.h://    64- or 128-long vec4 array. (128 only if STBVOX_CONFIG_PREFER_TEXBUFFER)
include/stb-master/stb_voxel_render.h://    x: scale factor to apply to texture #1. must be a power of two. 1.0 means 'face-sized'
include/stb-master/stb_voxel_render.h://    y: scale factor to apply to texture #2. must be a power of two. 1.0 means 'face-sized'
include/stb-master/stb_voxel_render.h://    z: blend mode indexed by texture #2. 0.0 is alpha compositing; 1.0 is multiplication.
include/stb-master/stb_voxel_render.h://    w: unused currently. @TODO use to support texture animation?
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://    Texscale is indexed by the bottom 6 or 7 bits of the texture id; thus for
include/stb-master/stb_voxel_render.h://    example the texture at index 0 in the array and the texture in index 128 of
include/stb-master/stb_voxel_render.h://    the array must be scaled the same. This means that if you only have 64 or 128
include/stb-master/stb_voxel_render.h://    unique textures, they all get distinct values anyway; otherwise you have
include/stb-master/stb_voxel_render.h://    to group them in pairs or sets of four.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// STBVOX_UNIFORM_ambient
include/stb-master/stb_voxel_render.h://    4-long vec4 array:
include/stb-master/stb_voxel_render.h://      ambient[0].xyz   - negative of direction of a directional light for half-lambert
include/stb-master/stb_voxel_render.h://      ambient[1].rgb   - color of light scaled by NdotL (can be negative)
include/stb-master/stb_voxel_render.h://      ambient[2].rgb   - constant light added to above calculation;
include/stb-master/stb_voxel_render.h://                         effectively light ranges from ambient[2]-ambient[1] to ambient[2]+ambient[1]
include/stb-master/stb_voxel_render.h://      ambient[3].rgb   - fog color for STBVOX_CONFIG_FOG_SMOOTHSTEP
include/stb-master/stb_voxel_render.h://      ambient[3].a     - reciprocal of squared distance of farthest fog point (viewing distance)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:                               //  +----- has a default value
include/stb-master/stb_voxel_render.h:                               //  |  +-- you should always use the default value
include/stb-master/stb_voxel_render.h:enum                           //  V  V
include/stb-master/stb_voxel_render.h:{                              //  ------------------------------------------------
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_face_data,   //  n      the sampler with the face texture buffer
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_transform,   //  n      the transform data from stbvox_get_transform
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_tex_array,   //  n      an array of two texture samplers containing the two texture arrays
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_texscale,    //  Y      a table of texture properties, see above
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_color_table, //  Y      64 vec4 RGBA values; a default palette is provided; if A > 1.0, fullbright
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_normals,     //  Y  Y   table of normals, internal-only
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_texgen,      //  Y  Y   table of texgen vectors, internal-only
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_ambient,     //  n      lighting & fog info, see above
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_camera_pos,  //  Y      camera position in global voxel space (for lighting & fog)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_count,
include/stb-master/stb_voxel_render.h:};
