include/stb-master/stb_textedit.h:// traverse the layout to locate the nearest character to a display position
include/stb-master/stb_textedit.h:static int stb_text_locate_coord(STB_TEXTEDIT_STRING *str, float x, float y)
include/stb-master/stb_textedit.h:{
include/stb-master/stb_textedit.h:   StbTexteditRow r;
include/stb-master/stb_textedit.h:   int n = STB_TEXTEDIT_STRINGLEN(str);
include/stb-master/stb_textedit.h:   float base_y = 0, prev_x;
include/stb-master/stb_textedit.h:   int i=0, k;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   r.x0 = r.x1 = 0;
include/stb-master/stb_textedit.h:   r.ymin = r.ymax = 0;
include/stb-master/stb_textedit.h:   r.num_chars = 0;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // search rows to find one that straddles 'y'
include/stb-master/stb_textedit.h:   while (i < n) {
include/stb-master/stb_textedit.h:      STB_TEXTEDIT_LAYOUTROW(&r, str, i);
include/stb-master/stb_textedit.h:      if (r.num_chars <= 0)
include/stb-master/stb_textedit.h:         return n;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:      if (i==0 && y < base_y + r.ymin)
include/stb-master/stb_textedit.h:         return 0;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:      if (y < base_y + r.ymax)
include/stb-master/stb_textedit.h:         break;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:      i += r.num_chars;
include/stb-master/stb_textedit.h:      base_y += r.baseline_y_delta;
include/stb-master/stb_textedit.h:   }
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // below all text, return 'after' last character
include/stb-master/stb_textedit.h:   if (i >= n)
include/stb-master/stb_textedit.h:      return n;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // check if it's before the beginning of the line
include/stb-master/stb_textedit.h:   if (x < r.x0)
include/stb-master/stb_textedit.h:      return i;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // check if it's before the end of the line
include/stb-master/stb_textedit.h:   if (x < r.x1) {
include/stb-master/stb_textedit.h:      // search characters in row for one that straddles 'x'
include/stb-master/stb_textedit.h:      prev_x = r.x0;
include/stb-master/stb_textedit.h:      for (k=0; k < r.num_chars; ++k) {
include/stb-master/stb_textedit.h:         float w = STB_TEXTEDIT_GETWIDTH(str, i, k);
include/stb-master/stb_textedit.h:         if (x < prev_x+w) {
include/stb-master/stb_textedit.h:            if (x < prev_x+w/2)
include/stb-master/stb_textedit.h:               return k+i;
include/stb-master/stb_textedit.h:            else
include/stb-master/stb_textedit.h:               return k+i+1;
include/stb-master/stb_textedit.h:         }
include/stb-master/stb_textedit.h:         prev_x += w;
include/stb-master/stb_textedit.h:      }
include/stb-master/stb_textedit.h:      // shouldn't happen, but if it does, fall through to end-of-line case
include/stb-master/stb_textedit.h:   }
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   // if the last character is a newline, return that. otherwise return 'after' the last character
include/stb-master/stb_textedit.h:   if (STB_TEXTEDIT_GETCHAR(str, i+r.num_chars-1) == STB_TEXTEDIT_NEWLINE)
include/stb-master/stb_textedit.h:      return i+r.num_chars-1;
include/stb-master/stb_textedit.h:   else
include/stb-master/stb_textedit.h:      return i+r.num_chars;
include/stb-master/stb_textedit.h:}
