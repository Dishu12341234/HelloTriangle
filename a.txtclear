include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   if (b->cursor >= b->size)
include/stb-master/stb_truetype.h:      return 0;
include/stb-master/stb_truetype.h:   return b->data[b->cursor++];
include/stb-master/stb_truetype.h:}
