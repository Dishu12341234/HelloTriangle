include/stb-master/stb_truetype.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// Signed Distance Function (or Field) rendering
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_FreeSDF(unsigned char *bitmap, void *userdata);
include/stb-master/stb_truetype.h:// frees the SDF bitmap allocated below
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF unsigned char * stbtt_GetGlyphSDF(const stbtt_fontinfo *info, float scale, int glyph, int padding, unsigned char onedge_value, float pixel_dist_scale, int *width, int *height, int *xoff, int *yoff);
include/stb-master/stb_truetype.h:STBTT_DEF unsigned char * stbtt_GetCodepointSDF(const stbtt_fontinfo *info, float scale, int codepoint, int padding, unsigned char onedge_value, float pixel_dist_scale, int *width, int *height, int *xoff, int *yoff);
include/stb-master/stb_truetype.h:// These functions compute a discretized SDF field for a single character, suitable for storing
include/stb-master/stb_truetype.h:// in a single-channel texture, sampling with bilinear filtering, and testing against
include/stb-master/stb_truetype.h:// larger than some threshold to produce scalable fonts.
include/stb-master/stb_truetype.h://        info              --  the font
include/stb-master/stb_truetype.h://        scale             --  controls the size of the resulting SDF bitmap, same as it would be creating a regular bitmap
include/stb-master/stb_truetype.h://        glyph/codepoint   --  the character to generate the SDF for
include/stb-master/stb_truetype.h://        padding           --  extra "pixels" around the character which are filled with the distance to the character (not 0),
include/stb-master/stb_truetype.h://                                 which allows effects like bit outlines
include/stb-master/stb_truetype.h://        onedge_value      --  value 0-255 to test the SDF against to reconstruct the character (i.e. the isocontour of the character)
include/stb-master/stb_truetype.h://        pixel_dist_scale  --  what value the SDF should increase by when moving one SDF "pixel" away from the edge (on the 0..255 scale)
include/stb-master/stb_truetype.h://                                 if positive, > onedge_value is inside; if negative, < onedge_value is inside
include/stb-master/stb_truetype.h://        width,height      --  output height & width of the SDF bitmap (including padding)
include/stb-master/stb_truetype.h://        xoff,yoff         --  output origin of the character
include/stb-master/stb_truetype.h://        return value      --  a 2D array of bytes 0..255, width*height in size
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// pixel_dist_scale & onedge_value are a scale & bias that allows you to make
include/stb-master/stb_truetype.h:// optimal use of the limited 0..255 for your application, trading off precision
include/stb-master/stb_truetype.h:// and special effects. SDF values outside the range 0..255 are clamped to 0..255.
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// Example:
include/stb-master/stb_truetype.h://      scale = stbtt_ScaleForPixelHeight(22)
include/stb-master/stb_truetype.h://      padding = 5
include/stb-master/stb_truetype.h://      onedge_value = 180
include/stb-master/stb_truetype.h://      pixel_dist_scale = 180/5.0 = 36.0
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h://      This will create an SDF bitmap in which the character is about 22 pixels
include/stb-master/stb_truetype.h://      high but the whole bitmap is about 22+5+5=32 pixels high. To produce a filled
include/stb-master/stb_truetype.h://      shape, sample the SDF at each pixel and fill the pixel if the SDF value
include/stb-master/stb_truetype.h://      is greater than or equal to 180/255. (You'll actually want to antialias,
include/stb-master/stb_truetype.h://      which is beyond the scope of this example.) Additionally, you can compute
include/stb-master/stb_truetype.h://      offset outlines (e.g. to stroke the character border inside & outside,
include/stb-master/stb_truetype.h://      or only outside). For example, to fill outside the character up to 3 SDF
include/stb-master/stb_truetype.h://      pixels, you would compare against (180-36.0*3)/255 = 72/255. The above
include/stb-master/stb_truetype.h://      choice of variables maps a range from 5 pixels outside the shape to
include/stb-master/stb_truetype.h://      2 pixels inside the shape to 0..255; this is intended primarily for apply
include/stb-master/stb_truetype.h://      outside effects only (the interior range is needed to allow proper
include/stb-master/stb_truetype.h://      antialiasing of the font at *smaller* sizes)
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// The function computes the SDF analytically at each SDF pixel, not by e.g.
include/stb-master/stb_truetype.h:// building a higher-res bitmap and approximating it. In theory the quality
include/stb-master/stb_truetype.h:// should be as high as possible for an SDF of this size & representation, but
include/stb-master/stb_truetype.h:// unclear if this is true in practice (perhaps building a higher-res bitmap
include/stb-master/stb_truetype.h:// and computing from that can allow drop-out prevention).
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// The algorithm has not been optimized at all, so expect it to be slow
include/stb-master/stb_truetype.h:// if computing lots of characters or very large sizes.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// Finding the right font...
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// You should really just solve this offline, keep your own tables
include/stb-master/stb_truetype.h:// of what font is what, and don't try to get it out of the .ttf file.
include/stb-master/stb_truetype.h:// That's because getting it out of the .ttf file is really hard, because
include/stb-master/stb_truetype.h:// the names in the file can appear in many possible encodings, in many
include/stb-master/stb_truetype.h:// possible languages, and e.g. if you need a case-insensitive comparison,
include/stb-master/stb_truetype.h:// the details of that depend on the encoding & language in a complex way
include/stb-master/stb_truetype.h:// (actually underspecified in truetype, but also gigantic).
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// But you can use the provided functions in two possible ways:
include/stb-master/stb_truetype.h://     stbtt_FindMatchingFont() will use *case-sensitive* comparisons on
include/stb-master/stb_truetype.h://             unicode-encoded names to try to find the font you want;
include/stb-master/stb_truetype.h://             you can run this before calling stbtt_InitFont()
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h://     stbtt_GetFontNameString() lets you get any of the various strings
include/stb-master/stb_truetype.h://             from the file yourself and do your own comparisons on them.
include/stb-master/stb_truetype.h://             You have to have called stbtt_InitFont() first.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int stbtt_FindMatchingFont(const unsigned char *fontdata, const char *name, int flags);
include/stb-master/stb_truetype.h:// returns the offset (not index) of the font that matches, or -1 if none
include/stb-master/stb_truetype.h://   if you use STBTT_MACSTYLE_DONTCARE, use a font name like "Arial Bold".
include/stb-master/stb_truetype.h://   if you use any other flag, use a font name like "Arial"; this checks
include/stb-master/stb_truetype.h://     the 'macStyle' header field; i don't know if fonts set this consistently
include/stb-master/stb_truetype.h:#define STBTT_MACSTYLE_DONTCARE     0
include/stb-master/stb_truetype.h:#define STBTT_MACSTYLE_BOLD         1
include/stb-master/stb_truetype.h:#define STBTT_MACSTYLE_ITALIC       2
include/stb-master/stb_truetype.h:#define STBTT_MACSTYLE_UNDERSCORE   4
include/stb-master/stb_truetype.h:#define STBTT_MACSTYLE_NONE         8   // <= not same as 0, this makes us check the bitfield is 0
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int stbtt_CompareUTF8toUTF16_bigendian(const char *s1, int len1, const char *s2, int len2);
include/stb-master/stb_truetype.h:// returns 1/0 whether the first string interpreted as utf8 is identical to
include/stb-master/stb_truetype.h:// the second string interpreted as big-endian utf16... useful for strings from next func
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF const char *stbtt_GetFontNameString(const stbtt_fontinfo *font, int *length, int platformID, int encodingID, int languageID, int nameID);
include/stb-master/stb_truetype.h:// returns the string (which may be big-endian double byte, e.g. for unicode)
include/stb-master/stb_truetype.h:// and puts the length in bytes in *length.
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// some of the values for the IDs are below; for more see the truetype spec:
include/stb-master/stb_truetype.h://     http://developer.apple.com/textfonts/TTRefMan/RM06/Chap6name.html
include/stb-master/stb_truetype.h://     http://www.microsoft.com/typography/otspec/name.htm
