include/stb-master/stb_voxel_render.h:static const char *stbvox_vertex_program =
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:      STBVOX_SHADER_VERSION
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   #ifdef STBVOX_ICONFIG_FACE_ATTRIBUTE  // NOT TAG_face_sampled
include/stb-master/stb_voxel_render.h:      "in uvec4 attr_face;\n"
include/stb-master/stb_voxel_render.h:   #else
include/stb-master/stb_voxel_render.h:      "uniform usamplerBuffer facearray;\n"
include/stb-master/stb_voxel_render.h:   #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   #ifdef STBVOX_ICONFIG_FACE_ARRAY_2
include/stb-master/stb_voxel_render.h:      "uniform usamplerBuffer facearray2;\n"
include/stb-master/stb_voxel_render.h:   #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // vertex input data
include/stb-master/stb_voxel_render.h:      "in uint attr_vertex;\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // per-buffer data
include/stb-master/stb_voxel_render.h:      "uniform vec3 transform[3];\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // per-frame data
include/stb-master/stb_voxel_render.h:      "uniform vec4 camera_pos;\n"  // 4th value is used for arbitrary hacking
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // to simplify things, we avoid using more than 256 uniform vectors
include/stb-master/stb_voxel_render.h:      // in fragment shader to avoid possible 1024 component limit, so
include/stb-master/stb_voxel_render.h:      // we access this table in the fragment shader.
include/stb-master/stb_voxel_render.h:      "uniform vec3 normal_table[32];\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      #ifndef STBVOX_CONFIG_OPENGL_MODELVIEW
include/stb-master/stb_voxel_render.h:         "uniform mat4x4 model_view;\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // fragment output data
include/stb-master/stb_voxel_render.h:      "flat out uvec4  facedata;\n"
include/stb-master/stb_voxel_render.h:      "     out  vec3  voxelspace_pos;\n"
include/stb-master/stb_voxel_render.h:      "     out  vec3  vnormal;\n"
include/stb-master/stb_voxel_render.h:      "     out float  texlerp;\n"
include/stb-master/stb_voxel_render.h:      "     out float  amb_occ;\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // @TODO handle the HLSL way to do this
include/stb-master/stb_voxel_render.h:      "void main()\n"
include/stb-master/stb_voxel_render.h:      "{\n"
include/stb-master/stb_voxel_render.h:      #ifdef STBVOX_ICONFIG_FACE_ATTRIBUTE
include/stb-master/stb_voxel_render.h:         "   facedata = attr_face;\n"
include/stb-master/stb_voxel_render.h:      #else
include/stb-master/stb_voxel_render.h:         "   int faceID = gl_VertexID >> 2;\n"
include/stb-master/stb_voxel_render.h:         "   facedata   = texelFetch(facearray, faceID);\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // extract data for vertex
include/stb-master/stb_voxel_render.h:      "   vec3 offset;\n"
include/stb-master/stb_voxel_render.h:      "   offset.x = float( (attr_vertex       ) & 127u );\n"             // a[0..6]
include/stb-master/stb_voxel_render.h:      "   offset.y = float( (attr_vertex >>  7u) & 127u );\n"             // a[7..13]
include/stb-master/stb_voxel_render.h:      "   offset.z = float( (attr_vertex >> 14u) & 511u );\n"             // a[14..22]
include/stb-master/stb_voxel_render.h:      "   amb_occ  = float( (attr_vertex >> 23u) &  63u ) / 63.0;\n"      // a[23..28]
include/stb-master/stb_voxel_render.h:      "   texlerp  = float( (attr_vertex >> 29u)        ) /  7.0;\n"      // a[29..31]
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      "   vnormal = normal_table[(facedata.w>>2u) & 31u];\n"
include/stb-master/stb_voxel_render.h:      "   voxelspace_pos = offset * transform[0];\n"  // mesh-to-object scale
include/stb-master/stb_voxel_render.h:      "   vec3 position  = voxelspace_pos + transform[1];\n"  // mesh-to-object translate
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      #ifdef STBVOX_DEBUG_TEST_NORMALS
include/stb-master/stb_voxel_render.h:         "   if ((facedata.w & 28u) == 16u || (facedata.w & 28u) == 24u)\n"
include/stb-master/stb_voxel_render.h:         "      position += vnormal.xyz * camera_pos.w;\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      #ifndef STBVOX_CONFIG_OPENGL_MODELVIEW
include/stb-master/stb_voxel_render.h:         "   gl_Position = model_view * vec4(position,1.0);\n"
include/stb-master/stb_voxel_render.h:      #else
include/stb-master/stb_voxel_render.h:         "   gl_Position = gl_ModelViewProjectionMatrix * vec4(position,1.0);\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      "}\n"
include/stb-master/stb_voxel_render.h:};
