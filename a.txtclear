include/stb-master/stb_textedit.h:// discard the oldest entry in the redo list--it's bad if this
include/stb-master/stb_textedit.h:// ever happens, but because undo & redo have to store the actual
include/stb-master/stb_textedit.h:// characters in different cases, the redo character buffer can
include/stb-master/stb_textedit.h:// fill up even though the undo buffer didn't
include/stb-master/stb_textedit.h:static void stb_textedit_discard_redo(StbUndoState *state)
include/stb-master/stb_textedit.h:{
include/stb-master/stb_textedit.h:   int k = STB_TEXTEDIT_UNDOSTATECOUNT-1;
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:   if (state->redo_point <= k) {
include/stb-master/stb_textedit.h:      // if the k'th undo state has characters, clean those up
include/stb-master/stb_textedit.h:      if (state->undo_rec[k].char_storage >= 0) {
include/stb-master/stb_textedit.h:         int n = state->undo_rec[k].insert_length, i;
include/stb-master/stb_textedit.h:         // move the remaining redo character data to the end of the buffer
