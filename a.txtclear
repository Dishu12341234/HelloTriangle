include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   stbtt__buf r;
include/stb-master/stb_truetype.h:   STBTT_assert(size < 0x40000000);
include/stb-master/stb_truetype.h:   r.data = (stbtt_uint8*) p;
include/stb-master/stb_truetype.h:   r.size = (int) size;
include/stb-master/stb_truetype.h:   r.cursor = 0;
include/stb-master/stb_truetype.h:   return r;
include/stb-master/stb_truetype.h:}
