include/stb-master/stb_rect_pack.h:STBRP_DEF void stbrp_setup_allow_out_of_mem(stbrp_context *context, int allow_out_of_mem)
include/stb-master/stb_rect_pack.h:{
include/stb-master/stb_rect_pack.h:   if (allow_out_of_mem)
include/stb-master/stb_rect_pack.h:      // if it's ok to run out of memory, then don't bother aligning them;
include/stb-master/stb_rect_pack.h:      // this gives better packing, but may fail due to OOM (even though
include/stb-master/stb_rect_pack.h:      // the rectangles easily fit). @TODO a smarter approach would be to only
include/stb-master/stb_rect_pack.h:      // quantize once we've hit OOM, then we could get rid of this parameter.
include/stb-master/stb_rect_pack.h:      context->align = 1;
include/stb-master/stb_rect_pack.h:   else {
include/stb-master/stb_rect_pack.h:      // if it's not ok to run out of memory, then quantize the widths
include/stb-master/stb_rect_pack.h:      // so that num_nodes is always enough nodes.
include/stb-master/stb_rect_pack.h:      //
include/stb-master/stb_rect_pack.h:      // I.e. num_nodes * align >= width
include/stb-master/stb_rect_pack.h:      //                  align >= width / num_nodes
include/stb-master/stb_rect_pack.h:      //                  align = ceil(width/num_nodes)
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:      context->align = (context->width + context->num_nodes-1) / context->num_nodes;
include/stb-master/stb_rect_pack.h:   }
include/stb-master/stb_rect_pack.h:}
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:STBRP_DEF void stbrp_init_target(stbrp_context *context, int width, int height, stbrp_node *nodes, int num_nodes)
include/stb-master/stb_rect_pack.h:{
include/stb-master/stb_rect_pack.h:   int i;
include/stb-master/stb_rect_pack.h:
include/stb-master/stb_rect_pack.h:   for (i=0; i < num_nodes-1; ++i)
include/stb-master/stb_rect_pack.h:      nodes[i].next = &nodes[i+1];
include/stb-master/stb_rect_pack.h:   nodes[i].next = NULL;
include/stb-master/stb_rect_pack.h:   context->init_mode = STBRP__INIT_skyline;
include/stb-master/stb_rect_pack.h:   context->heuristic = STBRP_HEURISTIC_Skyline_default;
include/stb-master/stb_rect_pack.h:   context->free_head = &nodes[0];
