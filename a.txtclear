include/stb-master/stb_rect_pack.h:{
include/stb-master/stb_rect_pack.h:   switch (context->init_mode) {
include/stb-master/stb_rect_pack.h:      case STBRP__INIT_skyline:
include/stb-master/stb_rect_pack.h:         STBRP_ASSERT(heuristic == STBRP_HEURISTIC_Skyline_BL_sortHeight || heuristic == STBRP_HEURISTIC_Skyline_BF_sortHeight);
include/stb-master/stb_rect_pack.h:         context->heuristic = heuristic;
include/stb-master/stb_rect_pack.h:         break;
include/stb-master/stb_rect_pack.h:      default:
include/stb-master/stb_rect_pack.h:         STBRP_ASSERT(0);
include/stb-master/stb_rect_pack.h:   }
include/stb-master/stb_rect_pack.h:}
