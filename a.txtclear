include/stb-master/stb_hexwave.h:      for (i=halfwidth; i < width; ++i)
include/stb-master/stb_hexwave.h:         blep_buffer [j*width+i] -= 1.0f;
include/stb-master/stb_hexwave.h:      // subtract ramp
include/stb-master/stb_hexwave.h:      for (i=halfwidth; i < width; ++i)
include/stb-master/stb_hexwave.h:         blamp_buffer[j*width+i] -= (j+i*oversample-half)*(1.0f/oversample);
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   hexblep.blep  = blep_buffer;
include/stb-master/stb_hexwave.h:   hexblep.blamp = blamp_buffer;
include/stb-master/stb_hexwave.h:   hexblep.width = width;
include/stb-master/stb_hexwave.h:   hexblep.oversample = oversample;
include/stb-master/stb_hexwave.h:
