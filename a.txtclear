include/stb-master/stb_image.h:#define STBI__ZFAST_MASK  ((1 << STBI__ZFAST_BITS) - 1)
include/stb-master/stb_image.h:#define STBI__ZNSYMS 288 // number of symbols in literal/length alphabet
