include/stb-master/stb_image_write.h:/* stb_image_write - v1.16 - public domain - http://nothings.org/stb
include/stb-master/stb_image_write.h:   writes out PNG/BMP/TGA/JPEG/HDR images to C stdio - Sean Barrett 2010-2015
include/stb-master/stb_image_write.h:                                     no warranty implied; use at your own risk
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   Before #including,
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:       #define STB_IMAGE_WRITE_IMPLEMENTATION
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   in the file that you want to have the implementation.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   Will probably not work correctly with strict-aliasing optimizations.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:ABOUT:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   This header file is a library for writing images to C stdio or a callback.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   The PNG output is not optimal; it is 20-50% larger than the file
include/stb-master/stb_image_write.h:   written by a decent optimizing implementation; though providing a custom
include/stb-master/stb_image_write.h:   zlib compress function (see STBIW_ZLIB_COMPRESS) can mitigate that.
include/stb-master/stb_image_write.h:   This library is designed for source code compactness and simplicity,
include/stb-master/stb_image_write.h:   not optimal image file size or run-time performance.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:BUILDING:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   You can #define STBIW_ASSERT(x) before the #include to avoid using assert.h.
include/stb-master/stb_image_write.h:   You can #define STBIW_MALLOC(), STBIW_REALLOC(), and STBIW_FREE() to replace
include/stb-master/stb_image_write.h:   malloc,realloc,free.
include/stb-master/stb_image_write.h:   You can #define STBIW_MEMMOVE() to replace memmove()
include/stb-master/stb_image_write.h:   You can #define STBIW_ZLIB_COMPRESS to use a custom zlib-style compress function
include/stb-master/stb_image_write.h:   for PNG compression (instead of the builtin one), it must have the following signature:
include/stb-master/stb_image_write.h:   unsigned char * my_compress(unsigned char *data, int data_len, int *out_len, int quality);
include/stb-master/stb_image_write.h:   The returned data will be freed with STBIW_FREE() (free() by default),
include/stb-master/stb_image_write.h:   so it must be heap allocated with STBIW_MALLOC() (malloc() by default),
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:UNICODE:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   If compiling for Windows and you wish to use Unicode filenames, compile
include/stb-master/stb_image_write.h:   with
include/stb-master/stb_image_write.h:       #define STBIW_WINDOWS_UTF8
include/stb-master/stb_image_write.h:   and pass utf8-encoded filenames. Call stbiw_convert_wchar_to_utf8 to convert
include/stb-master/stb_image_write.h:   Windows wchar_t filenames to utf8.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:USAGE:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   There are five functions, one for each image file format:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:     int stbi_write_png(char const *filename, int w, int h, int comp, const void *data, int stride_in_bytes);
include/stb-master/stb_image_write.h:     int stbi_write_bmp(char const *filename, int w, int h, int comp, const void *data);
include/stb-master/stb_image_write.h:     int stbi_write_tga(char const *filename, int w, int h, int comp, const void *data);
include/stb-master/stb_image_write.h:     int stbi_write_jpg(char const *filename, int w, int h, int comp, const void *data, int quality);
include/stb-master/stb_image_write.h:     int stbi_write_hdr(char const *filename, int w, int h, int comp, const float *data);
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:     void stbi_flip_vertically_on_write(int flag); // flag is non-zero to flip data vertically
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   There are also five equivalent functions that use an arbitrary write function. You are
include/stb-master/stb_image_write.h:   expected to open/close your file-equivalent before and after calling these:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:     int stbi_write_png_to_func(stbi_write_func *func, void *context, int w, int h, int comp, const void  *data, int stride_in_bytes);
include/stb-master/stb_image_write.h:     int stbi_write_bmp_to_func(stbi_write_func *func, void *context, int w, int h, int comp, const void  *data);
include/stb-master/stb_image_write.h:     int stbi_write_tga_to_func(stbi_write_func *func, void *context, int w, int h, int comp, const void  *data);
include/stb-master/stb_image_write.h:     int stbi_write_hdr_to_func(stbi_write_func *func, void *context, int w, int h, int comp, const float *data);
include/stb-master/stb_image_write.h:     int stbi_write_jpg_to_func(stbi_write_func *func, void *context, int x, int y, int comp, const void *data, int quality);
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   where the callback is:
include/stb-master/stb_image_write.h:      void stbi_write_func(void *context, void *data, int size);
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   You can configure it with these global variables:
include/stb-master/stb_image_write.h:      int stbi_write_tga_with_rle;             // defaults to true; set to 0 to disable RLE
include/stb-master/stb_image_write.h:      int stbi_write_png_compression_level;    // defaults to 8; set to higher for more compression
include/stb-master/stb_image_write.h:      int stbi_write_force_png_filter;         // defaults to -1; set to 0..5 to force a filter mode
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   You can define STBI_WRITE_NO_STDIO to disable the file variant of these
include/stb-master/stb_image_write.h:   functions, so the library will not use stdio.h at all. However, this will
include/stb-master/stb_image_write.h:   also disable HDR writing, because it requires stdio for formatted output.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   Each function returns 0 on failure and non-0 on success.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   The functions create an image file defined by the parameters. The image
include/stb-master/stb_image_write.h:   is a rectangle of pixels stored from left-to-right, top-to-bottom.
include/stb-master/stb_image_write.h:   Each pixel contains 'comp' channels of data stored interleaved with 8-bits
include/stb-master/stb_image_write.h:   per channel, in the following order: 1=Y, 2=YA, 3=RGB, 4=RGBA. (Y is
include/stb-master/stb_image_write.h:   monochrome color.) The rectangle is 'w' pixels wide and 'h' pixels tall.
include/stb-master/stb_image_write.h:   The *data pointer points to the first byte of the top-left-most pixel.
include/stb-master/stb_image_write.h:   For PNG, "stride_in_bytes" is the distance in bytes from the first byte of
include/stb-master/stb_image_write.h:   a row of pixels to the first byte of the next row of pixels.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   PNG creates output files with the same number of components as the input.
include/stb-master/stb_image_write.h:   The BMP format expands Y to RGB in the file format and does not
include/stb-master/stb_image_write.h:   output alpha.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   PNG supports writing rectangles of data even when the bytes storing rows of
include/stb-master/stb_image_write.h:   data are not consecutive in memory (e.g. sub-rectangles of a larger image),
include/stb-master/stb_image_write.h:   by supplying the stride between the beginning of adjacent rows. The other
include/stb-master/stb_image_write.h:   formats do not. (Thus you cannot write a native-format BMP through the BMP
include/stb-master/stb_image_write.h:   writer, both because it is in BGR order and because it may have padding
include/stb-master/stb_image_write.h:   at the end of the line.)
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   PNG allows you to set the deflate compression level by setting the global
include/stb-master/stb_image_write.h:   variable 'stbi_write_png_compression_level' (it defaults to 8).
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   HDR expects linear float data. Since the format is always 32-bit rgb(e)
include/stb-master/stb_image_write.h:   data, alpha (if provided) is discarded, and for monochrome data it is
include/stb-master/stb_image_write.h:   replicated across all three channels.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   TGA supports RLE or non-RLE compressed data. To use non-RLE-compressed
include/stb-master/stb_image_write.h:   data, set the global variable 'stbi_write_tga_with_rle' to 0.
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   JPEG does ignore alpha channels in input data; quality is between 1 and 100.
include/stb-master/stb_image_write.h:   Higher quality looks better but results in a bigger image.
include/stb-master/stb_image_write.h:   JPEG baseline (no JPEG progressive).
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:CREDITS:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:
include/stb-master/stb_image_write.h:   Sean Barrett           -    PNG/BMP/TGA
include/stb-master/stb_image_write.h:   Baldur Karlsson        -    HDR
include/stb-master/stb_image_write.h:   Jean-Sebastien Guay    -    TGA monochrome
include/stb-master/stb_image_write.h:   Tim Kelsey             -    misc enhancements
