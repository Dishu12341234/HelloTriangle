include/stb-master/stb_dxt.h:// compression mode (bitflags)
include/stb-master/stb_dxt.h:#define STB_DXT_NORMAL    0
include/stb-master/stb_dxt.h:#define STB_DXT_DITHER    1   // use dithering. was always dubious, now deprecated. does nothing!
include/stb-master/stb_dxt.h:#define STB_DXT_HIGHQUAL  2   // high quality mode, does two refinement steps instead of 1. ~30-40% slower.
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:STBDDEF void stb_compress_dxt_block(unsigned char *dest, const unsigned char *src_rgba_four_bytes_per_pixel, int alpha, int mode);
include/stb-master/stb_dxt.h:STBDDEF void stb_compress_bc4_block(unsigned char *dest, const unsigned char *src_r_one_byte_per_pixel);
include/stb-master/stb_dxt.h:STBDDEF void stb_compress_bc5_block(unsigned char *dest, const unsigned char *src_rg_two_byte_per_pixel);
