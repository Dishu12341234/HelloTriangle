include/stb-master/stb_voxel_render.h:static const char *stbvox_fragment_program =
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:      STBVOX_SHADER_VERSION
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // rlerp is lerp but with t on the left, like god intended
include/stb-master/stb_voxel_render.h:      #if defined(STBVOX_ICONFIG_GLSL)
include/stb-master/stb_voxel_render.h:         "#define rlerp(t,x,y) mix(x,y,t)\n"
include/stb-master/stb_voxel_render.h:      #elif defined(STBVOX_CONFIG_HLSL)
include/stb-master/stb_voxel_render.h:         "#define rlerp(t,x,y) lerp(x,y,t)\n"
include/stb-master/stb_voxel_render.h:      #else
include/stb-master/stb_voxel_render.h:         #error "need definition of rlerp()"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // vertex-shader output data
include/stb-master/stb_voxel_render.h:      "flat in uvec4  facedata;\n"
include/stb-master/stb_voxel_render.h:      "     in  vec3  voxelspace_pos;\n"
include/stb-master/stb_voxel_render.h:      "     in  vec3  vnormal;\n"
include/stb-master/stb_voxel_render.h:      "     in float  texlerp;\n"
include/stb-master/stb_voxel_render.h:      "     in float  amb_occ;\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // per-buffer data
include/stb-master/stb_voxel_render.h:      "uniform vec3 transform[3];\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // per-frame data
include/stb-master/stb_voxel_render.h:      "uniform vec4 camera_pos;\n"  // 4th value is used for arbitrary hacking
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      // probably constant data
include/stb-master/stb_voxel_render.h:      "uniform vec4 ambient[4];\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      #ifndef STBVOX_ICONFIG_UNTEXTURED
include/stb-master/stb_voxel_render.h:         // generally constant data
include/stb-master/stb_voxel_render.h:         "uniform sampler2DArray tex_array[2];\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:         #ifdef STBVOX_CONFIG_PREFER_TEXBUFFER
include/stb-master/stb_voxel_render.h:            "uniform samplerBuffer color_table;\n"
include/stb-master/stb_voxel_render.h:            "uniform samplerBuffer texscale;\n"
include/stb-master/stb_voxel_render.h:            "uniform samplerBuffer texgen;\n"
include/stb-master/stb_voxel_render.h:         #else
include/stb-master/stb_voxel_render.h:            "uniform vec4 color_table[64];\n"
include/stb-master/stb_voxel_render.h:            "uniform vec4 texscale[64];\n" // instead of 128, to avoid running out of uniforms
include/stb-master/stb_voxel_render.h:            "uniform vec3 texgen[64];\n"
include/stb-master/stb_voxel_render.h:         #endif
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      "out vec4  outcolor;\n"
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      #if defined(STBVOX_CONFIG_LIGHTING) || defined(STBVOX_CONFIG_LIGHTING_SIMPLE)
include/stb-master/stb_voxel_render.h:      "vec3 compute_lighting(vec3 pos, vec3 norm, vec3 albedo, vec3 ambient);\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:      #if defined(STBVOX_CONFIG_FOG) || defined(STBVOX_CONFIG_FOG_SMOOTHSTEP)
include/stb-master/stb_voxel_render.h:      "vec3 compute_fog(vec3 color, vec3 relative_pos, float fragment_alpha);\n"
include/stb-master/stb_voxel_render.h:      #endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:      "void main()\n"
include/stb-master/stb_voxel_render.h:      "{\n"
