Update.cxx:
Update.cxx:void HelloTriangleApplication::initGameObjects()
Update.cxx:{
Update.cxx:    // ===== INIT =====
Update.cxx:    VulkanContext context{};
Update.cxx:    context.device = device;
Update.cxx:    context.physicalDevice = physicalDevice;
Update.cxx:    context.graphicsQueue = graphicsQueue;
Update.cxx:    context.instance = instance;
Update.cxx:    context.presentQueue = presentQueue;
Update.cxx:    context.commandPool = commandPool;
Update.cxx:
Update.cxx:    camera = new Camera(context);
Update.cxx:    gameObjectPool.init(context);
Update.cxx:
Update.cxx:    StandardBoxModel *testBlock = gameObjectPool.createNewBoxModelAndAppend({40, 30, 0}, {0, 1, 1, 1, 1, 1});
Update.cxx:    StandardBoxModel *testBlock1 = gameObjectPool.createNewBoxModelAndAppend({41, 30, 0}, {2, 1, 1, 1, 1, 1});
Update.cxx:    StandardBoxModel *testBlock2 = gameObjectPool.createNewBoxModelAndAppend({41, 31, 0}, {3, 1, 1, 1, 1, 1});
Update.cxx:    
Update.cxx:    StandardBoxModel *testBlock3 = gameObjectPool.createNewBoxModelAndAppend({41, 31, 2}, {0, 1, 1, 1, 1, 1});
Update.cxx:    // testBlock3->removeFace(FRONT);
Update.cxx:    // testBlock3->faceUVTextureOffsets[FRONT] = 2;
Update.cxx:
Update.cxx:
Update.cxx:    Chunk c(&gameObjectPool);
Update.cxx:    c.setOffset({0, 0});
Update.cxx:    c.generateChunks();
Update.cxx:
Update.cxx:    gameObjectPool.initUpload();
Update.cxx:}
Update.cxx:
Update.cxx:void HelloTriangleApplication::updateUniformBuffer(uint32_t currentImage)
Update.cxx:{
Update.cxx:    static auto startTime = std::chrono::high_resolution_clock::now();
Update.cxx:
Update.cxx:    auto currentTime = std::chrono::high_resolution_clock::now();
Update.cxx:    float time = std::chrono::duration<float, std::chrono::seconds::period>(currentTime - startTime).count();
Update.cxx:
Update.cxx:    UniformBufferObject ubo{};
Update.cxx:    ubo.model = glm::translate(glm::mat4(1.f), glm::vec3(1, 1, 1));
Update.cxx:    int key = glfwGetKey(_window, GLFW_KEY_ESCAPE);
Update.cxx:    if (key == GLFW_PRESS)
Update.cxx:    {
Update.cxx:        glfwSetWindowShouldClose(_window, true);
Update.cxx:        menu = !menu;
Update.cxx:        if (menu)
Update.cxx:            glfwSetInputMode(_window, GLFW_CURSOR, GLFW_CURSOR_NORMAL);
Update.cxx:        else
Update.cxx:            glfwSetInputMode(_window, GLFW_CURSOR, GLFW_CURSOR_DISABLED);
Update.cxx:    }
Update.cxx:
Update.cxx:    static bool rWasPressed = false;
Update.cxx:    bool rPressedNow = glfwGetKey(_window, GLFW_KEY_R) == GLFW_PRESS;
Update.cxx:
Update.cxx:    if (rPressedNow && !rWasPressed)
Update.cxx:    {
Update.cxx:        std::cout << "Re-upload triggered\n";
Update.cxx:        gameObjectPool.reuploadAll();
Update.cxx:    }
Update.cxx:
Update.cxx:    rWasPressed = rPressedNow;
Update.cxx:
Update.cxx:    camera->updateUBO(ubo, swapChainExtent, *event);
Update.cxx:
Update.cxx:    glm::vec3 coordinates = camera->gePositionInWorldCoords();
Update.cxx:    std::cout << "(x,y,z):(" << coordinates.x << "," << coordinates.y << "," << coordinates.z << ")" << std::endl;
Update.cxx:
Update.cxx:    memcpy(uniformBuffersMapped[currentImage], &ubo, sizeof(ubo));
Update.cxx:}
Update.cxx:
Update.cxx:void HelloTriangleApplication::updateShaderStorageBuffer(uint32_t currentFrame)
Update.cxx:{
Update.cxx:    VkDeviceSize bufferSize = sizeof(ObjectData) * gameObjectPool.gameObjects.size();
Update.cxx:
Update.cxx:    ObjectData *data;
Update.cxx:    vkMapMemory(device,
Update.cxx:                ssboBuffersMemory[currentFrame],
Update.cxx:                0,
Update.cxx:                bufferSize,
Update.cxx:                0,
Update.cxx:                (void **)&data);
Update.cxx:
Update.cxx:    for (size_t i = 0; i < gameObjectPool.gameObjects.size(); i++)
Update.cxx:    {
Update.cxx:        data[i].model = glm::translate(glm::mat4(1.f), gameObjectPool.gameObjects.at(i)->transform.position);
Update.cxx:        data[i].tileIndex[0] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[0]);
Update.cxx:        data[i].tileIndex[1] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[1]);
Update.cxx:        data[i].tileIndex[2] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[2]);
Update.cxx:        data[i].tileIndex[3] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[3]);
Update.cxx:        data[i].tileIndex[4] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[4]);
Update.cxx:        data[i].tileIndex[5] = (gameObjectPool.gameObjects.at(i)->faceUVTextureOffsets[5]);
Update.cxx:    }
Update.cxx:
Update.cxx:    vkUnmapMemory(device, ssboBuffersMemory[currentFrame]);
Update.cxx:}
