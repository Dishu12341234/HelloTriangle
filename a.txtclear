intiVk.cxx:void HelloTriangleApplication::createBuffer(VkDeviceSize size, VkBufferUsageFlags usage, VkMemoryPropertyFlags properties, VkBuffer &buffer, VkDeviceMemory &bufferMemory)
intiVk.cxx:{
intiVk.cxx:    VkBufferCreateInfo bufferInfo{};
intiVk.cxx:    bufferInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
intiVk.cxx:    bufferInfo.size = size;
intiVk.cxx:    bufferInfo.usage = usage;
intiVk.cxx:    bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
intiVk.cxx:
intiVk.cxx:    if (vkCreateBuffer(device, &bufferInfo, nullptr, &buffer) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to create buffer!");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    VkMemoryRequirements memRequirements;
intiVk.cxx:    vkGetBufferMemoryRequirements(device, buffer, &memRequirements);
intiVk.cxx:
intiVk.cxx:    VkMemoryAllocateInfo allocInfo{};
intiVk.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
intiVk.cxx:    allocInfo.allocationSize = memRequirements.size;
intiVk.cxx:    allocInfo.memoryTypeIndex = findMemoryType(memRequirements.memoryTypeBits, properties);
intiVk.cxx:
intiVk.cxx:    if (vkAllocateMemory(device, &allocInfo, nullptr, &bufferMemory) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to allocate buffer memory!");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    vkBindBufferMemory(device, buffer, bufferMemory, 0);
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::loadModel()
intiVk.cxx:{
intiVk.cxx:    tinyobj::attrib_t attrib;
intiVk.cxx:    std::vector<tinyobj::shape_t> shapes;
intiVk.cxx:    std::vector<tinyobj::material_t> materials;
intiVk.cxx:    std::string err, warn;
intiVk.cxx:
intiVk.cxx:    if (!tinyobj::LoadObj(&attrib, &shapes, &materials, &warn, &err, MODEL_PATH.c_str()))
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error(err);
intiVk.cxx:    }
intiVk.cxx:    if (warn.empty() == false)
intiVk.cxx:    {
intiVk.cxx:        std::cout << "WARN: " << warn << std::endl;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    std::unordered_map<Vertex, uint32_t> uniqueVertices{};
intiVk.cxx:
intiVk.cxx:    for (const auto &shape : shapes)
intiVk.cxx:    {
intiVk.cxx:        for (const auto &index : shape.mesh.indices)
intiVk.cxx:        {
intiVk.cxx:            Vertex vertex{};
intiVk.cxx:
intiVk.cxx:            vertex.pos = {
intiVk.cxx:                attrib.vertices[3 * index.vertex_index + 0],
intiVk.cxx:                attrib.vertices[3 * index.vertex_index + 1],
intiVk.cxx:                attrib.vertices[3 * index.vertex_index + 2]};
intiVk.cxx:
intiVk.cxx:            vertex.texCoord = {
intiVk.cxx:                attrib.texcoords[2 * index.texcoord_index + 0],
intiVk.cxx:                1.0f - attrib.texcoords[2 * index.texcoord_index + 1]};
intiVk.cxx:
intiVk.cxx:            vertex.color = {1.0f, 1.0f, 1.0f};
intiVk.cxx:
intiVk.cxx:            if (uniqueVertices.count(vertex) == 0)
intiVk.cxx:            {
intiVk.cxx:                uniqueVertices[vertex] = static_cast<uint32_t>(vertices.size());
intiVk.cxx:                vertices.push_back(vertex);
intiVk.cxx:            }
intiVk.cxx:
intiVk.cxx:            indices.push_back(uniqueVertices[vertex]);
intiVk.cxx:        }
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// here we are using a staging buffer which is accisible by the CPU and then afterwards copying the contents of the staging buffer to the vertex buffer
intiVk.cxx:void HelloTriangleApplication::createVertexBuffer()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Vertex Buffer..." << std::endl;
intiVk.cxx:
intiVk.cxx:    VkDeviceSize bufferSize = sizeof(vertices[0]) * vertices.size();
intiVk.cxx:
intiVk.cxx:    VkBuffer stagingBuffer;
intiVk.cxx:    VkDeviceMemory stagingBufferMemory;
intiVk.cxx:    // TX
intiVk.cxx:    createBuffer(bufferSize, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, stagingBuffer, stagingBufferMemory);
intiVk.cxx:
intiVk.cxx:    // filling in the vertex buffer
intiVk.cxx:    void *data;
intiVk.cxx:    vkMapMemory(device, stagingBufferMemory, 0, bufferSize, 0, &data);
intiVk.cxx:    memcpy(data, vertices.data(), (size_t)bufferSize);
intiVk.cxx:    vkUnmapMemory(device, stagingBufferMemory);
intiVk.cxx:
intiVk.cxx:    // creating the actul VBO and setting it up so the it is the destionation of the transfer source
intiVk.cxx:    // TX
intiVk.cxx:    createBuffer(bufferSize, VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, vertexBuffer, vertexBufferMemory);
intiVk.cxx:
intiVk.cxx:    // but we still have to copy the memory contents manully
intiVk.cxx:    copyBuffer(stagingBuffer, vertexBuffer, bufferSize);
intiVk.cxx:
intiVk.cxx:    vkDestroyBuffer(device, stagingBuffer, nullptr);
intiVk.cxx:    vkFreeMemory(device, stagingBufferMemory, nullptr);
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createIndexBuffer()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Index Buffer..." << std::endl;
intiVk.cxx:
intiVk.cxx:    VkDeviceSize bufferSize = sizeof(indices[0]) * indices.size();
intiVk.cxx:
intiVk.cxx:    VkBuffer stagingBuffer;
intiVk.cxx:    VkDeviceMemory stagingBufferMemory;
intiVk.cxx:
intiVk.cxx:    createBuffer(bufferSize, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, stagingBuffer, stagingBufferMemory);
intiVk.cxx:
intiVk.cxx:    void *data;
intiVk.cxx:    vkMapMemory(device, stagingBufferMemory, 0, bufferSize, 0, &data);
intiVk.cxx:    memcpy(data, indices.data(), (size_t)bufferSize);
intiVk.cxx:    vkUnmapMemory(device, stagingBufferMemory);
intiVk.cxx:
intiVk.cxx:    createBuffer(bufferSize, VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, indexBuffer, indexBufferMemory);
intiVk.cxx:
intiVk.cxx:    copyBuffer(stagingBuffer, indexBuffer, bufferSize);
intiVk.cxx:
intiVk.cxx:    vkDestroyBuffer(device, stagingBuffer, nullptr);
intiVk.cxx:    vkFreeMemory(device, stagingBufferMemory, nullptr);
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createUniformBuffers()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Uniform Buffers..." << std::endl;
intiVk.cxx:
intiVk.cxx:    VkDeviceSize bufferSize = sizeof(UniformBufferObject);
intiVk.cxx:
intiVk.cxx:    uniformBuffers.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:    uniformBuffersMemory.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:    uniformBuffersMapped.resize(MAX_FRAMES_IN_FLIGHT); // like 'void *data;'
intiVk.cxx:
intiVk.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
intiVk.cxx:    {
intiVk.cxx:        createBuffer(bufferSize, VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, uniformBuffers[i], uniformBuffersMemory[i]);
intiVk.cxx:        vkMapMemory(device, uniformBuffersMemory[i], 0, bufferSize, 0, &uniformBuffersMapped[i]);
intiVk.cxx:    }
intiVk.cxx:}
