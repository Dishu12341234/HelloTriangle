include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_1_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_2_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_3_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_4_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_5_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_6_8,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP3_7_8,
include/stb-master/stb_voxel_render.h:};
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:#define STBVOX_FACE_NONE  7
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:#define STBVOX_BLOCKTYPE_EMPTY    0
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:#ifdef STBVOX_BLOCKTYPE_SHORT
