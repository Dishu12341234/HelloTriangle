include/stb-master/stb_easy_font.h:// stb_easy_font.h - v1.1 - bitmap font for 3D rendering - public domain
include/stb-master/stb_easy_font.h:// Sean Barrett, Feb 2015
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://    Easy-to-deploy,
include/stb-master/stb_easy_font.h://    reasonably compact,
include/stb-master/stb_easy_font.h://    extremely inefficient performance-wise,
include/stb-master/stb_easy_font.h://    crappy-looking,
include/stb-master/stb_easy_font.h://    ASCII-only,
include/stb-master/stb_easy_font.h://    bitmap font for use in 3D APIs.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h:// Intended for when you just want to get some text displaying
include/stb-master/stb_easy_font.h:// in a 3D app as quickly as possible.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h:// Doesn't use any textures, instead builds characters out of quads.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h:// DOCUMENTATION:
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://   int stb_easy_font_width(char *text)
include/stb-master/stb_easy_font.h://   int stb_easy_font_height(char *text)
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      Takes a string and returns the horizontal size and the
include/stb-master/stb_easy_font.h://      vertical size (which can vary if 'text' has newlines).
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://   int stb_easy_font_print(float x, float y,
include/stb-master/stb_easy_font.h://                           char *text, unsigned char color[4],
include/stb-master/stb_easy_font.h://                           void *vertex_buffer, int vbuf_size)
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      Takes a string (which can contain '\n') and fills out a
include/stb-master/stb_easy_font.h://      vertex buffer with renderable data to draw the string.
include/stb-master/stb_easy_font.h://      Output data assumes increasing x is rightwards, increasing y
include/stb-master/stb_easy_font.h://      is downwards.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      The vertex data is divided into quads, i.e. there are four
include/stb-master/stb_easy_font.h://      vertices in the vertex buffer for each quad.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      The vertices are stored in an interleaved format:
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://         x:float
include/stb-master/stb_easy_font.h://         y:float
include/stb-master/stb_easy_font.h://         z:float
include/stb-master/stb_easy_font.h://         color:uint8[4]
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      You can ignore z and color if you get them from elsewhere
include/stb-master/stb_easy_font.h://      This format was chosen in the hopes it would make it
include/stb-master/stb_easy_font.h://      easier for you to reuse existing vertex-buffer-drawing code.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      If you pass in NULL for color, it becomes 255,255,255,255.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      Returns the number of quads.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      If the buffer isn't large enough, it will truncate.
include/stb-master/stb_easy_font.h://      Expect it to use an average of ~270 bytes per character.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      If your API doesn't draw quads, build a reusable index
include/stb-master/stb_easy_font.h://      list that allows you to render quads as indexed triangles.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://   void stb_easy_font_spacing(float spacing)
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      Use positive values to expand the space between characters,
include/stb-master/stb_easy_font.h://      and small negative values (no smaller than -1.5) to contract
include/stb-master/stb_easy_font.h://      the space between characters.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://      E.g. spacing = 1 adds one "pixel" of spacing between the
include/stb-master/stb_easy_font.h://      characters. spacing = -1 is reasonable but feels a bit too
include/stb-master/stb_easy_font.h://      compact to me; -0.5 is a reasonable compromise as long as
include/stb-master/stb_easy_font.h://      you're scaling the font up.
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h:// LICENSE
include/stb-master/stb_easy_font.h://
include/stb-master/stb_easy_font.h://   See end of file for license information.
