include/stb-master/stb_include.h:// find location of all #include and #inject
include/stb-master/stb_include.h:static int stb_include_find_includes(char *text, include_info **plist)
include/stb-master/stb_include.h:{
include/stb-master/stb_include.h:   int line_count = 1;
include/stb-master/stb_include.h:   int inc_count = 0;
include/stb-master/stb_include.h:   char *s = text, *start;
include/stb-master/stb_include.h:   include_info *list = NULL;
include/stb-master/stb_include.h:   while (*s) {
include/stb-master/stb_include.h:      // parse is always at start of line when we reach here
include/stb-master/stb_include.h:      start = s;
include/stb-master/stb_include.h:      while (*s == ' ' || *s == '\t')
include/stb-master/stb_include.h:         ++s;
include/stb-master/stb_include.h:      if (*s == '#') {
include/stb-master/stb_include.h:         ++s;
include/stb-master/stb_include.h:         while (*s == ' ' || *s == '\t')
include/stb-master/stb_include.h:            ++s;
include/stb-master/stb_include.h:         if (0==strncmp(s, "include", 7) && stb_include_isspace(s[7])) {
include/stb-master/stb_include.h:            s += 7;
include/stb-master/stb_include.h:            while (*s == ' ' || *s == '\t')
include/stb-master/stb_include.h:               ++s;
include/stb-master/stb_include.h:            if (*s == '"') {
include/stb-master/stb_include.h:               char *t = ++s;
include/stb-master/stb_include.h:               while (*t != '"' && *t != '\n' && *t != '\r' && *t != 0)
include/stb-master/stb_include.h:                  ++t;
include/stb-master/stb_include.h:               if (*t == '"') {
include/stb-master/stb_include.h:                  char *filename = (char *) malloc(t-s+1);
include/stb-master/stb_include.h:                  memcpy(filename, s, t-s);
include/stb-master/stb_include.h:                  filename[t-s] = 0;
include/stb-master/stb_include.h:                  s=t;
include/stb-master/stb_include.h:                  while (*s != '\r' && *s != '\n' && *s != 0)
include/stb-master/stb_include.h:                     ++s;
include/stb-master/stb_include.h:                  // s points to the newline, so s-start is everything except the newline
include/stb-master/stb_include.h:                  list = stb_include_append_include(list, inc_count++, start-text, s-text, filename, line_count+1);
include/stb-master/stb_include.h:               }
include/stb-master/stb_include.h:            }
include/stb-master/stb_include.h:         } else if (0==strncmp(s, "inject", 6) && (stb_include_isspace(s[6]) || s[6]==0)) {
include/stb-master/stb_include.h:            while (*s != '\r' && *s != '\n' && *s != 0)
include/stb-master/stb_include.h:               ++s;
include/stb-master/stb_include.h:            list = stb_include_append_include(list, inc_count++, start-text, s-text, NULL, line_count+1);
include/stb-master/stb_include.h:         }
include/stb-master/stb_include.h:      }
include/stb-master/stb_include.h:      while (*s != '\r' && *s != '\n' && *s != 0)
include/stb-master/stb_include.h:         ++s;
include/stb-master/stb_include.h:      if (*s == '\r' || *s == '\n') {
include/stb-master/stb_include.h:         s = s + (s[0] + s[1] == '\r' + '\n' ? 2 : 1);
include/stb-master/stb_include.h:      }
include/stb-master/stb_include.h:      ++line_count;
include/stb-master/stb_include.h:   }
include/stb-master/stb_include.h:   *plist = list;
include/stb-master/stb_include.h:   return inc_count;
include/stb-master/stb_include.h:}
