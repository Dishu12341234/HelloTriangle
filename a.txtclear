include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#ifdef STB_C_LEXER_IMPLEMENTATION
include/stb-master/stb_c_lexer.h:#ifndef STB_C_LEXER_DEFINITIONS
include/stb-master/stb_c_lexer.h:// to change the default parsing rules, copy the following lines
include/stb-master/stb_c_lexer.h:// into your C/C++ file *before* including this, and then replace
include/stb-master/stb_c_lexer.h:// the Y's with N's for the ones you don't want. This needs to be
include/stb-master/stb_c_lexer.h:// set to the same values for every place in your program where
include/stb-master/stb_c_lexer.h:// stb_c_lexer.h is included.
include/stb-master/stb_c_lexer.h:// --BEGIN--
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#if defined(Y) || defined(N)
include/stb-master/stb_c_lexer.h:#error "Can only use stb_c_lexer in contexts where the preprocessor symbols 'Y' and 'N' are not defined"
include/stb-master/stb_c_lexer.h:#endif
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_DECIMAL_INTS    Y   //  "0|[1-9][0-9]*"                        CLEX_intlit
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_HEX_INTS        Y   //  "0x[0-9a-fA-F]+"                       CLEX_intlit
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_OCTAL_INTS      Y   //  "[0-7]+"                               CLEX_intlit
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_DECIMAL_FLOATS  Y   //  "[0-9]*(.[0-9]*([eE][-+]?[0-9]+)?)     CLEX_floatlit
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C99_HEX_FLOATS    N   //  "0x{hex}+(.{hex}*)?[pP][-+]?{hex}+     CLEX_floatlit
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_IDENTIFIERS     Y   //  "[_a-zA-Z][_a-zA-Z0-9]*"               CLEX_id
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_DQ_STRINGS      Y   //  double-quote-delimited strings with escapes  CLEX_dqstring
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_SQ_STRINGS      N   //  single-quote-delimited strings with escapes  CLEX_ssstring
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_CHARS           Y   //  single-quote-delimited character with escape CLEX_charlits
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_COMMENTS        Y   //  "/* comment */"
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_CPP_COMMENTS      Y   //  "// comment to end of line\n"
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_COMPARISONS     Y   //  "==" CLEX_eq  "!=" CLEX_noteq   "<=" CLEX_lesseq  ">=" CLEX_greatereq
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_LOGICAL         Y   //  "&&"  CLEX_andand   "||"  CLEX_oror
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_SHIFTS          Y   //  "<<"  CLEX_shl      ">>"  CLEX_shr
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_INCREMENTS      Y   //  "++"  CLEX_plusplus "--"  CLEX_minusminus
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_ARROW           Y   //  "->"  CLEX_arrow
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_EQUAL_ARROW       N   //  "=>"  CLEX_eqarrow
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_BITWISEEQ       Y   //  "&="  CLEX_andeq    "|="  CLEX_oreq     "^="  CLEX_xoreq
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_C_ARITHEQ         Y   //  "+="  CLEX_pluseq   "-="  CLEX_minuseq
include/stb-master/stb_c_lexer.h:                                        //  "*="  CLEX_muleq    "/="  CLEX_diveq    "%=" CLEX_modeq
include/stb-master/stb_c_lexer.h:                                        //  if both STB_C_LEX_SHIFTS & STB_C_LEX_ARITHEQ:
include/stb-master/stb_c_lexer.h:                                        //                      "<<=" CLEX_shleq    ">>=" CLEX_shreq
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_PARSE_SUFFIXES    N   // letters after numbers are parsed as part of those numbers, and must be in suffix list below
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_DECIMAL_SUFFIXES  ""  // decimal integer suffixes e.g. "uUlL" -- these are returned as-is in string storage
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_HEX_SUFFIXES      ""  // e.g. "uUlL"
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_OCTAL_SUFFIXES    ""  // e.g. "uUlL"
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_FLOAT_SUFFIXES    ""  //
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_0_IS_EOF             N  // if Y, ends parsing at '\0'; if N, returns '\0' as token
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_INTEGERS_AS_DOUBLES  N  // parses integers as doubles so they can be larger than 'int', but only if STB_C_LEX_STDLIB==N
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_MULTILINE_DSTRINGS   N  // allow newlines in double-quoted strings
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_MULTILINE_SSTRINGS   N  // allow newlines in single-quoted strings
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_USE_STDLIB           Y  // use strtod,strtol for parsing #s; otherwise inaccurate hack
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_DOLLAR_IDENTIFIER    Y  // allow $ as an identifier character
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_FLOAT_NO_DECIMAL     Y  // allow floats that have no decimal point if they have an exponent
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_DEFINE_ALL_TOKEN_NAMES  N   // if Y, all CLEX_ token names are defined, even if never returned
include/stb-master/stb_c_lexer.h:                                              // leaving it as N should help you catch config bugs
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEX_DISCARD_PREPROCESSOR    Y   // discard C-preprocessor directives (e.g. after prepocess
include/stb-master/stb_c_lexer.h:                                              // still have #line, #pragma, etc)
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h://#define STB_C_LEX_ISWHITE(str)    ... // return length in bytes of whitespace characters if first char is whitespace
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:#define STB_C_LEXER_DEFINITIONS         // This line prevents the header file from replacing your definitions
include/stb-master/stb_c_lexer.h:// --END--
include/stb-master/stb_c_lexer.h:#endif
include/stb-master/stb_c_lexer.h:#endif
