include/stb-master/stb_image.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://  "baseline" JPEG/JFIF decoder
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://    simple implementation
include/stb-master/stb_image.h://      - doesn't support delayed output of y-dimension
include/stb-master/stb_image.h://      - simple interface (only one output format: 8-bit interleaved RGB)
include/stb-master/stb_image.h://      - doesn't try to recover corrupt jpegs
include/stb-master/stb_image.h://      - doesn't allow partial loading, loading multiple at once
include/stb-master/stb_image.h://      - still fast on x86 (copying globals into locals doesn't help x86)
include/stb-master/stb_image.h://      - allocates lots of intermediate memory (full size of all components)
include/stb-master/stb_image.h://        - non-interleaved case requires this anyway
include/stb-master/stb_image.h://        - allows good upsampling (see next)
include/stb-master/stb_image.h://    high-quality
include/stb-master/stb_image.h://      - upsampled channels are bilinearly interpolated, even across blocks
include/stb-master/stb_image.h://      - quality integer IDCT derived from IJG's 'slow'
include/stb-master/stb_image.h://    performance
include/stb-master/stb_image.h://      - fast huffman; reasonable integer IDCT
include/stb-master/stb_image.h://      - some SIMD kernels for common paths on targets with SSE2/NEON
include/stb-master/stb_image.h://      - uses a lot of intermediate memory, could cache poorly
