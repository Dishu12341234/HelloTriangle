include/tinyobjloader/tiny_obj_loader.h:// See
include/tinyobjloader/tiny_obj_loader.h:// http://stackoverflow.com/questions/6089231/getting-std-ifstream-to-handle-lf-cr-and-crlf
include/tinyobjloader/tiny_obj_loader.h:static std::istream &safeGetline(std::istream &is, std::string &t) {
include/tinyobjloader/tiny_obj_loader.h:  t.clear();
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  // The characters in the stream are read one-by-one using a std::streambuf.
include/tinyobjloader/tiny_obj_loader.h:  // That is faster than reading them one-by-one using the std::istream.
include/tinyobjloader/tiny_obj_loader.h:  // Code that uses streambuf this way must be guarded by a sentry object.
include/tinyobjloader/tiny_obj_loader.h:  // The sentry object performs various tasks,
include/tinyobjloader/tiny_obj_loader.h:  // such as thread synchronization and updating the stream state.
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  std::istream::sentry se(is, true);
include/tinyobjloader/tiny_obj_loader.h:  std::streambuf *sb = is.rdbuf();
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  if (se) {
include/tinyobjloader/tiny_obj_loader.h:    for (;;) {
include/tinyobjloader/tiny_obj_loader.h:      int c = sb->sbumpc();
include/tinyobjloader/tiny_obj_loader.h:      switch (c) {
include/tinyobjloader/tiny_obj_loader.h:        case '\n':
include/tinyobjloader/tiny_obj_loader.h:          return is;
include/tinyobjloader/tiny_obj_loader.h:        case '\r':
include/tinyobjloader/tiny_obj_loader.h:          if (sb->sgetc() == '\n') sb->sbumpc();
include/tinyobjloader/tiny_obj_loader.h:          return is;
include/tinyobjloader/tiny_obj_loader.h:        case EOF:
include/tinyobjloader/tiny_obj_loader.h:          // Also handle the case when the last line has no line ending
include/tinyobjloader/tiny_obj_loader.h:          if (t.empty()) is.setstate(std::ios::eofbit);
include/tinyobjloader/tiny_obj_loader.h:          return is;
include/tinyobjloader/tiny_obj_loader.h:        default:
include/tinyobjloader/tiny_obj_loader.h:          t += static_cast<char>(c);
include/tinyobjloader/tiny_obj_loader.h:      }
include/tinyobjloader/tiny_obj_loader.h:    }
include/tinyobjloader/tiny_obj_loader.h:  }
include/tinyobjloader/tiny_obj_loader.h:
include/tinyobjloader/tiny_obj_loader.h:  return is;
include/tinyobjloader/tiny_obj_loader.h:}
