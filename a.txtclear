include/stb-master/stb_image_resize2.h:// Medium-complexity API
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h:// This extends the easy-to-use API as follows:
include/stb-master/stb_image_resize2.h://
include/stb-master/stb_image_resize2.h://     * Can specify the datatype - U8, U8_SRGB, U16, FLOAT, HALF_FLOAT
include/stb-master/stb_image_resize2.h://     * Edge wrap can selected explicitly
include/stb-master/stb_image_resize2.h://     * Filter can be selected explicitly
include/stb-master/stb_image_resize2.h://--------------------------------
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:typedef enum
include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  STBIR_EDGE_CLAMP   = 0,
include/stb-master/stb_image_resize2.h:  STBIR_EDGE_REFLECT = 1,
include/stb-master/stb_image_resize2.h:  STBIR_EDGE_WRAP    = 2,  // this edge mode is slower and uses more memory
include/stb-master/stb_image_resize2.h:  STBIR_EDGE_ZERO    = 3,
include/stb-master/stb_image_resize2.h:} stbir_edge;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:typedef enum
include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_DEFAULT      = 0,  // use same filter type that easy-to-use API chooses
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_BOX          = 1,  // A trapezoid w/1-pixel wide ramps, same result as box for integer scale ratios
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_TRIANGLE     = 2,  // On upsampling, produces same results as bilinear texture filtering
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_CUBICBSPLINE = 3,  // The cubic b-spline (aka Mitchell-Netrevalli with B=1,C=0), gaussian-esque
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_CATMULLROM   = 4,  // An interpolating cubic spline
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_MITCHELL     = 5,  // Mitchell-Netrevalli filter with B=1/3, C=1/3
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_POINT_SAMPLE = 6,  // Simple point sampling
include/stb-master/stb_image_resize2.h:  STBIR_FILTER_OTHER        = 7,  // User callback specified
include/stb-master/stb_image_resize2.h:} stbir_filter;
