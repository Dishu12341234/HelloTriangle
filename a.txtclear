GameObjectPool.cxx:    // if (!mesh)
GameObjectPool.cxx:    //     return;
GameObjectPool.cxx:
GameObjectPool.cxx:    // VkBuffer vertexBuffers[] = {mesh->vertexBuffer};
GameObjectPool.cxx:    // VkDeviceSize offsets[] = {0};
GameObjectPool.cxx:    // vkCmdBindVertexBuffers(commandBuffer, 0, 1, vertexBuffers, offsets);
GameObjectPool.cxx:    // vkCmdBindIndexBuffer(commandBuffer, mesh->indexBuffer, 0, VK_INDEX_TYPE_UINT32);
GameObjectPool.cxx:
GameObjectPool.cxx:    // vkCmdBindDescriptorSets(commandBuffer, VK_PIPELINE_BIND_POINT_GRAPHICS, graphicsPipeline.pipelineLayout, 0, 1, &(descriptorSets[currentFrame]), 0, nullptr);
GameObjectPool.cxx:
GameObjectPool.cxx:    // // PushConstantC1 c1;
GameObjectPool.cxx:    // // c1.model = glm::translate(glm::mat4(1.f), glm::vec3(transform.position));
GameObjectPool.cxx:
GameObjectPool.cxx:    // // vkCmdPushConstants(commandBuffer, graphicsPipeline.pipelineLayout, VK_SHADER_STAGE_VERTEX_BIT, 0, sizeof(PushConstantC1), &c1);
GameObjectPool.cxx:
GameObjectPool.cxx:    // vkCmdDrawIndexed(commandBuffer, static_cast<uint32_t>(mesh->indices.size()), gameObjects.size(), 0, 0, 0);
GameObjectPool.cxx:}
GameObjectPool.cxx:
GameObjectPool.cxx:void GameObjectPool::reuploadAll()
GameObjectPool.cxx:{
GameObjectPool.cxx:}
GameObjectPool.cxx:
GameObjectPool.cxx:void GameObjectPool::cleanUpResources()
GameObjectPool.cxx:{
GameObjectPool.cxx:    vkDeviceWaitIdle(vkContext.device);
GameObjectPool.cxx:
GameObjectPool.cxx:    for (auto &[goid, go] : gameObjects)
GameObjectPool.cxx:    {
GameObjectPool.cxx:        if (go->mesh)
GameObjectPool.cxx:            go->mesh->destroyGPU(vkContext.device);
GameObjectPool.cxx:        go->cleanUpResources();
GameObjectPool.cxx:
GameObjectPool.cxx:        delete go;
GameObjectPool.cxx:    }
GameObjectPool.cxx:
GameObjectPool.cxx:    gameObjects.clear();
GameObjectPool.cxx:}
GameObjectPool.cxx:GameObjectPool::~GameObjectPool()
GameObjectPool.cxx:{
GameObjectPool.cxx:}
