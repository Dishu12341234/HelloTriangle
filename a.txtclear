include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// CHARACTER PROPERTIES
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF float stbtt_ScaleForPixelHeight(const stbtt_fontinfo *info, float pixels);
include/stb-master/stb_truetype.h:// computes a scale factor to produce a font whose "height" is 'pixels' tall.
include/stb-master/stb_truetype.h:// Height is measured as the distance from the highest ascender to the lowest
include/stb-master/stb_truetype.h:// descender; in other words, it's equivalent to calling stbtt_GetFontVMetrics
include/stb-master/stb_truetype.h:// and computing:
include/stb-master/stb_truetype.h://       scale = pixels / (ascent - descent)
include/stb-master/stb_truetype.h:// so if you prefer to measure height by the ascent only, use a similar calculation.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF float stbtt_ScaleForMappingEmToPixels(const stbtt_fontinfo *info, float pixels);
include/stb-master/stb_truetype.h:// computes a scale factor to produce a font whose EM size is mapped to
include/stb-master/stb_truetype.h:// 'pixels' tall. This is probably what traditional APIs compute, but
include/stb-master/stb_truetype.h:// I'm not positive.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_GetFontVMetrics(const stbtt_fontinfo *info, int *ascent, int *descent, int *lineGap);
include/stb-master/stb_truetype.h:// ascent is the coordinate above the baseline the font extends; descent
include/stb-master/stb_truetype.h:// is the coordinate below the baseline the font extends (i.e. it is typically negative)
include/stb-master/stb_truetype.h:// lineGap is the spacing between one row's descent and the next row's ascent...
include/stb-master/stb_truetype.h:// so you should advance the vertical position by "*ascent - *descent + *lineGap"
include/stb-master/stb_truetype.h://   these are expressed in unscaled coordinates, so you must multiply by
include/stb-master/stb_truetype.h://   the scale factor for a given size
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_GetFontVMetricsOS2(const stbtt_fontinfo *info, int *typoAscent, int *typoDescent, int *typoLineGap);
include/stb-master/stb_truetype.h:// analogous to GetFontVMetrics, but returns the "typographic" values from the OS/2
include/stb-master/stb_truetype.h:// table (specific to MS/Windows TTF files).
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// Returns 1 on success (table present), 0 on failure.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_GetFontBoundingBox(const stbtt_fontinfo *info, int *x0, int *y0, int *x1, int *y1);
include/stb-master/stb_truetype.h:// the bounding box around all possible characters
