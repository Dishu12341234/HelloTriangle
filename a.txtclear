include/stb-master/stb_c_lexer.h:#endif
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:extern void stb_c_lexer_init(stb_lexer *lexer, const char *input_stream, const char *input_stream_end, char *string_store, int store_length);
include/stb-master/stb_c_lexer.h:// this function initialize the 'lexer' structure
include/stb-master/stb_c_lexer.h://   Input:
include/stb-master/stb_c_lexer.h://   - input_stream points to the file to parse, loaded into memory
include/stb-master/stb_c_lexer.h://   - input_stream_end points to the end of the file, or NULL if you use 0-for-EOF
include/stb-master/stb_c_lexer.h://   - string_store is storage the lexer can use for storing parsed strings and identifiers
include/stb-master/stb_c_lexer.h://   - store_length is the length of that storage
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:extern int stb_c_lexer_get_token(stb_lexer *lexer);
include/stb-master/stb_c_lexer.h:// this function returns non-zero if a token is parsed, or 0 if at EOF
include/stb-master/stb_c_lexer.h://   Output:
include/stb-master/stb_c_lexer.h://   - lexer->token is the token ID, which is unicode code point for a single-char token, < 0 for a multichar or eof or error
include/stb-master/stb_c_lexer.h://   - lexer->real_number is a double constant value for CLEX_floatlit, or CLEX_intlit if STB_C_LEX_INTEGERS_AS_DOUBLES
include/stb-master/stb_c_lexer.h://   - lexer->int_number is an integer constant for CLEX_intlit if !STB_C_LEX_INTEGERS_AS_DOUBLES, or character for CLEX_charlit
include/stb-master/stb_c_lexer.h://   - lexer->string is a 0-terminated string for CLEX_dqstring or CLEX_sqstring or CLEX_identifier
include/stb-master/stb_c_lexer.h://   - lexer->string_len is the byte length of lexer->string
include/stb-master/stb_c_lexer.h:
include/stb-master/stb_c_lexer.h:extern void stb_c_lexer_get_location(const stb_lexer *lexer, const char *where, stb_lex_location *loc);
include/stb-master/stb_c_lexer.h:// this inefficient function returns the line number and character offset of a
include/stb-master/stb_c_lexer.h:// given location in the file as returned by stb_lex_token. Because it's inefficient,
include/stb-master/stb_c_lexer.h:// you should only call it for errors, not for every token.
include/stb-master/stb_c_lexer.h:// For error messages of invalid tokens, you typically want the location of the start
include/stb-master/stb_c_lexer.h:// of the token (which caused the token to be invalid). For bugs involving legit
include/stb-master/stb_c_lexer.h:// tokens, you can report the first or the range.
include/stb-master/stb_c_lexer.h://    Output:
include/stb-master/stb_c_lexer.h://    - loc->line_number is the line number in the file, counting from 1, of the location
include/stb-master/stb_c_lexer.h://    - loc->line_offset is the char-offset in the line, counting from 0, of the location
