include/stb-master/deprecated/stretchy_buffer.h:
include/stb-master/deprecated/stretchy_buffer.h:#define stb_sb_free(a)         ((a) ? free(stb__sbraw(a)),0 : 0)
include/stb-master/deprecated/stretchy_buffer.h:#define stb_sb_push(a,v)       (stb__sbmaybegrow(a,1), (a)[stb__sbn(a)++] = (v))
include/stb-master/deprecated/stretchy_buffer.h:#define stb_sb_count(a)        ((a) ? stb__sbn(a) : 0)
include/stb-master/deprecated/stretchy_buffer.h:#define stb_sb_add(a,n)        (stb__sbmaybegrow(a,n), stb__sbn(a)+=(n), &(a)[stb__sbn(a)-(n)])
include/stb-master/deprecated/stretchy_buffer.h:#define stb_sb_last(a)         ((a)[stb__sbn(a)-1])
include/stb-master/deprecated/stretchy_buffer.h:
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbraw(a) ((int *) (void *) (a) - 2)
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbm(a)   stb__sbraw(a)[0]
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbn(a)   stb__sbraw(a)[1]
include/stb-master/deprecated/stretchy_buffer.h:
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbneedgrow(a,n)  ((a)==0 || stb__sbn(a)+(n) >= stb__sbm(a))
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbmaybegrow(a,n) (stb__sbneedgrow(a,(n)) ? stb__sbgrow(a,n) : 0)
include/stb-master/deprecated/stretchy_buffer.h:#define stb__sbgrow(a,n)      (*((void **)&(a)) = stb__sbgrowf((a), (n), sizeof(*(a))))
include/stb-master/deprecated/stretchy_buffer.h:
