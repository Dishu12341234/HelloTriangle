include/stb-master/stb_hexwave.h:      ramp[i] = ramp[i] * (float) (halfwidth / ramp[n-1]); // ramp needs to become a slope of 1.0 after oversampling
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   // deinterleave to allow efficient interpolation e.g. w/SIMD
