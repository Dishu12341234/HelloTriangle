intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createDescriptorPool()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Descriptor Pool..." << std::endl;
intiVk.cxx:
intiVk.cxx:    std::array<VkDescriptorPoolSize, 3> poolSizes{};
intiVk.cxx:
intiVk.cxx:    // UBO
intiVk.cxx:    poolSizes[0].type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
intiVk.cxx:    poolSizes[0].descriptorCount =
intiVk.cxx:        static_cast<uint32_t>(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    // Texture
intiVk.cxx:    poolSizes[1].type = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
intiVk.cxx:    poolSizes[1].descriptorCount =
intiVk.cxx:        static_cast<uint32_t>(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    // SSBO  ← ADD THIS
intiVk.cxx:    poolSizes[2].type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
intiVk.cxx:    poolSizes[2].descriptorCount =
intiVk.cxx:        static_cast<uint32_t>(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    VkDescriptorPoolCreateInfo poolInfo{};
intiVk.cxx:    poolInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
intiVk.cxx:    poolInfo.poolSizeCount =
intiVk.cxx:        static_cast<uint32_t>(poolSizes.size());
intiVk.cxx:    poolInfo.pPoolSizes = poolSizes.data();
intiVk.cxx:    poolInfo.maxSets =
intiVk.cxx:        static_cast<uint32_t>(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    if (vkCreateDescriptorPool(device, &poolInfo, nullptr,
intiVk.cxx:                               &descriptorPool) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to create descriptor pool!");
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createDescriptorSets()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Descriptor Sets..." << std::endl;
intiVk.cxx:
intiVk.cxx:    std::vector<VkDescriptorSetLayout> layouts(MAX_FRAMES_IN_FLIGHT, descriptorSetLayout);
intiVk.cxx:
intiVk.cxx:    VkDescriptorSetAllocateInfo allocInfo{};
intiVk.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
intiVk.cxx:    allocInfo.descriptorPool = descriptorPool;
intiVk.cxx:    allocInfo.descriptorSetCount = static_cast<uint32_t>(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:    allocInfo.pSetLayouts = layouts.data();
intiVk.cxx:
intiVk.cxx:    descriptorSets.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    if (vkAllocateDescriptorSets(device, &allocInfo, descriptorSets.data()) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to allocate descriptor sets!");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
intiVk.cxx:    {
intiVk.cxx:        // ---------- UBO ----------
intiVk.cxx:        VkDescriptorBufferInfo bufferInfo{};
intiVk.cxx:        bufferInfo.buffer = uniformBuffers[i];
intiVk.cxx:        bufferInfo.offset = 0;
intiVk.cxx:        bufferInfo.range = sizeof(UniformBufferObject);
intiVk.cxx:
intiVk.cxx:        // ---------- Texture ----------
intiVk.cxx:        VkDescriptorImageInfo imageInfo{};
intiVk.cxx:        imageInfo.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
intiVk.cxx:        imageInfo.imageView = texture.textureImageView;
intiVk.cxx:        imageInfo.sampler = texture.textureSampler;
intiVk.cxx:
intiVk.cxx:        // ---------- SSBO ----------
intiVk.cxx:        VkDescriptorBufferInfo ssboInfo{};
intiVk.cxx:        ssboInfo.buffer = ssboBuffers[i];
intiVk.cxx:        ssboInfo.offset = 0;
intiVk.cxx:        ssboInfo.range = sizeof(ObjectData) * MAX_OBJS;
intiVk.cxx:
intiVk.cxx:        std::array<VkWriteDescriptorSet, 3> descriptorWrites{};
intiVk.cxx:
intiVk.cxx:        // Binding 0 - UBO
intiVk.cxx:        descriptorWrites[0].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
intiVk.cxx:        descriptorWrites[0].dstSet = descriptorSets[i];
intiVk.cxx:        descriptorWrites[0].dstBinding = 0;
intiVk.cxx:        descriptorWrites[0].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
intiVk.cxx:        descriptorWrites[0].descriptorCount = 1;
intiVk.cxx:        descriptorWrites[0].pBufferInfo = &bufferInfo;
intiVk.cxx:
intiVk.cxx:        // Binding 1 - Texture
intiVk.cxx:        descriptorWrites[1].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
intiVk.cxx:        descriptorWrites[1].dstSet = descriptorSets[i];
intiVk.cxx:        descriptorWrites[1].dstBinding = 1;
intiVk.cxx:        descriptorWrites[1].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
intiVk.cxx:        descriptorWrites[1].descriptorCount = 1;
intiVk.cxx:        descriptorWrites[1].pImageInfo = &imageInfo;
intiVk.cxx:
intiVk.cxx:        // Binding 2 - SSBO
intiVk.cxx:        descriptorWrites[2].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
intiVk.cxx:        descriptorWrites[2].dstSet = descriptorSets[i];
intiVk.cxx:        descriptorWrites[2].dstBinding = 2;
intiVk.cxx:        descriptorWrites[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
intiVk.cxx:        descriptorWrites[2].descriptorCount = 1;
intiVk.cxx:        descriptorWrites[2].pBufferInfo = &ssboInfo;
intiVk.cxx:
intiVk.cxx:        vkUpdateDescriptorSets(
intiVk.cxx:            device,
intiVk.cxx:            static_cast<uint32_t>(descriptorWrites.size()),
intiVk.cxx:            descriptorWrites.data(),
intiVk.cxx:            0,
intiVk.cxx:            nullptr);
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Memory trasnfer opertation are done using command buffer just like drawing
intiVk.cxx:void HelloTriangleApplication::copyBuffer(VkBuffer srcBuffer, VkBuffer dstBuffer, VkDeviceSize size)
intiVk.cxx:{
intiVk.cxx:    VkCommandBuffer commandBuffer = beginSingleTimeCommands();
intiVk.cxx:
intiVk.cxx:    VkBufferCopy copyRegion{};
intiVk.cxx:    copyRegion.size = size;
intiVk.cxx:    vkCmdCopyBuffer(commandBuffer, srcBuffer, dstBuffer, 1, &copyRegion);
intiVk.cxx:
intiVk.cxx:    endSingleTimeCommands(commandBuffer);
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:uint32_t HelloTriangleApplication::findMemoryType(uint32_t typeFilter, VkMemoryPropertyFlags properties)
intiVk.cxx:{
intiVk.cxx:    VkPhysicalDeviceMemoryProperties memProperties;
intiVk.cxx:    vkGetPhysicalDeviceMemoryProperties(physicalDevice, &memProperties);
intiVk.cxx:
intiVk.cxx:    for (uint32_t i = 0; i < memProperties.memoryTypeCount; i++)
intiVk.cxx:    {
intiVk.cxx:        if ((typeFilter & (1 << i)) && (memProperties.memoryTypes[i].propertyFlags & properties) == properties)
intiVk.cxx:        {
intiVk.cxx:            return i;
intiVk.cxx:        }
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    throw std::runtime_error("failed to find suitable memory type!");
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// A command buffer is a queue of commands to send to the GPU
intiVk.cxx:void HelloTriangleApplication::createCommandBuffers()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Command Buffers..." << std::endl;
intiVk.cxx:
intiVk.cxx:    commandBuffers.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    VkCommandBufferAllocateInfo allocInfo{};
intiVk.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
intiVk.cxx:    allocInfo.commandPool = commandPool;
intiVk.cxx:    allocInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
intiVk.cxx:    allocInfo.commandBufferCount = (uint32_t)commandBuffers.size();
intiVk.cxx:
intiVk.cxx:    if (vkAllocateCommandBuffers(device, &allocInfo, commandBuffers.data()) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to allocate command buffers");
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::recordCommandBuffer(VkCommandBuffer commandBuffer, uint32_t imageIndex)
intiVk.cxx:{
intiVk.cxx:    VkCommandBufferBeginInfo beginInfo{};
intiVk.cxx:    beginInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
intiVk.cxx:    beginInfo.flags = 0;
intiVk.cxx:    beginInfo.pInheritanceInfo = nullptr;
intiVk.cxx:
intiVk.cxx:    if (vkBeginCommandBuffer(commandBuffer, &beginInfo) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to begin recording command buffer!");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    VkRenderPassBeginInfo renderPassInfo{};
intiVk.cxx:    renderPassInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
intiVk.cxx:    renderPassInfo.renderPass = renderPass;
intiVk.cxx:    renderPassInfo.framebuffer = swapChainFramebuffers[imageIndex];
intiVk.cxx:
intiVk.cxx:    renderPassInfo.renderArea.offset = {0, 0};
intiVk.cxx:    renderPassInfo.renderArea.extent = swapChainExtent;
intiVk.cxx:
intiVk.cxx:    std::array<VkClearValue, 2> clearValues{};
intiVk.cxx:    clearValues[0].color = {{0.01f, 0.16f, 0.3f, 1.0f}};
intiVk.cxx:    clearValues[1].depthStencil = {1.0f, 0};
intiVk.cxx:
intiVk.cxx:    renderPassInfo.clearValueCount = static_cast<uint32_t>(clearValues.size());
intiVk.cxx:    renderPassInfo.pClearValues = clearValues.data();
intiVk.cxx:
intiVk.cxx:    vkCmdBeginRenderPass(commandBuffer, &renderPassInfo, VK_SUBPASS_CONTENTS_INLINE);
intiVk.cxx:
intiVk.cxx:    vkCmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_GRAPHICS, graphicsPipeline.graphicsPipeline);
intiVk.cxx:
intiVk.cxx:    gameObjectPool.drawIndexed(commandBuffer, descriptorSets, graphicsPipeline, swapChainExtent, 1, currentFrame);
intiVk.cxx:
intiVk.cxx:    vkCmdEndRenderPass(commandBuffer);
intiVk.cxx:
intiVk.cxx:    if (vkEndCommandBuffer(commandBuffer) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to record command buffer!");
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createSyncObject()
intiVk.cxx:{
intiVk.cxx:    // 1️⃣ Per-frame semaphores for acquiring images
intiVk.cxx:    imageAvailableSemaphores.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    // 2️⃣ Per-swapchain-image semaphores for rendering completion
intiVk.cxx:    renderFinishedSemaphores.resize(swapChainImages.size());
intiVk.cxx:
intiVk.cxx:    // 3️⃣ Fences to limit frames in flight
intiVk.cxx:    inFlightFences.resize(MAX_FRAMES_IN_FLIGHT);
intiVk.cxx:
intiVk.cxx:    VkSemaphoreCreateInfo semaphoreInfo{};
intiVk.cxx:    semaphoreInfo.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
intiVk.cxx:
intiVk.cxx:    VkFenceCreateInfo fenceInfo{};
intiVk.cxx:    fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
intiVk.cxx:    fenceInfo.flags = VK_FENCE_CREATE_SIGNALED_BIT; // start signaled
intiVk.cxx:
intiVk.cxx:    // Create per-frame semaphores and fences
intiVk.cxx:    for (size_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
intiVk.cxx:    {
intiVk.cxx:        if (vkCreateSemaphore(device, &semaphoreInfo, nullptr, &imageAvailableSemaphores[i]) != VK_SUCCESS ||
intiVk.cxx:            vkCreateFence(device, &fenceInfo, nullptr, &inFlightFences[i]) != VK_SUCCESS)
intiVk.cxx:        {
intiVk.cxx:            throw std::runtime_error("failed to create semaphore or fence!");
intiVk.cxx:        }
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // Create per-swapchain-image render-finished semaphores
intiVk.cxx:    for (size_t i = 0; i < swapChainImages.size(); i++)
intiVk.cxx:    {
intiVk.cxx:        if (vkCreateSemaphore(device, &semaphoreInfo, nullptr, &renderFinishedSemaphores[i]) != VK_SUCCESS)
intiVk.cxx:        {
intiVk.cxx:            throw std::runtime_error("failed to create renderFinished semaphore!");
intiVk.cxx:        }
intiVk.cxx:    }
intiVk.cxx:}
