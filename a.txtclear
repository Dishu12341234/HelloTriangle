include/stb-master/stb_truetype.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// CHARACTER TO GLYPH-INDEX CONVERSIOn
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int stbtt_FindGlyphIndex(const stbtt_fontinfo *info, int unicode_codepoint);
include/stb-master/stb_truetype.h:// If you're going to perform multiple operations on the same character
include/stb-master/stb_truetype.h:// and you want a speed-up, call this function with the character you're
include/stb-master/stb_truetype.h:// going to process, then use glyph-based functions instead of the
include/stb-master/stb_truetype.h:// codepoint-based functions.
include/stb-master/stb_truetype.h:// Returns 0 if the character codepoint is not defined in the font.
