include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_TYPE_none,
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_TYPE_sampler,
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_TYPE_vec2,
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_TYPE_vec3,
include/stb-master/stb_voxel_render.h:   STBVOX_UNIFORM_TYPE_vec4,
include/stb-master/stb_voxel_render.h:};
