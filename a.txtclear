include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:extern stbte_tilemap *stbte_create_map(int map_x, int map_y, int map_layers, int spacing_x, int spacing_y, int max_tiles);
include/stb-master/stb_tilemap_editor.h:// create an editable tilemap
include/stb-master/stb_tilemap_editor.h://   map_x      : dimensions of map horizontally (user can change this in editor), <= STBTE_MAX_TILEMAP_X
include/stb-master/stb_tilemap_editor.h://   map_y      : dimensions of map vertically (user can change this in editor)    <= STBTE_MAX_TILEMAP_Y
include/stb-master/stb_tilemap_editor.h://   map_layers : number of layers to use (fixed), <= STBTE_MAX_LAYERS
include/stb-master/stb_tilemap_editor.h://   spacing_x  : initial horizontal distance between left edges of map tiles in stb_tilemap_editor pixels
include/stb-master/stb_tilemap_editor.h://   spacing_y  : initial vertical distance between top edges of map tiles in stb_tilemap_editor pixels
include/stb-master/stb_tilemap_editor.h://   max_tiles  : maximum number of tiles that can defined
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// If insufficient memory, returns NULL
include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:extern void stbte_define_tile(stbte_tilemap *tm, unsigned short id, unsigned int layermask, const char * category);
include/stb-master/stb_tilemap_editor.h:// call this repeatedly for each tile to install the tile definitions into the editable tilemap
include/stb-master/stb_tilemap_editor.h://   tm        : tilemap created by stbte_create_map
include/stb-master/stb_tilemap_editor.h://   id        : unique identifier for each tile, 0 <= id < 32768
include/stb-master/stb_tilemap_editor.h://   layermask : bitmask of which layers tile is allowed on: 1 = layer 0, 255 = layers 0..7
include/stb-master/stb_tilemap_editor.h://               (note that onscreen, the editor numbers the layers from 1 not 0)
include/stb-master/stb_tilemap_editor.h://               layer 0 is the furthest back, layer 1 is just in front of layer 0, etc
include/stb-master/stb_tilemap_editor.h://   category  : which category this tile is grouped in
