include/stb-master/stb_divide.h:// Three kinds of divide/modulus of signed integers.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// HISTORY
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://   v0.94              Fix integer overflow issues
include/stb-master/stb_divide.h://   v0.93  2020-02-02  Write useful exit() value from main()
include/stb-master/stb_divide.h://   v0.92  2019-02-25  Fix warning
include/stb-master/stb_divide.h://   v0.91  2010-02-27  Fix euclidean division by INT_MIN for non-truncating C
include/stb-master/stb_divide.h://                      Check result with 64-bit math to catch such cases
include/stb-master/stb_divide.h://   v0.90  2010-02-24  First public release
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// USAGE
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// In *ONE* source file, put:
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://    #define STB_DIVIDE_IMPLEMENTATION
include/stb-master/stb_divide.h://    // #define C_INTEGER_DIVISION_TRUNCATES  // see Note 1
include/stb-master/stb_divide.h://    // #define C_INTEGER_DIVISION_FLOORS     // see Note 2
include/stb-master/stb_divide.h://    #include "stb_divide.h"
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Other source files should just include stb_divide.h
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Note 1: On platforms/compilers that you know signed C division
include/stb-master/stb_divide.h:// truncates, you can #define C_INTEGER_DIVISION_TRUNCATES.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Note 2: On platforms/compilers that you know signed C division
include/stb-master/stb_divide.h:// floors (rounds to negative infinity), you can #define
include/stb-master/stb_divide.h:// C_INTEGER_DIVISION_FLOORS.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// You can #define STB_DIVIDE_TEST in which case the implementation
include/stb-master/stb_divide.h:// will generate a main() and compiling the result will create a
include/stb-master/stb_divide.h:// program that tests the implementation. Run it with no arguments
include/stb-master/stb_divide.h:// and any output indicates an error; run it with any argument and
include/stb-master/stb_divide.h:// it will also print the test results. Define STB_DIVIDE_TEST_64
include/stb-master/stb_divide.h:// to a 64-bit integer type to avoid overflows in the result-checking
include/stb-master/stb_divide.h:// which give false negatives.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// ABOUT
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// This file provides three different consistent divide/mod pairs
include/stb-master/stb_divide.h:// implemented on top of arbitrary C/C++ division, including correct
include/stb-master/stb_divide.h:// handling of overflow of intermediate calculations:
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://     trunc:   a/b truncates to 0,           a%b has same sign as a
include/stb-master/stb_divide.h://     floor:   a/b truncates to -inf,        a%b has same sign as b
include/stb-master/stb_divide.h://     eucl:    a/b truncates to sign(b)*inf, a%b is non-negative
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Not necessarily optimal; I tried to keep it generally efficient,
include/stb-master/stb_divide.h:// but there may be better ways.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Briefly, for those who are not familiar with the problem, we note
include/stb-master/stb_divide.h:// the reason these divides exist and are interesting:
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://     'trunc' is easy to implement in hardware (strip the signs,
include/stb-master/stb_divide.h://          compute, reapply the signs), thus is commonly defined
include/stb-master/stb_divide.h://          by many languages (including C99)
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://     'floor' is simple to define and better behaved than trunc;
include/stb-master/stb_divide.h://          for example it divides integers into fixed-size buckets
include/stb-master/stb_divide.h://          without an extra-wide bucket at 0, and for a fixed
include/stb-master/stb_divide.h://          divisor N there are only |N| possible moduli.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://     'eucl' guarantees fixed-sized buckets *and* a non-negative
include/stb-master/stb_divide.h://          modulus and defines division to be whatever is needed
include/stb-master/stb_divide.h://          to achieve that result.
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// See "The Euclidean definition of the functions div and mod"
include/stb-master/stb_divide.h:// by Raymond Boute (1992), or "Division and Modulus for Computer
include/stb-master/stb_divide.h:// Scientists" by Daan Leijen (2001)
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// We assume of the built-in C division:
include/stb-master/stb_divide.h://     (a) modulus is the remainder for the corresponding division
include/stb-master/stb_divide.h://     (b) a/b truncates if a and b are the same sign
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// Property (a) requires (a/b)*b + (a%b)==a, and is required by C.
include/stb-master/stb_divide.h:// Property (b) seems to be true of all hardware but is *not* satisfied
include/stb-master/stb_divide.h:// by the euclidean division operator we define, so it's possibly not
include/stb-master/stb_divide.h:// always true. If any such platform turns up, we can add more cases.
include/stb-master/stb_divide.h:// (Possibly only stb_div_trunc currently relies on property (b).)
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h:// LICENSE
include/stb-master/stb_divide.h://
include/stb-master/stb_divide.h://   See end of file for license information.
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifndef INCLUDE_STB_DIVIDE_H
include/stb-master/stb_divide.h:#define INCLUDE_STB_DIVIDE_H
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifdef __cplusplus
include/stb-master/stb_divide.h:extern "C" {
include/stb-master/stb_divide.h:#endif
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:extern int stb_div_trunc(int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:extern int stb_div_floor(int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:extern int stb_div_eucl (int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:extern int stb_mod_trunc(int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:extern int stb_mod_floor(int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:extern int stb_mod_eucl (int value_to_be_divided, int value_to_divide_by);
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifdef __cplusplus
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:#endif
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifdef STB_DIVIDE_IMPLEMENTATION
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#if defined(__STDC_VERSION) && __STDC_VERSION__ >= 19901
include/stb-master/stb_divide.h:   #ifndef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:      #define C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:#endif
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifndef INT_MIN
include/stb-master/stb_divide.h:#include <limits.h> // if you have no limits.h, #define INT_MIN yourself
include/stb-master/stb_divide.h:#endif
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:// the following macros are designed to allow testing
include/stb-master/stb_divide.h:// other platforms by simulating them
include/stb-master/stb_divide.h:#ifndef STB_DIVIDE_TEST_FLOOR
include/stb-master/stb_divide.h:   #define stb__div(a,b)  ((a)/(b))
include/stb-master/stb_divide.h:   #define stb__mod(a,b)  ((a)%(b))
include/stb-master/stb_divide.h:#else
include/stb-master/stb_divide.h:   // implement floor-style divide on trunc platform
include/stb-master/stb_divide.h:   #ifndef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   #error "floor test requires truncating division"
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:   #undef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   int stb__div(int v1, int v2)
include/stb-master/stb_divide.h:   {
include/stb-master/stb_divide.h:      int q = v1/v2, r = v1%v2;
include/stb-master/stb_divide.h:      if ((r > 0 && v2 < 0) || (r < 0 && v2 > 0))
include/stb-master/stb_divide.h:         return q-1;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return q;
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:   int stb__mod(int v1, int v2)
include/stb-master/stb_divide.h:   {
include/stb-master/stb_divide.h:      int r = v1%v2;
include/stb-master/stb_divide.h:      if ((r > 0 && v2 < 0) || (r < 0 && v2 > 0))
include/stb-master/stb_divide.h:         return r+v2;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return r;
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:#endif
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_div_trunc(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   #ifdef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   return v1/v2;
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   if (v1 >= 0 && v2 <= 0)
include/stb-master/stb_divide.h:      return -stb__div(-v1,v2);  // both negative to avoid overflow
include/stb-master/stb_divide.h:   if (v1 <= 0 && v2 >= 0)
include/stb-master/stb_divide.h:      if (v1 != INT_MIN)
include/stb-master/stb_divide.h:         return -stb__div(v1,-v2);    // both negative to avoid overflow
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return -stb__div(v1+v2,-v2)-1; // push v1 away from wrap point
include/stb-master/stb_divide.h:   else
include/stb-master/stb_divide.h:      return v1/v2;            // same sign, so expect truncation
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_div_floor(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   #ifdef C_INTEGER_DIVISION_FLOORS
include/stb-master/stb_divide.h:   return v1/v2;
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   if (v1 >= 0 && v2 < 0) {
include/stb-master/stb_divide.h:      if (v2 + 1 >= INT_MIN + v1) // check if increasing v1's magnitude overflows
include/stb-master/stb_divide.h:         return -stb__div((v2+1)-v1,v2); // nope, so just compute it
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return -stb__div(-v1,v2) + ((-v1)%v2 ? -1 : 0);
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:   if (v1 < 0 && v2 >= 0) {
include/stb-master/stb_divide.h:      if (v1 != INT_MIN) {
include/stb-master/stb_divide.h:         if (v1 + 1 >= INT_MIN + v2) // check if increasing v1's magnitude overflows
include/stb-master/stb_divide.h:            return -stb__div((v1+1)-v2,-v2); // nope, so just compute it
include/stb-master/stb_divide.h:         else
include/stb-master/stb_divide.h:            return -stb__div(-v1,v2) + (stb__mod(v1,-v2) ? -1 : 0);
include/stb-master/stb_divide.h:      } else // it must be possible to compute -(v1+v2) without overflowing
include/stb-master/stb_divide.h:         return -stb__div(-(v1+v2),v2) + (stb__mod(-(v1+v2),v2) ? -2 : -1);
include/stb-master/stb_divide.h:   } else
include/stb-master/stb_divide.h:      return v1/v2;           // same sign, so expect truncation
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_div_eucl(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   int q,r;
include/stb-master/stb_divide.h:   #ifdef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   q = v1/v2;
include/stb-master/stb_divide.h:   r = v1%v2;
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   // handle every quadrant separately, since we can't rely on q and r flor
include/stb-master/stb_divide.h:   if (v1 >= 0)
include/stb-master/stb_divide.h:      if (v2 >= 0)
include/stb-master/stb_divide.h:         return stb__div(v1,v2);
include/stb-master/stb_divide.h:      else if (v2 != INT_MIN)
include/stb-master/stb_divide.h:         q = -stb__div(v1,-v2), r = stb__mod(v1,-v2);
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         q = 0, r = v1;
include/stb-master/stb_divide.h:   else if (v1 != INT_MIN)
include/stb-master/stb_divide.h:      if (v2 >= 0)
include/stb-master/stb_divide.h:         q = -stb__div(-v1,v2), r = -stb__mod(-v1,v2);
include/stb-master/stb_divide.h:      else if (v2 != INT_MIN)
include/stb-master/stb_divide.h:         q = stb__div(-v1,-v2), r = -stb__mod(-v1,-v2);
include/stb-master/stb_divide.h:      else // if v2 is INT_MIN, then we can't use -v2, but we can't divide by v2
include/stb-master/stb_divide.h:         q = 1, r = v1-q*v2;
include/stb-master/stb_divide.h:   else // if v1 is INT_MIN, we have to move away from overflow place
include/stb-master/stb_divide.h:      if (v2 >= 0)
include/stb-master/stb_divide.h:         q = -stb__div(-(v1+v2),v2)-1, r = -stb__mod(-(v1+v2),v2);
include/stb-master/stb_divide.h:      else if (v2 != INT_MIN)
include/stb-master/stb_divide.h:         q = stb__div(-(v1-v2),-v2)+1, r = -stb__mod(-(v1-v2),-v2);
include/stb-master/stb_divide.h:      else // for INT_MIN / INT_MIN, we need to be extra-careful to avoid overflow
include/stb-master/stb_divide.h:         q = 1, r = 0;
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:   if (r >= 0)
include/stb-master/stb_divide.h:      return q;
include/stb-master/stb_divide.h:   else
include/stb-master/stb_divide.h:      return q + (v2 > 0 ? -1 : 1);
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_mod_trunc(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   #ifdef C_INTEGER_DIVISION_TRUNCATES
include/stb-master/stb_divide.h:   return v1%v2;
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   if (v1 >= 0) { // modulus result should always be positive
include/stb-master/stb_divide.h:      int r = stb__mod(v1,v2);
include/stb-master/stb_divide.h:      if (r >= 0)
include/stb-master/stb_divide.h:         return r;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return r - (v2 < 0 ? v2 : -v2);
include/stb-master/stb_divide.h:   } else {    // modulus result should always be negative
include/stb-master/stb_divide.h:      int r = stb__mod(v1,v2);
include/stb-master/stb_divide.h:      if (r <= 0)
include/stb-master/stb_divide.h:         return r;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return r + (v2 < 0 ? v2 : -v2);
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_mod_floor(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   #ifdef C_INTEGER_DIVISION_FLOORS
include/stb-master/stb_divide.h:   return v1%v2;
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   if (v2 >= 0) { // result should always be positive
include/stb-master/stb_divide.h:      int r = stb__mod(v1,v2);
include/stb-master/stb_divide.h:      if (r >= 0)
include/stb-master/stb_divide.h:         return r;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return r + v2;
include/stb-master/stb_divide.h:   } else { // result should always be negative
include/stb-master/stb_divide.h:      int r = stb__mod(v1,v2);
include/stb-master/stb_divide.h:      if (r <= 0)
include/stb-master/stb_divide.h:         return r;
include/stb-master/stb_divide.h:      else
include/stb-master/stb_divide.h:         return r + v2;
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int stb_mod_eucl(int v1, int v2)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   int r = stb__mod(v1,v2);
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:   if (r >= 0)
include/stb-master/stb_divide.h:      return r;
include/stb-master/stb_divide.h:   else
include/stb-master/stb_divide.h:      return r - (v2 < 0 ? v2 : -v2); // negative abs() [to avoid overflow]
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:#ifdef STB_DIVIDE_TEST
include/stb-master/stb_divide.h:#include <stdio.h>
include/stb-master/stb_divide.h:#include <math.h>
include/stb-master/stb_divide.h:#include <limits.h>
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:int show=0;
include/stb-master/stb_divide.h:int err=0;
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:void stbdiv_check(int q, int r, int a, int b, char *type, int dir)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   if ((dir > 0 && r < 0) || (dir < 0 && r > 0)) {
include/stb-master/stb_divide.h:      fprintf(stderr, "FAILED: %s(%d,%d) remainder %d in wrong direction\n", type,a,b,r);
include/stb-master/stb_divide.h:      err++;
include/stb-master/stb_divide.h:   } else
include/stb-master/stb_divide.h:      if (b != INT_MIN) // can't compute abs(), but if b==INT_MIN all remainders are valid
include/stb-master/stb_divide.h:         if (r <= -abs(b) || r >= abs(b)) {
include/stb-master/stb_divide.h:            fprintf(stderr, "FAILED: %s(%d,%d) remainder %d out of range\n", type,a,b,r);
include/stb-master/stb_divide.h:            err++;
include/stb-master/stb_divide.h:         }
include/stb-master/stb_divide.h:   #ifdef STB_DIVIDE_TEST_64
include/stb-master/stb_divide.h:   {
include/stb-master/stb_divide.h:      STB_DIVIDE_TEST_64 q64 = q, r64=r, a64=a, b64=b;
include/stb-master/stb_divide.h:      if (q64*b64+r64 != a64) {
include/stb-master/stb_divide.h:         fprintf(stderr, "FAILED: %s(%d,%d) remainder %d doesn't match quotient %d\n", type,a,b,r,q);
include/stb-master/stb_divide.h:         err++;
include/stb-master/stb_divide.h:      }
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:   #else
include/stb-master/stb_divide.h:   if (q*b+r != a) {
include/stb-master/stb_divide.h:      fprintf(stderr, "FAILED: %s(%d,%d) remainder %d doesn't match quotient %d\n", type,a,b,r,q);
include/stb-master/stb_divide.h:      err++;
include/stb-master/stb_divide.h:   }
include/stb-master/stb_divide.h:   #endif
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:void test(int a, int b)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   int q,r;
include/stb-master/stb_divide.h:   if (show) printf("(%+11d,%+d) |  ", a,b);
include/stb-master/stb_divide.h:   q = stb_div_trunc(a,b), r = stb_mod_trunc(a,b);
include/stb-master/stb_divide.h:   if (show) printf("(%+11d,%+2d)  ", q,r); stbdiv_check(q,r,a,b, "trunc",a);
include/stb-master/stb_divide.h:   q = stb_div_floor(a,b), r = stb_mod_floor(a,b);
include/stb-master/stb_divide.h:   if (show) printf("(%+11d,%+2d)  ", q,r); stbdiv_check(q,r,a,b, "floor",b);
include/stb-master/stb_divide.h:   q = stb_div_eucl (a,b), r = stb_mod_eucl (a,b);
include/stb-master/stb_divide.h:   if (show) printf("(%+11d,%+2d)\n", q,r); stbdiv_check(q,r,a,b, "euclidean",1);
include/stb-master/stb_divide.h:}
include/stb-master/stb_divide.h:
include/stb-master/stb_divide.h:void testh(int a, int b)
include/stb-master/stb_divide.h:{
include/stb-master/stb_divide.h:   int q,r;
include/stb-master/stb_divide.h:   if (show) printf("(%08x,%08x) |\n", a,b);
include/stb-master/stb_divide.h:   q = stb_div_trunc(a,b), r = stb_mod_trunc(a,b); stbdiv_check(q,r,a,b, "trunc",a);
include/stb-master/stb_divide.h:   if (show) printf("             (%08x,%08x)", q,r);
include/stb-master/stb_divide.h:   q = stb_div_floor(a,b), r = stb_mod_floor(a,b); stbdiv_check(q,r,a,b, "floor",b);
include/stb-master/stb_divide.h:   if (show) printf("   (%08x,%08x)", q,r);
include/stb-master/stb_divide.h:   q = stb_div_eucl (a,b), r = stb_mod_eucl (a,b); stbdiv_check(q,r,a,b, "euclidean",1);
include/stb-master/stb_divide.h:   if (show) printf("   (%08x,%08x)\n ", q,r);
include/stb-master/stb_divide.h:}
