include/stb-master/stb_hexwave.h:   vert[0].v = 0;
include/stb-master/stb_hexwave.h:   vert[1].t = hex->current.zero_wait*0.5f;
include/stb-master/stb_hexwave.h:   vert[1].v = 0;
include/stb-master/stb_hexwave.h:   vert[2].t = 0.5f*hex->current.peak_time + vert[1].t*(1-hex->current.peak_time);
include/stb-master/stb_hexwave.h:   vert[2].v = 1;
include/stb-master/stb_hexwave.h:   vert[3].t = 0.5f;
include/stb-master/stb_hexwave.h:   vert[3].v = hex->current.half_height;
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   if (hex->current.reflect) {
include/stb-master/stb_hexwave.h:      for (j=4; j <= 7; ++j) {
include/stb-master/stb_hexwave.h:         vert[j].t = 1 -  vert[7-j].t;
include/stb-master/stb_hexwave.h:         vert[j].v =    - vert[7-j].v;
include/stb-master/stb_hexwave.h:      }
include/stb-master/stb_hexwave.h:   } else {
include/stb-master/stb_hexwave.h:      for (j=4; j <= 7; ++j) {
include/stb-master/stb_hexwave.h:         vert[j].t =  0.5f +  vert[j-4].t;
include/stb-master/stb_hexwave.h:         vert[j].v =        - vert[j-4].v;
include/stb-master/stb_hexwave.h:      }
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:   vert[8].t = 1;
include/stb-master/stb_hexwave.h:   vert[8].v = 0;
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   for (j=0; j < 8; ++j) {
include/stb-master/stb_hexwave.h:      if (vert[j+1].t <= vert[j].t + min_len) {
include/stb-master/stb_hexwave.h:          // if change takes place over less than a fraction of a sample treat as discontinuity
include/stb-master/stb_hexwave.h:          //
include/stb-master/stb_hexwave.h:          // otherwise the slope computation can blow up to arbitrarily large and we
include/stb-master/stb_hexwave.h:          // try to generate a huge BLAMP and the result is wrong.
include/stb-master/stb_hexwave.h:          // 
include/stb-master/stb_hexwave.h:          // why does this happen if the math is right? i believe if done perfectly,
include/stb-master/stb_hexwave.h:          // the two BLAMPs on either side of the slope would cancel out, but our
include/stb-master/stb_hexwave.h:          // BLAMPs have only limited sub-sample precision and limited integration
include/stb-master/stb_hexwave.h:          // accuracy. or maybe it's just the math blowing up w/ floating point precision
include/stb-master/stb_hexwave.h:          // limits as we try to make x * (1/x) cancel out
include/stb-master/stb_hexwave.h:          //
include/stb-master/stb_hexwave.h:          // min_len verified artifact-free even near nyquist with only oversample=4
include/stb-master/stb_hexwave.h:         vert[j+1].t = vert[j].t;
