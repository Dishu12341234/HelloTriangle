include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:// this table indicates whether, for each pair of types above, a face is visible.
include/stb-master/stb_voxel_render.h:// each value indicates whether a given type is visible for all neighbor types
include/stb-master/stb_voxel_render.h:static unsigned short stbvox_face_visible[STBVOX_FT_count] =
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   // we encode the table by listing which cases cause *obscuration*, and bitwise inverting that
include/stb-master/stb_voxel_render.h:   // table is pre-shifted by 5 to save a shift when it's accessed
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~0x07ffu                                          )<<5),  // none is completely obscured by everything
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_upper)   ))<<5),  // upper
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_lower)   ))<<5),  // lower
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid)                          ))<<5),  // solid is only completely obscured only by solid
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_diag_013)))<<5),  // diag012 matches diag013
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_diag_123)))<<5),  // diag023 matches diag123
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_diag_012)))<<5),  // diag013 matches diag012
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid) | (1<<STBVOX_FT_diag_023)))<<5),  // diag123 matches diag023
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~0u                                               )<<5),  // force is always rendered regardless, always forces neighbor
include/stb-master/stb_voxel_render.h:   (unsigned short) ((~((1u<<STBVOX_FT_solid)                          ))<<5),  // partial is only completely obscured only by solid
include/stb-master/stb_voxel_render.h:};
