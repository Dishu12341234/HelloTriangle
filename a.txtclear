include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   if (user_buffer == 0) {
include/stb-master/stb_hexwave.h:      #ifndef STB_HEXWAVE_NO_ALLOCATION
include/stb-master/stb_hexwave.h:      blep_buffer  = (float *) malloc(sizeof(float)*blep_buffer_count);
include/stb-master/stb_hexwave.h:      blamp_buffer = (float *) malloc(sizeof(float)*blep_buffer_count);
include/stb-master/stb_hexwave.h:      #endif
include/stb-master/stb_hexwave.h:   } else {
include/stb-master/stb_hexwave.h:      blep_buffer  = ramp+n;
include/stb-master/stb_hexwave.h:      blamp_buffer = blep_buffer + blep_buffer_count;
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   // compute BLEP and BLAMP by integerating windowed sinc
include/stb-master/stb_hexwave.h:   for (i=0; i < n; ++i) {
include/stb-master/stb_hexwave.h:      for (j=0; j < 16; ++j) {
include/stb-master/stb_hexwave.h:         float sinc_t = 3.141592f* (i-half) / oversample;
include/stb-master/stb_hexwave.h:         float sinc   = (i==half) ? 1.0f : (float) sin(sinc_t) / (sinc_t);
include/stb-master/stb_hexwave.h:         float wt     = 2.0f*3.1415926f * i / (n-1);
include/stb-master/stb_hexwave.h:         float window = (float) (0.355768 - 0.487396*cos(wt) + 0.144232*cos(2*wt) - 0.012604*cos(3*wt)); // Nuttall
include/stb-master/stb_hexwave.h:         double value       =         window * sinc;
include/stb-master/stb_hexwave.h:         integrate_impulse +=         value/16;
include/stb-master/stb_hexwave.h:         integrate_step    +=         integrate_impulse/16;
include/stb-master/stb_hexwave.h:      }
include/stb-master/stb_hexwave.h:      step[i]            = (float) integrate_impulse;
include/stb-master/stb_hexwave.h:      ramp[i]            = (float) integrate_step;
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   // renormalize
include/stb-master/stb_hexwave.h:   for (i=0; i < n; ++i) {
