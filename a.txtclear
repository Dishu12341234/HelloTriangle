include/stb-master/stb_hexwave.h:         blamp_buffer[j*width+i] = ramp[j+i*oversample];
include/stb-master/stb_hexwave.h:      }
include/stb-master/stb_hexwave.h:   }
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   // subtract out the naive waveform; note we can't do this to the raw data
include/stb-master/stb_hexwave.h:   // above, because we want the discontinuity to be in a different locations
include/stb-master/stb_hexwave.h:   // for j=0 and j=oversample (which exists to provide something to interpolate against)
