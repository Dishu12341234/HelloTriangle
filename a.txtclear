include/stb-master/stb_truetype.h:      }
include/stb-master/stb_truetype.h:      /* now p[m] is the median-of-three */
include/stb-master/stb_truetype.h:      /* swap it to the beginning so it won't move around */
include/stb-master/stb_truetype.h:      t = p[0];
include/stb-master/stb_truetype.h:      p[0] = p[m];
