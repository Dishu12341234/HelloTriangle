include/stb-master/stb_c_lexer.h:{
include/stb-master/stb_c_lexer.h:   switch (lexer->token) {
include/stb-master/stb_c_lexer.h:      case CLEX_id        : printf("_%s", lexer->string); break;
include/stb-master/stb_c_lexer.h:      case CLEX_eq        : printf("=="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_noteq     : printf("!="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_lesseq    : printf("<="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_greatereq : printf(">="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_andand    : printf("&&"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_oror      : printf("||"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_shl       : printf("<<"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_shr       : printf(">>"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_plusplus  : printf("++"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_minusminus: printf("--"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_arrow     : printf("->"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_andeq     : printf("&="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_oreq      : printf("|="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_xoreq     : printf("^="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_pluseq    : printf("+="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_minuseq   : printf("-="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_muleq     : printf("*="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_diveq     : printf("/="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_modeq     : printf("%%="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_shleq     : printf("<<="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_shreq     : printf(">>="); break;
include/stb-master/stb_c_lexer.h:      case CLEX_eqarrow   : printf("=>"); break;
include/stb-master/stb_c_lexer.h:      case CLEX_dqstring  : printf("\"%s\"", lexer->string); break;
include/stb-master/stb_c_lexer.h:      case CLEX_sqstring  : printf("'\"%s\"'", lexer->string); break;
include/stb-master/stb_c_lexer.h:      case CLEX_charlit   : printf("'%s'", lexer->string); break;
include/stb-master/stb_c_lexer.h:      #if defined(STB__clex_int_as_double) && !defined(STB__CLEX_use_stdlib)
include/stb-master/stb_c_lexer.h:      case CLEX_intlit    : printf("#%g", lexer->real_number); break;
include/stb-master/stb_c_lexer.h:      #else
include/stb-master/stb_c_lexer.h:      case CLEX_intlit    : printf("#%ld", lexer->int_number); break;
include/stb-master/stb_c_lexer.h:      #endif
include/stb-master/stb_c_lexer.h:      case CLEX_floatlit  : printf("%g", lexer->real_number); break;
include/stb-master/stb_c_lexer.h:      default:
include/stb-master/stb_c_lexer.h:         if (lexer->token >= 0 && lexer->token < 256)
include/stb-master/stb_c_lexer.h:            printf("%c", (int) lexer->token);
include/stb-master/stb_c_lexer.h:         else {
include/stb-master/stb_c_lexer.h:            printf("<<<UNKNOWN TOKEN %ld >>>\n", lexer->token);
include/stb-master/stb_c_lexer.h:         }
include/stb-master/stb_c_lexer.h:         break;
include/stb-master/stb_c_lexer.h:   }
include/stb-master/stb_c_lexer.h:}
