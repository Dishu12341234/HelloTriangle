include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:#ifndef STB_SPRINTF_H_INCLUDE
include/stb-master/stb_sprintf.h:#define STB_SPRINTF_H_INCLUDE
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:/*
include/stb-master/stb_sprintf.h:Single file sprintf replacement.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:Originally written by Jeff Roberts at RAD Game Tools - 2015/10/20.
include/stb-master/stb_sprintf.h:Hereby placed in public domain.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:This is a full sprintf replacement that supports everything that
include/stb-master/stb_sprintf.h:the C runtime sprintfs support, including float/double, 64-bit integers,
include/stb-master/stb_sprintf.h:hex floats, field parameters (%*.*d stuff), length reads backs, etc.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:Why would you need this if sprintf already exists?  Well, first off,
include/stb-master/stb_sprintf.h:it's *much* faster (see below). It's also much smaller than the CRT
include/stb-master/stb_sprintf.h:versions code-space-wise. We've also added some simple improvements
include/stb-master/stb_sprintf.h:that are super handy (commas in thousands, callbacks at buffer full,
include/stb-master/stb_sprintf.h:for example). Finally, the format strings for MSVC and GCC differ
include/stb-master/stb_sprintf.h:for 64-bit integers (among other small things), so this lets you use
include/stb-master/stb_sprintf.h:the same format strings in cross platform code.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:It uses the standard single file trick of being both the header file
include/stb-master/stb_sprintf.h:and the source itself. If you just include it normally, you just get
include/stb-master/stb_sprintf.h:the header file function definitions. To get the code, you include
include/stb-master/stb_sprintf.h:it from a C or C++ file and define STB_SPRINTF_IMPLEMENTATION first.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:It only uses va_args macros from the C runtime to do it's work. It
include/stb-master/stb_sprintf.h:does cast doubles to S64s and shifts and divides U64s, which does
include/stb-master/stb_sprintf.h:drag in CRT code on most platforms.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:It compiles to roughly 8K with float support, and 4K without.
include/stb-master/stb_sprintf.h:As a comparison, when using MSVC static libs, calling sprintf drags
include/stb-master/stb_sprintf.h:in 16K.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:API:
include/stb-master/stb_sprintf.h:====
include/stb-master/stb_sprintf.h:int stbsp_sprintf( char * buf, char const * fmt, ... )
include/stb-master/stb_sprintf.h:int stbsp_snprintf( char * buf, int count, char const * fmt, ... )
include/stb-master/stb_sprintf.h:  Convert an arg list into a buffer.  stbsp_snprintf always returns
include/stb-master/stb_sprintf.h:  a zero-terminated string (unlike regular snprintf).
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:int stbsp_vsprintf( char * buf, char const * fmt, va_list va )
include/stb-master/stb_sprintf.h:int stbsp_vsnprintf( char * buf, int count, char const * fmt, va_list va )
include/stb-master/stb_sprintf.h:  Convert a va_list arg list into a buffer.  stbsp_vsnprintf always returns
include/stb-master/stb_sprintf.h:  a zero-terminated string (unlike regular snprintf).
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:int stbsp_vsprintfcb( STBSP_SPRINTFCB * callback, void * user, char * buf, char const * fmt, va_list va )
include/stb-master/stb_sprintf.h:    typedef char * STBSP_SPRINTFCB( char const * buf, void * user, int len );
include/stb-master/stb_sprintf.h:  Convert into a buffer, calling back every STB_SPRINTF_MIN chars.
include/stb-master/stb_sprintf.h:  Your callback can then copy the chars out, print them or whatever.
include/stb-master/stb_sprintf.h:  This function is actually the workhorse for everything else.
include/stb-master/stb_sprintf.h:  The buffer you pass in must hold at least STB_SPRINTF_MIN characters.
include/stb-master/stb_sprintf.h:    // you return the next buffer to use or 0 to stop converting
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:void stbsp_set_separators( char comma, char period )
include/stb-master/stb_sprintf.h:  Set the comma and period characters to use.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:FLOATS/DOUBLES:
include/stb-master/stb_sprintf.h:===============
include/stb-master/stb_sprintf.h:This code uses a internal float->ascii conversion method that uses
include/stb-master/stb_sprintf.h:doubles with error correction (double-doubles, for ~105 bits of
include/stb-master/stb_sprintf.h:precision).  This conversion is round-trip perfect - that is, an atof
include/stb-master/stb_sprintf.h:of the values output here will give you the bit-exact double back.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:One difference is that our insignificant digits will be different than
include/stb-master/stb_sprintf.h:with MSVC or GCC (but they don't match each other either).  We also
include/stb-master/stb_sprintf.h:don't attempt to find the minimum length matching float (pre-MSVC15
include/stb-master/stb_sprintf.h:doesn't either).
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:If you don't need float or doubles at all, define STB_SPRINTF_NOFLOAT
include/stb-master/stb_sprintf.h:and you'll save 4K of code space.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:64-BIT INTS:
include/stb-master/stb_sprintf.h:============
include/stb-master/stb_sprintf.h:This library also supports 64-bit integers and you can use MSVC style or
include/stb-master/stb_sprintf.h:GCC style indicators (%I64d or %lld).  It supports the C99 specifiers
include/stb-master/stb_sprintf.h:for size_t and ptr_diff_t (%jd %zd) as well.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:EXTRAS:
include/stb-master/stb_sprintf.h:=======
include/stb-master/stb_sprintf.h:Like some GCCs, for integers and floats, you can use a ' (single quote)
include/stb-master/stb_sprintf.h:specifier and commas will be inserted on the thousands: "%'d" on 12345
include/stb-master/stb_sprintf.h:would print 12,345.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:For integers and floats, you can use a "$" specifier and the number
include/stb-master/stb_sprintf.h:will be converted to float and then divided to get kilo, mega, giga or
include/stb-master/stb_sprintf.h:tera and then printed, so "%$d" 1000 is "1.0 k", "%$.2d" 2536000 is
include/stb-master/stb_sprintf.h:"2.53 M", etc. For byte values, use two $:s, like "%$$d" to turn
include/stb-master/stb_sprintf.h:2536000 to "2.42 Mi". If you prefer JEDEC suffixes to SI ones, use three
include/stb-master/stb_sprintf.h:$:s: "%$$$d" -> "2.42 M". To remove the space between the number and the
include/stb-master/stb_sprintf.h:suffix, add "_" specifier: "%_$d" -> "2.53M".
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:In addition to octal and hexadecimal conversions, you can print
include/stb-master/stb_sprintf.h:integers in binary: "%b" for 256 would print 100.
include/stb-master/stb_sprintf.h:
include/stb-master/stb_sprintf.h:PERFORMANCE vs MSVC 2008 32-/64-bit (GCC is even slower than MSVC):
include/stb-master/stb_sprintf.h:===================================================================
include/stb-master/stb_sprintf.h:"%d" across all 32-bit ints (4.8x/4.0x faster than 32-/64-bit MSVC)
include/stb-master/stb_sprintf.h:"%24d" across all 32-bit ints (4.5x/4.2x faster)
include/stb-master/stb_sprintf.h:"%x" across all 32-bit ints (4.5x/3.8x faster)
include/stb-master/stb_sprintf.h:"%08x" across all 32-bit ints (4.3x/3.8x faster)
include/stb-master/stb_sprintf.h:"%f" across e-10 to e+10 floats (7.3x/6.0x faster)
include/stb-master/stb_sprintf.h:"%e" across e-10 to e+10 floats (8.1x/6.0x faster)
include/stb-master/stb_sprintf.h:"%g" across e-10 to e+10 floats (10.0x/7.1x faster)
include/stb-master/stb_sprintf.h:"%f" for values near e-300 (7.9x/6.5x faster)
include/stb-master/stb_sprintf.h:"%f" for values near e+300 (10.0x/9.1x faster)
include/stb-master/stb_sprintf.h:"%e" for values near e-300 (10.1x/7.0x faster)
include/stb-master/stb_sprintf.h:"%e" for values near e+300 (9.2x/6.0x faster)
include/stb-master/stb_sprintf.h:"%.320f" for values near e-300 (12.6x/11.2x faster)
include/stb-master/stb_sprintf.h:"%a" for random values (8.6x/4.3x faster)
include/stb-master/stb_sprintf.h:"%I64d" for 64-bits with 32-bit values (4.8x/3.4x faster)
include/stb-master/stb_sprintf.h:"%I64d" for 64-bits > 32-bit values (4.9x/5.5x faster)
include/stb-master/stb_sprintf.h:"%s%s%s" for 64 char strings (7.1x/7.3x faster)
include/stb-master/stb_sprintf.h:"...512 char string..." ( 35.0x/32.5x faster!)
include/stb-master/stb_sprintf.h:*/
