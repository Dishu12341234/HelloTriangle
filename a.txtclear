Event.cxx:void Event::eventLoop()
Event.cxx:{
Event.cxx:    static auto lastTime = std::chrono::high_resolution_clock::now();
Event.cxx:    auto currentTime = std::chrono::high_resolution_clock::now();
Event.cxx:    auto delta = currentTime - lastTime;
Event.cxx:    lastTime = currentTime;
Event.cxx:
Event.cxx:    dt = std::chrono::duration<double, std::milli>(delta).count();
Event.cxx:    // std::cout << "Δt = " << dt << std::endl;
Event.cxx:    // std::cout << "FPS: " << 1000.f / dt << std::endl;
Event.cxx:    glfwPollEvents();
Event.cxx:}
Event.cxx:
Event.cxx:bool Event::getKeyPressed(int key)
Event.cxx:{
Event.cxx:    return keyDown[key];
Event.cxx:}
