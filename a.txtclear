GraphicsPipeline.h:};
GraphicsPipeline.h:
GraphicsPipeline.h:// PCS
GraphicsPipeline.h:struct PushConstantC1
GraphicsPipeline.h:{
GraphicsPipeline.h:    glm::mat4 model;
GraphicsPipeline.h:    uint32_t tileIndex[6];
GraphicsPipeline.h:};
GraphicsPipeline.h:
GraphicsPipeline.h:struct Vertex
GraphicsPipeline.h:{
GraphicsPipeline.h:    glm::vec3 pos;
GraphicsPipeline.h:    glm::vec3 color;
GraphicsPipeline.h:    glm::vec2 texCoord;
GraphicsPipeline.h:    uint32_t vertexIndex;
GraphicsPipeline.h:    // Telling vulkan how to setup binding
GraphicsPipeline.h:    // Struct 1/2
GraphicsPipeline.h:    static VkVertexInputBindingDescription getBindingDescription();
GraphicsPipeline.h:    // Struct 2/2
GraphicsPipeline.h:    static std::array<VkVertexInputAttributeDescription, 4> getAttributeDescriptions();
GraphicsPipeline.h:
GraphicsPipeline.h:    bool operator==(const Vertex &other) const
GraphicsPipeline.h:    {
GraphicsPipeline.h:        return pos == other.pos && color == other.color && texCoord == other.texCoord;
GraphicsPipeline.h:    }
GraphicsPipeline.h:};
GraphicsPipeline.h:
GraphicsPipeline.h:namespace std
GraphicsPipeline.h:{
GraphicsPipeline.h:    template <>
GraphicsPipeline.h:    struct hash<Vertex>
GraphicsPipeline.h:    {
GraphicsPipeline.h:        size_t operator()(Vertex const &vertex) const
GraphicsPipeline.h:        {
GraphicsPipeline.h:            size_t seed = 0;
GraphicsPipeline.h:
GraphicsPipeline.h:            auto hashCombine = [&seed](auto const &v)
GraphicsPipeline.h:            {
GraphicsPipeline.h:                seed ^= std::hash<float>()(v) + 0x9e3779b97f4a7c15 + (seed << 6) + (seed >> 2);
GraphicsPipeline.h:            };
GraphicsPipeline.h:
GraphicsPipeline.h:            hashCombine(vertex.pos.x);
GraphicsPipeline.h:            hashCombine(vertex.pos.y);
GraphicsPipeline.h:            hashCombine(vertex.pos.z);
GraphicsPipeline.h:
GraphicsPipeline.h:            hashCombine(vertex.color.r);
GraphicsPipeline.h:            hashCombine(vertex.color.g);
GraphicsPipeline.h:            hashCombine(vertex.color.b);
GraphicsPipeline.h:
GraphicsPipeline.h:            hashCombine(vertex.texCoord.x);
GraphicsPipeline.h:            hashCombine(vertex.texCoord.y);
GraphicsPipeline.h:
GraphicsPipeline.h:            return seed;
GraphicsPipeline.h:        }
GraphicsPipeline.h:    };
GraphicsPipeline.h:}
GraphicsPipeline.h:
