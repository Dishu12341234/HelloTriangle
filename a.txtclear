include/stb-master/stb_herringbone_wang_tile.h:
include/stb-master/stb_herringbone_wang_tile.h:
include/stb-master/stb_herringbone_wang_tile.h:// TILE CONSTRAINT TYPES
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h:// there are 4 "types" of corners and 6 types of edges.
include/stb-master/stb_herringbone_wang_tile.h:// you can configure the tileset to have different numbers
include/stb-master/stb_herringbone_wang_tile.h:// of colors for each type of color or edge.
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h:// corner types:
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h://                     0---*---1---*---2---*---3
include/stb-master/stb_herringbone_wang_tile.h://                     |       |               |
include/stb-master/stb_herringbone_wang_tile.h://                     *       *               *
include/stb-master/stb_herringbone_wang_tile.h://                     |       |               |
include/stb-master/stb_herringbone_wang_tile.h://     1---*---2---*---3       0---*---1---*---2
include/stb-master/stb_herringbone_wang_tile.h://     |               |       |
include/stb-master/stb_herringbone_wang_tile.h://     *               *       *
include/stb-master/stb_herringbone_wang_tile.h://     |               |       |
include/stb-master/stb_herringbone_wang_tile.h://     0---*---1---*---2---*---3
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h://
include/stb-master/stb_herringbone_wang_tile.h://  edge types:
include/stb-master/stb_herringbone_wang_tile.h://
