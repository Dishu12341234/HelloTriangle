include/stb-master/stb_hexwave.h:// buffer should be NULL or must be 4*(width*(oversample+1)*2 + 
include/stb-master/stb_hexwave.h:STB_HEXWAVE_DEF void hexwave_init(int width, int oversample, float *user_buffer)
include/stb-master/stb_hexwave.h:{
include/stb-master/stb_hexwave.h:   int halfwidth = width/2;
include/stb-master/stb_hexwave.h:   int half = halfwidth*oversample;
include/stb-master/stb_hexwave.h:   int blep_buffer_count = width*(oversample+1);
include/stb-master/stb_hexwave.h:   int n = 2*half+1;
include/stb-master/stb_hexwave.h:#ifdef STB_HEXWAVE_NO_ALLOCATION
include/stb-master/stb_hexwave.h:   float *buffers = user_buffer;
include/stb-master/stb_hexwave.h:#else
include/stb-master/stb_hexwave.h:   float *buffers = user_buffer ? user_buffer : (float *) malloc(sizeof(float) * n * 2);
include/stb-master/stb_hexwave.h:#endif
include/stb-master/stb_hexwave.h:   float *step    = buffers+0*n;
include/stb-master/stb_hexwave.h:   float *ramp    = buffers+1*n;
include/stb-master/stb_hexwave.h:   float *blep_buffer, *blamp_buffer;
include/stb-master/stb_hexwave.h:   double integrate_impulse=0, integrate_step=0;
include/stb-master/stb_hexwave.h:   int i,j;
include/stb-master/stb_hexwave.h:
include/stb-master/stb_hexwave.h:   if (width > STB_HEXWAVE_MAX_BLEP_LENGTH)
