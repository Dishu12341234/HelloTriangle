include/stb-master/stb_truetype.h:   scale = stbtt_ScaleForPixelHeight(&font, 15);
include/stb-master/stb_truetype.h:   stbtt_GetFontVMetrics(&font, &ascent,0,0);
include/stb-master/stb_truetype.h:   baseline = (int) (ascent*scale);
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:   while (text[ch]) {
include/stb-master/stb_truetype.h:      int advance,lsb,x0,y0,x1,y1;
include/stb-master/stb_truetype.h:      float x_shift = xpos - (float) floor(xpos);
include/stb-master/stb_truetype.h:      stbtt_GetCodepointHMetrics(&font, text[ch], &advance, &lsb);
