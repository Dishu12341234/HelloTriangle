include/stb-master/stb_herringbone_wang_tile.h:   int num_h_tiles, max_h_tiles;
include/stb-master/stb_herringbone_wang_tile.h:   int num_v_tiles, max_v_tiles;
include/stb-master/stb_herringbone_wang_tile.h:};
