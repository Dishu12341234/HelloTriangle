include/tinyobjloader/tiny_obj_loader.h:static int pnpoly(int nvert, T *vertx, T *verty, T testx, T testy) {
include/tinyobjloader/tiny_obj_loader.h:  int i, j, c = 0;
include/tinyobjloader/tiny_obj_loader.h:  for (i = 0, j = nvert - 1; i < nvert; j = i++) {
include/tinyobjloader/tiny_obj_loader.h:    if (((verty[i] > testy) != (verty[j] > testy)) &&
include/tinyobjloader/tiny_obj_loader.h:        (testx <
include/tinyobjloader/tiny_obj_loader.h:         (vertx[j] - vertx[i]) * (testy - verty[i]) / (verty[j] - verty[i]) +
include/tinyobjloader/tiny_obj_loader.h:             vertx[i]))
include/tinyobjloader/tiny_obj_loader.h:      c = !c;
include/tinyobjloader/tiny_obj_loader.h:  }
include/tinyobjloader/tiny_obj_loader.h:  return c;
include/tinyobjloader/tiny_obj_loader.h:}
