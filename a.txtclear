include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_PackBegin(stbtt_pack_context *spc, unsigned char *pixels, int width, int height, int stride_in_bytes, int padding, void *alloc_context);
include/stb-master/stb_truetype.h:// Initializes a packing context stored in the passed-in stbtt_pack_context.
include/stb-master/stb_truetype.h:// Future calls using this context will pack characters into the bitmap passed
include/stb-master/stb_truetype.h:// in here: a 1-channel bitmap that is width * height. stride_in_bytes is
include/stb-master/stb_truetype.h:// the distance from one row to the next (or 0 to mean they are packed tightly
include/stb-master/stb_truetype.h:// together). "padding" is the amount of padding to leave between each
include/stb-master/stb_truetype.h:// character (normally you want '1' for bitmaps you'll use as textures with
include/stb-master/stb_truetype.h:// bilinear filtering).
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// Returns 0 on failure, 1 on success.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_PackEnd  (stbtt_pack_context *spc);
include/stb-master/stb_truetype.h:// Cleans up the packing context and frees all memory.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:#define STBTT_POINT_SIZE(x)   (-(x))
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_PackFontRange(stbtt_pack_context *spc, const unsigned char *fontdata, int font_index, float font_size,
include/stb-master/stb_truetype.h:                                int first_unicode_char_in_range, int num_chars_in_range, stbtt_packedchar *chardata_for_range);
include/stb-master/stb_truetype.h:// Creates character bitmaps from the font_index'th font found in fontdata (use
include/stb-master/stb_truetype.h:// font_index=0 if you don't know what that is). It creates num_chars_in_range
include/stb-master/stb_truetype.h:// bitmaps for characters with unicode values starting at first_unicode_char_in_range
include/stb-master/stb_truetype.h:// and increasing. Data for how to render them is stored in chardata_for_range;
include/stb-master/stb_truetype.h:// pass these to stbtt_GetPackedQuad to get back renderable quads.
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// font_size is the full height of the character from ascender to descender,
include/stb-master/stb_truetype.h:// as computed by stbtt_ScaleForPixelHeight. To use a point size as computed
include/stb-master/stb_truetype.h:// by stbtt_ScaleForMappingEmToPixels, wrap the point size in STBTT_POINT_SIZE()
include/stb-master/stb_truetype.h:// and pass that result as 'font_size':
include/stb-master/stb_truetype.h://       ...,                  20 , ... // font max minus min y is 20 pixels tall
include/stb-master/stb_truetype.h://       ..., STBTT_POINT_SIZE(20), ... // 'M' is 20 pixels tall
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:typedef struct
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   float font_size;
include/stb-master/stb_truetype.h:   int first_unicode_codepoint_in_range;  // if non-zero, then the chars are continuous, and this is the first codepoint
include/stb-master/stb_truetype.h:   int *array_of_unicode_codepoints;       // if non-zero, then this is an array of unicode codepoints
include/stb-master/stb_truetype.h:   int num_chars;
include/stb-master/stb_truetype.h:   stbtt_packedchar *chardata_for_range; // output
include/stb-master/stb_truetype.h:   unsigned char h_oversample, v_oversample; // don't set these, they're used internally
include/stb-master/stb_truetype.h:} stbtt_pack_range;
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_PackFontRanges(stbtt_pack_context *spc, const unsigned char *fontdata, int font_index, stbtt_pack_range *ranges, int num_ranges);
include/stb-master/stb_truetype.h:// Creates character bitmaps from multiple ranges of characters stored in
include/stb-master/stb_truetype.h:// ranges. This will usually create a better-packed bitmap than multiple
include/stb-master/stb_truetype.h:// calls to stbtt_PackFontRange. Note that you can call this multiple
include/stb-master/stb_truetype.h:// times within a single PackBegin/PackEnd.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_PackSetOversampling(stbtt_pack_context *spc, unsigned int h_oversample, unsigned int v_oversample);
include/stb-master/stb_truetype.h:// Oversampling a font increases the quality by allowing higher-quality subpixel
include/stb-master/stb_truetype.h:// positioning, and is especially valuable at smaller text sizes.
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// This function sets the amount of oversampling for all following calls to
include/stb-master/stb_truetype.h:// stbtt_PackFontRange(s) or stbtt_PackFontRangesGatherRects for a given
include/stb-master/stb_truetype.h:// pack context. The default (no oversampling) is achieved by h_oversample=1
include/stb-master/stb_truetype.h:// and v_oversample=1. The total number of pixels required is
include/stb-master/stb_truetype.h:// h_oversample*v_oversample larger than the default; for example, 2x2
include/stb-master/stb_truetype.h:// oversampling requires 4x the storage of 1x1. For best results, render
include/stb-master/stb_truetype.h:// oversampled textures with bilinear filtering. Look at the readme in
include/stb-master/stb_truetype.h:// stb/tests/oversample for information about oversampled fonts
include/stb-master/stb_truetype.h://
include/stb-master/stb_truetype.h:// To use with PackFontRangesGather etc., you must set it before calls
include/stb-master/stb_truetype.h:// call to PackFontRangesGatherRects.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_PackSetSkipMissingCodepoints(stbtt_pack_context *spc, int skip);
include/stb-master/stb_truetype.h:// If skip != 0, this tells stb_truetype to skip any codepoints for which
include/stb-master/stb_truetype.h:// there is no corresponding glyph. If skip=0, which is the default, then
include/stb-master/stb_truetype.h:// codepoints without a glyph recived the font's "missing character" glyph,
include/stb-master/stb_truetype.h:// typically an empty box by convention.
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_GetPackedQuad(const stbtt_packedchar *chardata, int pw, int ph,  // same data as above
include/stb-master/stb_truetype.h:                               int char_index,             // character to display
include/stb-master/stb_truetype.h:                               float *xpos, float *ypos,   // pointers to current position in screen pixel space
include/stb-master/stb_truetype.h:                               stbtt_aligned_quad *q,      // output: quad to draw
include/stb-master/stb_truetype.h:                               int align_to_integer);
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_PackFontRangesGatherRects(stbtt_pack_context *spc, const stbtt_fontinfo *info, stbtt_pack_range *ranges, int num_ranges, stbrp_rect *rects);
include/stb-master/stb_truetype.h:STBTT_DEF void stbtt_PackFontRangesPackRects(stbtt_pack_context *spc, stbrp_rect *rects, int num_rects);
include/stb-master/stb_truetype.h:STBTT_DEF int  stbtt_PackFontRangesRenderIntoRects(stbtt_pack_context *spc, const stbtt_fontinfo *info, stbtt_pack_range *ranges, int num_ranges, stbrp_rect *rects);
include/stb-master/stb_truetype.h:// Calling these functions in sequence is roughly equivalent to calling
include/stb-master/stb_truetype.h:// stbtt_PackFontRanges(). If you more control over the packing of multiple
include/stb-master/stb_truetype.h:// fonts, or if you want to pack custom data into a font texture, take a look
include/stb-master/stb_truetype.h:// at the source to of stbtt_PackFontRanges() and create a custom version
include/stb-master/stb_truetype.h:// using these functions, e.g. call GatherRects multiple times,
include/stb-master/stb_truetype.h:// building up a single array of rects, then call PackRects once,
include/stb-master/stb_truetype.h:// then call RenderIntoRects repeatedly. This may result in a
include/stb-master/stb_truetype.h:// better packing than calling PackFontRanges multiple times
include/stb-master/stb_truetype.h:// (or it may not).
