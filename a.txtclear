include/stb-master/deprecated/stretchy_buffer.h:#define sb_free   stb_sb_free
include/stb-master/deprecated/stretchy_buffer.h:#define sb_push   stb_sb_push
include/stb-master/deprecated/stretchy_buffer.h:#define sb_count  stb_sb_count
