include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  STBIR_1CHANNEL = 1,
include/stb-master/stb_image_resize2.h:  STBIR_2CHANNEL = 2,
include/stb-master/stb_image_resize2.h:  STBIR_RGB      = 3,               // 3-chan, with order specified (for channel flipping)
include/stb-master/stb_image_resize2.h:  STBIR_BGR      = 0,               // 3-chan, with order specified (for channel flipping)
include/stb-master/stb_image_resize2.h:  STBIR_4CHANNEL = 5,
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  STBIR_RGBA = 4,                   // alpha formats, where alpha is NOT premultiplied into color channels
include/stb-master/stb_image_resize2.h:  STBIR_BGRA = 6,
include/stb-master/stb_image_resize2.h:  STBIR_ARGB = 7,
include/stb-master/stb_image_resize2.h:  STBIR_ABGR = 8,
include/stb-master/stb_image_resize2.h:  STBIR_RA   = 9,
include/stb-master/stb_image_resize2.h:  STBIR_AR   = 10,
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  STBIR_RGBA_PM = 11,               // alpha formats, where alpha is premultiplied into color channels
include/stb-master/stb_image_resize2.h:  STBIR_BGRA_PM = 12,
include/stb-master/stb_image_resize2.h:  STBIR_ARGB_PM = 13,
include/stb-master/stb_image_resize2.h:  STBIR_ABGR_PM = 14,
include/stb-master/stb_image_resize2.h:  STBIR_RA_PM   = 15,
include/stb-master/stb_image_resize2.h:  STBIR_AR_PM   = 16,
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:  STBIR_RGBA_NO_AW = 11,            // alpha formats, where NO alpha weighting is applied at all!
include/stb-master/stb_image_resize2.h:  STBIR_BGRA_NO_AW = 12,            //   these are just synonyms for the _PM flags (which also do
include/stb-master/stb_image_resize2.h:  STBIR_ARGB_NO_AW = 13,            //   no alpha weighting). These names just make it more clear
include/stb-master/stb_image_resize2.h:  STBIR_ABGR_NO_AW = 14,            //   for some folks).
include/stb-master/stb_image_resize2.h:  STBIR_RA_NO_AW   = 15,
include/stb-master/stb_image_resize2.h:  STBIR_AR_NO_AW   = 16,
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:} stbir_pixel_layout;
