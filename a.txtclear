include/stb-master/stb_truetype.h:   int              fontstart;         // offset of start of font
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:   int numGlyphs;                     // number of glyphs, needed for range checking
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:   int loca,head,glyf,hhea,hmtx,kern,gpos,svg; // table locations as offset from start of .ttf
include/stb-master/stb_truetype.h:   int index_map;                     // a cmap mapping for our chosen character encoding
include/stb-master/stb_truetype.h:   int indexToLocFormat;              // format needed to map from glyph index to glyph
