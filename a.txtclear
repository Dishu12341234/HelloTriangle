include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:    // ok, when we are gathering, we need to make sure we are starting on a y offset that doesn't have
include/stb-master/stb_image_resize2.h:    //   a "special" set of coefficients. Basically, with exactly the right filter at exactly the right
include/stb-master/stb_image_resize2.h:    //   resize at exactly the right phase, some of the coefficents can be zero. When they are zero, we
include/stb-master/stb_image_resize2.h:    //   don't process them at all.  But this leads to a tricky thing with the thread splits, where we
include/stb-master/stb_image_resize2.h:    //   might have a set of two coeffs like this for example: (4,4) and (3,6).  The 4,4 means there was
include/stb-master/stb_image_resize2.h:    //   just one single coeff because things worked out perfectly (normally, they all have 4 coeffs
include/stb-master/stb_image_resize2.h:    //   like the range 3,6.  The problem is that if we start right on the (4,4) on a brand new thread,
include/stb-master/stb_image_resize2.h:    //   then when we get to (3,6), we don't have the "3" sample in memory (because we didn't load
include/stb-master/stb_image_resize2.h:    //   it on the initial (4,4) range because it didn't have a 3 (we only add new samples that are 
include/stb-master/stb_image_resize2.h:    //   larger than our existing samples - it's just how the eviction works). So, our solution here
include/stb-master/stb_image_resize2.h:    //   is pretty simple, if we start right on a range that has samples that start earlier, then we 
include/stb-master/stb_image_resize2.h:    //   simply bump up our previous thread split range to include it, and then start this threads
include/stb-master/stb_image_resize2.h:    //   range with the smaller sample. It just moves one scanline from one thread split to another,
include/stb-master/stb_image_resize2.h:    //   so that we end with the unusual one, instead of start with it. To do this, we check 2-4 
include/stb-master/stb_image_resize2.h:    //   sample at each thread split start and then occassionally move them.
include/stb-master/stb_image_resize2.h:    
include/stb-master/stb_image_resize2.h:    if ( ( is_gather ) && ( i ) )
include/stb-master/stb_image_resize2.h:    {
