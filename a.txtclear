include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h://///////////////////// undo system ////////////////////////
include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:// the undo system works by storing "commands" into a buffer, and
include/stb-master/stb_tilemap_editor.h:// then playing back those commands. undo and redo have to store
include/stb-master/stb_tilemap_editor.h:// the commands in different order.
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// the commands are:
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// 1)  end_of_undo_record
include/stb-master/stb_tilemap_editor.h://       -1:short
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// 2)  end_of_redo_record
include/stb-master/stb_tilemap_editor.h://       -2:short
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// 3)  tile update
include/stb-master/stb_tilemap_editor.h://       tile_id:short (-1..32767)
include/stb-master/stb_tilemap_editor.h://       x_coord:short
include/stb-master/stb_tilemap_editor.h://       y_coord:short
include/stb-master/stb_tilemap_editor.h://       layer:short (0..31)
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// 4)  property update (also used for links)
include/stb-master/stb_tilemap_editor.h://       value_hi:short
include/stb-master/stb_tilemap_editor.h://       value_lo:short
include/stb-master/stb_tilemap_editor.h://       y_coord:short
include/stb-master/stb_tilemap_editor.h://       x_coord:short
include/stb-master/stb_tilemap_editor.h://       property:short (256+prop#)
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// Since we use a circular buffer, we might overwrite the undo storage.
include/stb-master/stb_tilemap_editor.h:// To detect this, before playing back commands we scan back and see
include/stb-master/stb_tilemap_editor.h:// if we see an end_of_undo_record before hitting the relevant boundary,
include/stb-master/stb_tilemap_editor.h:// it's wholly contained.
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// When we read back through, we see them in reverse order, so
include/stb-master/stb_tilemap_editor.h:// we'll see the layer number or property number first
include/stb-master/stb_tilemap_editor.h://
include/stb-master/stb_tilemap_editor.h:// To be clearer about the circular buffer, there are two cases:
include/stb-master/stb_tilemap_editor.h://     1. a single record is larger than the whole buffer.
include/stb-master/stb_tilemap_editor.h://        this is caught because the end_of_undo_record will
include/stb-master/stb_tilemap_editor.h://        get overwritten.
include/stb-master/stb_tilemap_editor.h://     2. multiple records written are larger than the whole
include/stb-master/stb_tilemap_editor.h://        buffer, so some of them have been overwritten by
include/stb-master/stb_tilemap_editor.h://        the later ones. this is handled by explicitly tracking
include/stb-master/stb_tilemap_editor.h://        the undo length; we never try to parse the data that
include/stb-master/stb_tilemap_editor.h://        got overwritten
include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:// given two points, compute the length between them
include/stb-master/stb_tilemap_editor.h:#define stbte__wrap(pos)            ((pos) & (STBTE__UNDO_BUFFER_COUNT-1))
include/stb-master/stb_tilemap_editor.h:
include/stb-master/stb_tilemap_editor.h:#define STBTE__undo_record  -2
include/stb-master/stb_tilemap_editor.h:#define STBTE__redo_record  -3
include/stb-master/stb_tilemap_editor.h:#define STBTE__undo_junk    -4  // this is written underneath the undo pointer, never used
