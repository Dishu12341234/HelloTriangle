include/stb-master/tests/prerelease/stb_lib.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://                     Instantiated data structures
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h:// This is an attempt to implement a templated data structure.
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h:// Hash table: call stb_define_hash(TYPE,N,KEY,K1,K2,HASH,VALUE)
include/stb-master/tests/prerelease/stb_lib.h://     TYPE     -- will define a structure type containing the hash table
include/stb-master/tests/prerelease/stb_lib.h://     N        -- the name, will prefix functions named:
include/stb-master/tests/prerelease/stb_lib.h://                        N create
include/stb-master/tests/prerelease/stb_lib.h://                        N destroy
include/stb-master/tests/prerelease/stb_lib.h://                        N get
include/stb-master/tests/prerelease/stb_lib.h://                        N set, N add, N update,
include/stb-master/tests/prerelease/stb_lib.h://                        N remove
include/stb-master/tests/prerelease/stb_lib.h://     KEY      -- the type of the key. 'x == y' must be valid
include/stb-master/tests/prerelease/stb_lib.h://       K1,K2  -- keys never used by the app, used as flags in the hashtable
include/stb-master/tests/prerelease/stb_lib.h://       HASH   -- a piece of code ending with 'return' that hashes key 'k'
include/stb-master/tests/prerelease/stb_lib.h://     VALUE    -- the type of the value. 'x = y' must be valid
include/stb-master/tests/prerelease/stb_lib.h://
include/stb-master/tests/prerelease/stb_lib.h://  Note that stb_define_hash_base can be used to define more sophisticated
include/stb-master/tests/prerelease/stb_lib.h://  hash tables, e.g. those that make copies of the key or use special
include/stb-master/tests/prerelease/stb_lib.h://  comparisons (e.g. strcmp).
