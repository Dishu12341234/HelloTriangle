include/stb-master/stb_truetype.h:         c = STBTT__COMPARE(&p[0],&p[n-1]);
include/stb-master/stb_truetype.h:         /* 0>mid && mid<n:  0>n => n; 0<n => 0 */
include/stb-master/stb_truetype.h:         /* 0<mid && mid>n:  0>n => 0; 0<n => n */
include/stb-master/stb_truetype.h:         z = (c == c12) ? 0 : n-1;
include/stb-master/stb_truetype.h:         t = p[z];
