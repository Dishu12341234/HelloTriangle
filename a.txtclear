include/stb-master/stb_textedit.h:      // need to re-insert the characters that get deleted, so we need to store
include/stb-master/stb_textedit.h:      // them.
include/stb-master/stb_textedit.h:
include/stb-master/stb_textedit.h:      // there are three cases:
include/stb-master/stb_textedit.h:      //    there's enough room to store the characters
include/stb-master/stb_textedit.h:      //    characters stored for *redoing* don't leave room for redo
include/stb-master/stb_textedit.h:      //    characters stored for *undoing* don't leave room for redo
include/stb-master/stb_textedit.h:      // if the last is true, we have to bail
