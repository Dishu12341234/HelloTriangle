include/stb-master/stb_image_resize2.h:      int j, smallest, stop, start_n0;
include/stb-master/stb_image_resize2.h:      stbir__contributors * split_contribs = contribs + cur;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:      // scan for a max of 3x the filter width or until the next thread split
include/stb-master/stb_image_resize2.h:      stop = vertical_pixel_margin * 3;
include/stb-master/stb_image_resize2.h:      if ( each < stop )
include/stb-master/stb_image_resize2.h:        stop = each;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:      // loops a few times before early out
include/stb-master/stb_image_resize2.h:      smallest = 0;
include/stb-master/stb_image_resize2.h:      small_contribs = split_contribs;
include/stb-master/stb_image_resize2.h:      start_n0 = small_contribs->n0;
include/stb-master/stb_image_resize2.h:      for( j = 1 ; j <= stop ; j++ )
include/stb-master/stb_image_resize2.h:      {
include/stb-master/stb_image_resize2.h:        ++split_contribs;
include/stb-master/stb_image_resize2.h:        if ( split_contribs->n0 > start_n0 )
include/stb-master/stb_image_resize2.h:          break;
include/stb-master/stb_image_resize2.h:        if ( split_contribs->n0 < small_contribs->n0 )
include/stb-master/stb_image_resize2.h:        {
include/stb-master/stb_image_resize2.h:          small_contribs = split_contribs;
include/stb-master/stb_image_resize2.h:          smallest = j;
include/stb-master/stb_image_resize2.h:        }
include/stb-master/stb_image_resize2.h:      }
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:      split_info[i-1].end_output_y += smallest;
include/stb-master/stb_image_resize2.h:      split_info[i].start_output_y += smallest;
include/stb-master/stb_image_resize2.h:    }
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:    cur += each;
include/stb-master/stb_image_resize2.h:    left -= each;
include/stb-master/stb_image_resize2.h:
include/stb-master/stb_image_resize2.h:    // scatter range (updated to minimum as you run it)
include/stb-master/stb_image_resize2.h:    split_info[i].start_input_y = -vertical_pixel_margin;
include/stb-master/stb_image_resize2.h:    split_info[i].end_input_y = input_full_height + vertical_pixel_margin;
include/stb-master/stb_image_resize2.h:  }
