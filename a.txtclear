main.cxx:int main(int argc, char const *argv[])
main.cxx:{
main.cxx:    pid_t pid = getpid();
main.cxx:    std::cout << "process ID: " << pid << std::endl;
main.cxx:
main.cxx:    std::string processName = argv[0];
main.cxx:    std::cout << "Process Name: " << processName << std::endl;
main.cxx:    HelloTriangleApplication application(processName);
main.cxx:    try
main.cxx:    {
main.cxx:        application.run();
main.cxx:    }
main.cxx:    catch(const std::exception& e)
main.cxx:    {
main.cxx:        std::cerr << e.what() << '\n';
main.cxx:        return EXIT_FAILURE;
main.cxx:    }
main.cxx:
main.cxx:    return EXIT_SUCCESS;
main.cxx:    
main.cxx:}
