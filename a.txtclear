intiVk.cxx:VkSampleCountFlagBits HelloTriangleApplication::getMaxUsableSampleCount()
intiVk.cxx:{
intiVk.cxx:    VkPhysicalDeviceProperties physicalDeviceProperties;
intiVk.cxx:    vkGetPhysicalDeviceProperties(physicalDevice, &physicalDeviceProperties);
intiVk.cxx:
intiVk.cxx:    VkSampleCountFlags counts = physicalDeviceProperties.limits.framebufferColorSampleCounts & physicalDeviceProperties.limits.framebufferDepthSampleCounts;
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_64_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_64_BIT;
intiVk.cxx:    }
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_32_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_32_BIT;
intiVk.cxx:    }
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_16_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_16_BIT;
intiVk.cxx:    }
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_8_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_8_BIT;
intiVk.cxx:    }
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_4_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_4_BIT;
intiVk.cxx:    }
intiVk.cxx:    if (counts & VK_SAMPLE_COUNT_2_BIT)
intiVk.cxx:    {
intiVk.cxx:        return VK_SAMPLE_COUNT_2_BIT;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    return VK_SAMPLE_COUNT_1_BIT;
intiVk.cxx:}
