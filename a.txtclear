include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_BASE_5_7,  // 4/7
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_BASE_1     // 1.0
include/stb-master/stb_voxel_render.h:};
