include/stb-master/stb_textedit.h:         STB_TEXTEDIT_memmove(state->undo_char + state->redo_char_point, state->undo_char + state->redo_char_point-n, (size_t) ((STB_TEXTEDIT_UNDOCHARCOUNT - state->redo_char_point)*sizeof(STB_TEXTEDIT_CHARTYPE)));
include/stb-master/stb_textedit.h:         // adjust the position of all the other records to account for above memmove
include/stb-master/stb_textedit.h:         for (i=state->redo_point; i < k; ++i)
include/stb-master/stb_textedit.h:            if (state->undo_rec[i].char_storage >= 0)
include/stb-master/stb_textedit.h:               state->undo_rec[i].char_storage += n;
include/stb-master/stb_textedit.h:      }
include/stb-master/stb_textedit.h:      // now move all the redo records towards the end of the buffer; the first one is at 'redo_point'
include/stb-master/stb_textedit.h:      STB_TEXTEDIT_memmove(state->undo_rec + state->redo_point+1, state->undo_rec + state->redo_point, (size_t) ((STB_TEXTEDIT_UNDOSTATECOUNT - state->redo_point)*sizeof(state->undo_rec[0])));
include/stb-master/stb_textedit.h:      // now move redo_point to point to the new one
include/stb-master/stb_textedit.h:      ++state->redo_point;
include/stb-master/stb_textedit.h:   }
include/stb-master/stb_textedit.h:}
