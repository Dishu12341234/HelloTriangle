HelloTriangleApplication.cxx:void HelloTriangleApplication::run()
HelloTriangleApplication.cxx:{
HelloTriangleApplication.cxx:    initWindow();
HelloTriangleApplication.cxx:    initVulkan();
HelloTriangleApplication.cxx:    mainLoop();
HelloTriangleApplication.cxx:    cleanup();
HelloTriangleApplication.cxx:}
