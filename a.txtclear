include/stb-master/stb_dxt.h:static void stb__CompressAlphaBlock(unsigned char *dest,unsigned char *src, int stride)
include/stb-master/stb_dxt.h:{
include/stb-master/stb_dxt.h:   int i,dist,bias,dist4,dist2,bits,mask;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   // find min/max color
include/stb-master/stb_dxt.h:   int mn,mx;
include/stb-master/stb_dxt.h:   mn = mx = src[0];
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   for (i=1;i<16;i++)
include/stb-master/stb_dxt.h:   {
include/stb-master/stb_dxt.h:      if (src[i*stride] < mn) mn = src[i*stride];
include/stb-master/stb_dxt.h:      else if (src[i*stride] > mx) mx = src[i*stride];
include/stb-master/stb_dxt.h:   }
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   // encode them
include/stb-master/stb_dxt.h:   dest[0] = (unsigned char)mx;
include/stb-master/stb_dxt.h:   dest[1] = (unsigned char)mn;
include/stb-master/stb_dxt.h:   dest += 2;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   // determine bias and emit color indices
include/stb-master/stb_dxt.h:   // given the choice of mx/mn, these indices are optimal:
include/stb-master/stb_dxt.h:   // http://fgiesen.wordpress.com/2009/12/15/dxt5-alpha-block-index-determination/
include/stb-master/stb_dxt.h:   dist = mx-mn;
include/stb-master/stb_dxt.h:   dist4 = dist*4;
include/stb-master/stb_dxt.h:   dist2 = dist*2;
include/stb-master/stb_dxt.h:   bias = (dist < 8) ? (dist - 1) : (dist/2 + 2);
include/stb-master/stb_dxt.h:   bias -= mn * 7;
include/stb-master/stb_dxt.h:   bits = 0,mask=0;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:   for (i=0;i<16;i++) {
include/stb-master/stb_dxt.h:      int a = src[i*stride]*7 + bias;
include/stb-master/stb_dxt.h:      int ind,t;
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:      // select index. this is a "linear scale" lerp factor between 0 (val=min) and 7 (val=max).
include/stb-master/stb_dxt.h:      t = (a >= dist4) ? -1 : 0; ind =  t & 4; a -= dist4 & t;
include/stb-master/stb_dxt.h:      t = (a >= dist2) ? -1 : 0; ind += t & 2; a -= dist2 & t;
include/stb-master/stb_dxt.h:      ind += (a >= dist);
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:      // turn linear scale into DXT index (0/1 are extremal pts)
include/stb-master/stb_dxt.h:      ind = -ind & 7;
include/stb-master/stb_dxt.h:      ind ^= (2 > ind);
include/stb-master/stb_dxt.h:
include/stb-master/stb_dxt.h:      // write index
include/stb-master/stb_dxt.h:      mask |= ind << bits;
include/stb-master/stb_dxt.h:      if((bits += 3) >= 8) {
include/stb-master/stb_dxt.h:         *dest++ = (unsigned char)mask;
include/stb-master/stb_dxt.h:         mask >>= 8;
include/stb-master/stb_dxt.h:         bits -= 8;
include/stb-master/stb_dxt.h:      }
include/stb-master/stb_dxt.h:   }
include/stb-master/stb_dxt.h:}
