include/stb-master/stb_image_resize2.h:{
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_UINT8            = 0,
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_UINT8_SRGB       = 1,
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_UINT8_SRGB_ALPHA = 2,  // alpha channel, when present, should also be SRGB (this is very unusual)
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_UINT16           = 3,
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_FLOAT            = 4,
include/stb-master/stb_image_resize2.h:  STBIR_TYPE_HALF_FLOAT       = 5
include/stb-master/stb_image_resize2.h:} stbir_datatype;
