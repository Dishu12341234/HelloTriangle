MeshUploader.cxx:#include "MeshUploader.h"
MeshUploader.cxx:#include "Textures.hpp"
MeshUploader.cxx:
MeshUploader.cxx:#include <cstring>
MeshUploader.cxx:#include <stdexcept>
MeshUploader.cxx:#include <vector>
MeshUploader.cxx:
MeshUploader.cxx:/* ============================================================
MeshUploader.cxx:   Helpers
MeshUploader.cxx:   ============================================================ */
MeshUploader.cxx:
MeshUploader.cxx:uint32_t findMemoryType(
MeshUploader.cxx:    VkPhysicalDevice physicalDevice,
MeshUploader.cxx:    uint32_t typeFilter,
MeshUploader.cxx:    VkMemoryPropertyFlags properties)
MeshUploader.cxx:{
MeshUploader.cxx:    VkPhysicalDeviceMemoryProperties memProperties;
MeshUploader.cxx:    vkGetPhysicalDeviceMemoryProperties(
MeshUploader.cxx:        physicalDevice,
MeshUploader.cxx:        &memProperties);
MeshUploader.cxx:
MeshUploader.cxx:    for (uint32_t i = 0; i < memProperties.memoryTypeCount; i++)
MeshUploader.cxx:    {
MeshUploader.cxx:        if ((typeFilter & (1 << i)) &&
MeshUploader.cxx:            (memProperties.memoryTypes[i].propertyFlags & properties) == properties)
MeshUploader.cxx:        {
MeshUploader.cxx:            return i;
MeshUploader.cxx:        }
MeshUploader.cxx:    }
MeshUploader.cxx:
MeshUploader.cxx:    throw std::runtime_error("failed to find suitable memory type!");
MeshUploader.cxx:}
MeshUploader.cxx:
MeshUploader.cxx:VkCommandBuffer beginSingleTimeCommands(
MeshUploader.cxx:    VkDevice device,
MeshUploader.cxx:    VkCommandPool commandPool)
MeshUploader.cxx:{
MeshUploader.cxx:    VkCommandBufferAllocateInfo allocInfo{};
MeshUploader.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
MeshUploader.cxx:    allocInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
MeshUploader.cxx:    allocInfo.commandPool = commandPool;
MeshUploader.cxx:    allocInfo.commandBufferCount = 1;
MeshUploader.cxx:
MeshUploader.cxx:    VkCommandBuffer commandBuffer;
MeshUploader.cxx:    vkAllocateCommandBuffers(device, &allocInfo, &commandBuffer);
MeshUploader.cxx:
MeshUploader.cxx:    VkCommandBufferBeginInfo beginInfo{};
MeshUploader.cxx:    beginInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
MeshUploader.cxx:    beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
MeshUploader.cxx:
MeshUploader.cxx:    vkBeginCommandBuffer(commandBuffer, &beginInfo);
MeshUploader.cxx:    return commandBuffer;
MeshUploader.cxx:}
MeshUploader.cxx:
MeshUploader.cxx:void endSingleTimeCommands(
MeshUploader.cxx:    VkDevice device,
MeshUploader.cxx:    VkQueue graphicsQueue,
MeshUploader.cxx:    VkCommandPool commandPool,
MeshUploader.cxx:    VkCommandBuffer commandBuffer)
MeshUploader.cxx:{
MeshUploader.cxx:    vkEndCommandBuffer(commandBuffer);
MeshUploader.cxx:
MeshUploader.cxx:    VkSubmitInfo submitInfo{};
MeshUploader.cxx:    submitInfo.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
MeshUploader.cxx:    submitInfo.commandBufferCount = 1;
MeshUploader.cxx:    submitInfo.pCommandBuffers = &commandBuffer;
MeshUploader.cxx:
MeshUploader.cxx:    vkQueueSubmit(graphicsQueue, 1, &submitInfo, VK_NULL_HANDLE);
MeshUploader.cxx:    vkQueueWaitIdle(graphicsQueue);
MeshUploader.cxx:
MeshUploader.cxx:    vkFreeCommandBuffers(device, commandPool, 1, &commandBuffer);
MeshUploader.cxx:}
MeshUploader.cxx:
MeshUploader.cxx:/* ============================================================
MeshUploader.cxx:   MeshUploader
MeshUploader.cxx:   ============================================================ */
MeshUploader.cxx:
MeshUploader.cxx:VkCommandBuffer MeshUploader::beginBatch(
MeshUploader.cxx:    VkDevice device,
MeshUploader.cxx:    VkCommandPool commandPool)
MeshUploader.cxx:{
MeshUploader.cxx:    return beginSingleTimeCommands(device, commandPool);
MeshUploader.cxx:}
MeshUploader.cxx:
MeshUploader.cxx:void MeshUploader::recordUpload(
MeshUploader.cxx:    const VulkanContext &vkContext,
MeshUploader.cxx:    GameMeshObject &mesh,
MeshUploader.cxx:    VkCommandBuffer cmd,
MeshUploader.cxx:    std::vector<PendingUpload> &garbage)
MeshUploader.cxx:{
MeshUploader.cxx:
MeshUploader.cxx:    mesh.vkContext = vkContext;
MeshUploader.cxx:
MeshUploader.cxx:    if (mesh.vertices.empty())
MeshUploader.cxx:        return;
MeshUploader.cxx:
MeshUploader.cxx:    /* ===================== VERTEX BUFFER ===================== */
MeshUploader.cxx:
MeshUploader.cxx:    VkDeviceSize vertexSize =
MeshUploader.cxx:        sizeof(mesh.vertices[0]) * mesh.vertices.size();
MeshUploader.cxx:
MeshUploader.cxx:    VkBuffer vertexStaging;
MeshUploader.cxx:    VkDeviceMemory vertexStagingMemory;
MeshUploader.cxx:
MeshUploader.cxx:    VkBufferCreateInfo bufferInfo{};
MeshUploader.cxx:    bufferInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
MeshUploader.cxx:    bufferInfo.size = vertexSize;
MeshUploader.cxx:    bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
MeshUploader.cxx:    bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
MeshUploader.cxx:
MeshUploader.cxx:    vkCreateBuffer(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        &bufferInfo,
MeshUploader.cxx:        nullptr,
MeshUploader.cxx:        &vertexStaging);
MeshUploader.cxx:
MeshUploader.cxx:    VkMemoryRequirements memReq;
MeshUploader.cxx:    vkGetBufferMemoryRequirements(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        vertexStaging,
MeshUploader.cxx:        &memReq);
MeshUploader.cxx:
MeshUploader.cxx:    VkMemoryAllocateInfo allocInfo{};
MeshUploader.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
MeshUploader.cxx:    allocInfo.allocationSize = memReq.size;
MeshUploader.cxx:    allocInfo.memoryTypeIndex = findMemoryType(
MeshUploader.cxx:        vkContext.physicalDevice,
MeshUploader.cxx:        memReq.memoryTypeBits,
MeshUploader.cxx:        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
MeshUploader.cxx:            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
MeshUploader.cxx:
MeshUploader.cxx:    vkAllocateMemory(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        &allocInfo,
MeshUploader.cxx:        nullptr,
MeshUploader.cxx:        &vertexStagingMemory);
MeshUploader.cxx:
MeshUploader.cxx:    vkBindBufferMemory(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        vertexStaging,
MeshUploader.cxx:        vertexStagingMemory,
MeshUploader.cxx:        0);
MeshUploader.cxx:
MeshUploader.cxx:    void *data;
MeshUploader.cxx:    vkMapMemory(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        vertexStagingMemory,
MeshUploader.cxx:        0,
MeshUploader.cxx:        vertexSize,
MeshUploader.cxx:        0,
MeshUploader.cxx:        &data);
MeshUploader.cxx:
MeshUploader.cxx:    memcpy(data, mesh.vertices.data(), (size_t)vertexSize);
MeshUploader.cxx:    vkUnmapMemory(vkContext.device, vertexStagingMemory);
MeshUploader.cxx:
MeshUploader.cxx:    bufferInfo.usage =
MeshUploader.cxx:        VK_BUFFER_USAGE_TRANSFER_DST_BIT |
MeshUploader.cxx:        VK_BUFFER_USAGE_VERTEX_BUFFER_BIT;
MeshUploader.cxx:
MeshUploader.cxx:    vkCreateBuffer(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        &bufferInfo,
MeshUploader.cxx:        nullptr,
MeshUploader.cxx:        &mesh.vertexBuffer);
MeshUploader.cxx:
MeshUploader.cxx:    vkGetBufferMemoryRequirements(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        mesh.vertexBuffer,
MeshUploader.cxx:        &memReq);
MeshUploader.cxx:
MeshUploader.cxx:    allocInfo.allocationSize = memReq.size;
MeshUploader.cxx:    allocInfo.memoryTypeIndex = findMemoryType(
MeshUploader.cxx:        vkContext.physicalDevice,
MeshUploader.cxx:        memReq.memoryTypeBits,
MeshUploader.cxx:        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
MeshUploader.cxx:
MeshUploader.cxx:    vkAllocateMemory(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        &allocInfo,
MeshUploader.cxx:        nullptr,
MeshUploader.cxx:        &mesh.vertexBufferMemory);
MeshUploader.cxx:
MeshUploader.cxx:    vkBindBufferMemory(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        mesh.vertexBuffer,
MeshUploader.cxx:        mesh.vertexBufferMemory,
MeshUploader.cxx:        0);
MeshUploader.cxx:
MeshUploader.cxx:    VkBufferCopy vertexCopy{};
MeshUploader.cxx:    vertexCopy.size = vertexSize;
MeshUploader.cxx:
MeshUploader.cxx:    vkCmdCopyBuffer(
MeshUploader.cxx:        cmd,
MeshUploader.cxx:        vertexStaging,
MeshUploader.cxx:        mesh.vertexBuffer,
MeshUploader.cxx:        1,
MeshUploader.cxx:        &vertexCopy);
MeshUploader.cxx:
MeshUploader.cxx:    garbage.push_back({vertexStaging, vertexStagingMemory});
MeshUploader.cxx:
MeshUploader.cxx:    /* ===================== INDEX BUFFER ===================== */
MeshUploader.cxx:
MeshUploader.cxx:    if (!mesh.indices.empty())
MeshUploader.cxx:    {
MeshUploader.cxx:        VkDeviceSize indexSize =
MeshUploader.cxx:            sizeof(mesh.indices[0]) * mesh.indices.size();
MeshUploader.cxx:
MeshUploader.cxx:        VkBuffer indexStaging;
MeshUploader.cxx:        VkDeviceMemory indexStagingMemory;
MeshUploader.cxx:
MeshUploader.cxx:        bufferInfo.size = indexSize;
MeshUploader.cxx:        bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
MeshUploader.cxx:
MeshUploader.cxx:        vkCreateBuffer(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            &bufferInfo,
MeshUploader.cxx:            nullptr,
MeshUploader.cxx:            &indexStaging);
MeshUploader.cxx:
MeshUploader.cxx:        vkGetBufferMemoryRequirements(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            indexStaging,
MeshUploader.cxx:            &memReq);
MeshUploader.cxx:
MeshUploader.cxx:        allocInfo.allocationSize = memReq.size;
MeshUploader.cxx:        allocInfo.memoryTypeIndex = findMemoryType(
MeshUploader.cxx:            vkContext.physicalDevice,
MeshUploader.cxx:            memReq.memoryTypeBits,
MeshUploader.cxx:            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
MeshUploader.cxx:                VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
MeshUploader.cxx:
MeshUploader.cxx:        vkAllocateMemory(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            &allocInfo,
MeshUploader.cxx:            nullptr,
MeshUploader.cxx:            &indexStagingMemory);
MeshUploader.cxx:
MeshUploader.cxx:        vkBindBufferMemory(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            indexStaging,
MeshUploader.cxx:            indexStagingMemory,
MeshUploader.cxx:            0);
MeshUploader.cxx:
MeshUploader.cxx:        vkMapMemory(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            indexStagingMemory,
MeshUploader.cxx:            0,
MeshUploader.cxx:            indexSize,
MeshUploader.cxx:            0,
MeshUploader.cxx:            &data);
MeshUploader.cxx:
MeshUploader.cxx:        memcpy(data, mesh.indices.data(), (size_t)indexSize);
MeshUploader.cxx:        vkUnmapMemory(vkContext.device, indexStagingMemory);
MeshUploader.cxx:
MeshUploader.cxx:        bufferInfo.usage =
MeshUploader.cxx:            VK_BUFFER_USAGE_TRANSFER_DST_BIT |
MeshUploader.cxx:            VK_BUFFER_USAGE_INDEX_BUFFER_BIT;
MeshUploader.cxx:
MeshUploader.cxx:        vkCreateBuffer(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            &bufferInfo,
MeshUploader.cxx:            nullptr,
MeshUploader.cxx:            &mesh.indexBuffer);
MeshUploader.cxx:
MeshUploader.cxx:        vkGetBufferMemoryRequirements(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            mesh.indexBuffer,
MeshUploader.cxx:            &memReq);
MeshUploader.cxx:
MeshUploader.cxx:        allocInfo.allocationSize = memReq.size;
MeshUploader.cxx:        allocInfo.memoryTypeIndex = findMemoryType(
MeshUploader.cxx:            vkContext.physicalDevice,
MeshUploader.cxx:            memReq.memoryTypeBits,
MeshUploader.cxx:            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
MeshUploader.cxx:
MeshUploader.cxx:        vkAllocateMemory(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            &allocInfo,
MeshUploader.cxx:            nullptr,
MeshUploader.cxx:            &mesh.indexBufferMemory);
MeshUploader.cxx:
MeshUploader.cxx:        vkBindBufferMemory(
MeshUploader.cxx:            vkContext.device,
MeshUploader.cxx:            mesh.indexBuffer,
MeshUploader.cxx:            mesh.indexBufferMemory,
MeshUploader.cxx:            0);
MeshUploader.cxx:
MeshUploader.cxx:        VkBufferCopy indexCopy{};
MeshUploader.cxx:        indexCopy.size = indexSize;
MeshUploader.cxx:
MeshUploader.cxx:        vkCmdCopyBuffer(
MeshUploader.cxx:            cmd,
MeshUploader.cxx:            indexStaging,
MeshUploader.cxx:            mesh.indexBuffer,
MeshUploader.cxx:            1,
MeshUploader.cxx:            &indexCopy);
MeshUploader.cxx:
MeshUploader.cxx:        garbage.push_back({indexStaging, indexStagingMemory});
MeshUploader.cxx:    }
MeshUploader.cxx:}
MeshUploader.cxx:
MeshUploader.cxx:void MeshUploader::endBatch(
MeshUploader.cxx:    const VulkanContext &vkContext,
MeshUploader.cxx:    VkCommandBuffer cmd,
MeshUploader.cxx:    const std::vector<PendingUpload> &garbage)
MeshUploader.cxx:{
MeshUploader.cxx:    endSingleTimeCommands(
MeshUploader.cxx:        vkContext.device,
MeshUploader.cxx:        vkContext.graphicsQueue,
MeshUploader.cxx:        vkContext.commandPool,
MeshUploader.cxx:        cmd);
MeshUploader.cxx:
MeshUploader.cxx:    for (const auto &g : garbage)
MeshUploader.cxx:    {
MeshUploader.cxx:        vkDestroyBuffer(vkContext.device, g.buffer, nullptr);
MeshUploader.cxx:        vkFreeMemory(vkContext.device, g.memory, nullptr);
MeshUploader.cxx:    }
MeshUploader.cxx:}
