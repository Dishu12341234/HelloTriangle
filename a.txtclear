include/stb-master/stb_truetype.h:static void stbtt__buf_skip(stbtt__buf *b, int o)
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   stbtt__buf_seek(b, b->cursor + o);
include/stb-master/stb_truetype.h:}
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:static stbtt_uint32 stbtt__buf_get(stbtt__buf *b, int n)
include/stb-master/stb_truetype.h:{
include/stb-master/stb_truetype.h:   stbtt_uint32 v = 0;
include/stb-master/stb_truetype.h:   int i;
include/stb-master/stb_truetype.h:   STBTT_assert(n >= 1 && n <= 4);
include/stb-master/stb_truetype.h:   for (i = 0; i < n; i++)
include/stb-master/stb_truetype.h:      v = (v << 8) | stbtt__buf_get8(b);
include/stb-master/stb_truetype.h:   return v;
include/stb-master/stb_truetype.h:}
