include/stb-master/stb_image.h:#ifndef STBI_INCLUDE_STB_IMAGE_H
include/stb-master/stb_image.h:#define STBI_INCLUDE_STB_IMAGE_H
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:// DOCUMENTATION
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Limitations:
include/stb-master/stb_image.h://    - no 12-bit-per-channel JPEG
include/stb-master/stb_image.h://    - no JPEGs with arithmetic coding
include/stb-master/stb_image.h://    - GIF always returns *comp=4
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Basic usage (see HDR discussion below for HDR usage):
include/stb-master/stb_image.h://    int x,y,n;
include/stb-master/stb_image.h://    unsigned char *data = stbi_load(filename, &x, &y, &n, 0);
include/stb-master/stb_image.h://    // ... process data if not NULL ...
include/stb-master/stb_image.h://    // ... x = width, y = height, n = # 8-bit components per pixel ...
include/stb-master/stb_image.h://    // ... replace '0' with '1'..'4' to force that many components per pixel
include/stb-master/stb_image.h://    // ... but 'n' will always be the number that it would have been if you said 0
include/stb-master/stb_image.h://    stbi_image_free(data);
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Standard parameters:
include/stb-master/stb_image.h://    int *x                 -- outputs image width in pixels
include/stb-master/stb_image.h://    int *y                 -- outputs image height in pixels
include/stb-master/stb_image.h://    int *channels_in_file  -- outputs # of image components in image file
include/stb-master/stb_image.h://    int desired_channels   -- if non-zero, # of image components requested in result
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// The return value from an image loader is an 'unsigned char *' which points
include/stb-master/stb_image.h:// to the pixel data, or NULL on an allocation failure or if the image is
include/stb-master/stb_image.h:// corrupt or invalid. The pixel data consists of *y scanlines of *x pixels,
include/stb-master/stb_image.h:// with each pixel consisting of N interleaved 8-bit components; the first
include/stb-master/stb_image.h:// pixel pointed to is top-left-most in the image. There is no padding between
include/stb-master/stb_image.h:// image scanlines or between pixels, regardless of format. The number of
include/stb-master/stb_image.h:// components N is 'desired_channels' if desired_channels is non-zero, or
include/stb-master/stb_image.h:// *channels_in_file otherwise. If desired_channels is non-zero,
include/stb-master/stb_image.h:// *channels_in_file has the number of components that _would_ have been
include/stb-master/stb_image.h:// output otherwise. E.g. if you set desired_channels to 4, you will always
include/stb-master/stb_image.h:// get RGBA output, but you can check *channels_in_file to see if it's trivially
include/stb-master/stb_image.h:// opaque because e.g. there were only 3 channels in the source image.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// An output image with N components has the following components interleaved
include/stb-master/stb_image.h:// in this order in each pixel:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://     N=#comp     components
include/stb-master/stb_image.h://       1           grey
include/stb-master/stb_image.h://       2           grey, alpha
include/stb-master/stb_image.h://       3           red, green, blue
include/stb-master/stb_image.h://       4           red, green, blue, alpha
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// If image loading fails for any reason, the return value will be NULL,
include/stb-master/stb_image.h:// and *x, *y, *channels_in_file will be unchanged. The function
include/stb-master/stb_image.h:// stbi_failure_reason() can be queried for an extremely brief, end-user
include/stb-master/stb_image.h:// unfriendly explanation of why the load failed. Define STBI_NO_FAILURE_STRINGS
include/stb-master/stb_image.h:// to avoid compiling these strings at all, and STBI_FAILURE_USERMSG to get slightly
include/stb-master/stb_image.h:// more user-friendly ones.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Paletted PNG, BMP, GIF, and PIC images are automatically depalettized.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// To query the width, height and component count of an image without having to
include/stb-master/stb_image.h:// decode the full file, you can use the stbi_info family of functions:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://   int x,y,n,ok;
include/stb-master/stb_image.h://   ok = stbi_info(filename, &x, &y, &n);
include/stb-master/stb_image.h://   // returns ok=1 and sets x, y, n if image is a supported format,
include/stb-master/stb_image.h://   // 0 otherwise.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Note that stb_image pervasively uses ints in its public API for sizes,
include/stb-master/stb_image.h:// including sizes of memory buffers. This is now part of the API and thus
include/stb-master/stb_image.h:// hard to change without causing breakage. As a result, the various image
include/stb-master/stb_image.h:// loaders all have certain limits on image size; these differ somewhat
include/stb-master/stb_image.h:// by format but generally boil down to either just under 2GB or just under
include/stb-master/stb_image.h:// 1GB. When the decoded image would be larger than this, stb_image decoding
include/stb-master/stb_image.h:// will fail.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Additionally, stb_image will reject image files that have any of their
include/stb-master/stb_image.h:// dimensions set to a larger value than the configurable STBI_MAX_DIMENSIONS,
include/stb-master/stb_image.h:// which defaults to 2**24 = 16777216 pixels. Due to the above memory limit,
include/stb-master/stb_image.h:// the only way to have an image with such dimensions load correctly
include/stb-master/stb_image.h:// is for it to have a rather extreme aspect ratio. Either way, the
include/stb-master/stb_image.h:// assumption here is that such larger images are likely to be malformed
include/stb-master/stb_image.h:// or malicious. If you do need to load an image with individual dimensions
include/stb-master/stb_image.h:// larger than that, and it still fits in the overall size limit, you can
include/stb-master/stb_image.h:// #define STBI_MAX_DIMENSIONS on your own to be something larger.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// UNICODE:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://   If compiling for Windows and you wish to use Unicode filenames, compile
include/stb-master/stb_image.h://   with
include/stb-master/stb_image.h://       #define STBI_WINDOWS_UTF8
include/stb-master/stb_image.h://   and pass utf8-encoded filenames. Call stbi_convert_wchar_to_utf8 to convert
include/stb-master/stb_image.h://   Windows wchar_t filenames to utf8.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Philosophy
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// stb libraries are designed with the following priorities:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://    1. easy to use
include/stb-master/stb_image.h://    2. easy to maintain
include/stb-master/stb_image.h://    3. good performance
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Sometimes I let "good performance" creep up in priority over "easy to maintain",
include/stb-master/stb_image.h:// and for best performance I may provide less-easy-to-use APIs that give higher
include/stb-master/stb_image.h:// performance, in addition to the easy-to-use ones. Nevertheless, it's important
include/stb-master/stb_image.h:// to keep in mind that from the standpoint of you, a client of this library,
include/stb-master/stb_image.h:// all you care about is #1 and #3, and stb libraries DO NOT emphasize #3 above all.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Some secondary priorities arise directly from the first two, some of which
include/stb-master/stb_image.h:// provide more explicit reasons why performance can't be emphasized.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://    - Portable ("ease of use")
include/stb-master/stb_image.h://    - Small source code footprint ("easy to maintain")
include/stb-master/stb_image.h://    - No dependencies ("ease of use")
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// I/O callbacks
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// I/O callbacks allow you to read from arbitrary sources, like packaged
include/stb-master/stb_image.h:// files or some other source. Data read from callbacks are processed
include/stb-master/stb_image.h:// through a small internal buffer (currently 128 bytes) to try to reduce
include/stb-master/stb_image.h:// overhead.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// The three functions you must define are "read" (reads some bytes of data),
include/stb-master/stb_image.h:// "skip" (skips some bytes of data), "eof" (reports if the stream is at the end).
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// SIMD support
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// The JPEG decoder will try to automatically use SIMD kernels on x86 when
include/stb-master/stb_image.h:// supported by the compiler. For ARM Neon support, you must explicitly
include/stb-master/stb_image.h:// request it.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// (The old do-it-yourself SIMD API is no longer supported in the current
include/stb-master/stb_image.h:// code.)
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// On x86, SSE2 will automatically be used when available based on a run-time
include/stb-master/stb_image.h:// test; if not, the generic C versions are used as a fall-back. On ARM targets,
include/stb-master/stb_image.h:// the typical path is to have separate builds for NEON and non-NEON devices
include/stb-master/stb_image.h:// (at least this is true for iOS and Android). Therefore, the NEON support is
include/stb-master/stb_image.h:// toggled by a build flag: define STBI_NEON to get NEON loops.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// If for some reason you do not want to use any of SIMD code, or if
include/stb-master/stb_image.h:// you have issues compiling it, you can disable it entirely by
include/stb-master/stb_image.h:// defining STBI_NO_SIMD.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// HDR image support   (disable by defining STBI_NO_HDR)
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// stb_image supports loading HDR images in general, and currently the Radiance
include/stb-master/stb_image.h:// .HDR file format specifically. You can still load any file through the existing
include/stb-master/stb_image.h:// interface; if you attempt to load an HDR file, it will be automatically remapped
include/stb-master/stb_image.h:// to LDR, assuming gamma 2.2 and an arbitrary scale factor defaulting to 1;
include/stb-master/stb_image.h:// both of these constants can be reconfigured through this interface:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://     stbi_hdr_to_ldr_gamma(2.2f);
include/stb-master/stb_image.h://     stbi_hdr_to_ldr_scale(1.0f);
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// (note, do not use _inverse_ constants; stbi_image will invert them
include/stb-master/stb_image.h:// appropriately).
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Additionally, there is a new, parallel interface for loading files as
include/stb-master/stb_image.h:// (linear) floats to preserve the full dynamic range:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://    float *data = stbi_loadf(filename, &x, &y, &n, 0);
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// If you load LDR images through this interface, those images will
include/stb-master/stb_image.h:// be promoted to floating point values, run through the inverse of
include/stb-master/stb_image.h:// constants corresponding to the above:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://     stbi_ldr_to_hdr_scale(1.0f);
include/stb-master/stb_image.h://     stbi_ldr_to_hdr_gamma(2.2f);
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Finally, given a filename (or an open file or memory block--see header
include/stb-master/stb_image.h:// file for details) containing image data, you can query for the "most
include/stb-master/stb_image.h:// appropriate" interface to use (that is, whether the image is HDR or
include/stb-master/stb_image.h:// not), using:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://     stbi_is_hdr(char *filename);
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// iPhone PNG support:
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// We optionally support converting iPhone-formatted PNGs (which store
include/stb-master/stb_image.h:// premultiplied BGRA) back to RGB, even though they're internally encoded
include/stb-master/stb_image.h:// differently. To enable this conversion, call
include/stb-master/stb_image.h:// stbi_convert_iphone_png_to_rgb(1).
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// Call stbi_set_unpremultiply_on_load(1) as well to force a divide per
include/stb-master/stb_image.h:// pixel to remove any premultiplied alpha *only* if the image file explicitly
include/stb-master/stb_image.h:// says there's premultiplied data (currently only happens in iPhone images,
include/stb-master/stb_image.h:// and only if iPhone convert-to-rgb processing is on).
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ===========================================================================
include/stb-master/stb_image.h://
include/stb-master/stb_image.h:// ADDITIONAL CONFIGURATION
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://  - You can suppress implementation of any of the decoders to reduce
include/stb-master/stb_image.h://    your code footprint by #defining one or more of the following
include/stb-master/stb_image.h://    symbols before creating the implementation.
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://        STBI_NO_JPEG
include/stb-master/stb_image.h://        STBI_NO_PNG
include/stb-master/stb_image.h://        STBI_NO_BMP
include/stb-master/stb_image.h://        STBI_NO_PSD
include/stb-master/stb_image.h://        STBI_NO_TGA
include/stb-master/stb_image.h://        STBI_NO_GIF
include/stb-master/stb_image.h://        STBI_NO_HDR
include/stb-master/stb_image.h://        STBI_NO_PIC
include/stb-master/stb_image.h://        STBI_NO_PNM   (.ppm and .pgm)
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://  - You can request *only* certain decoders and suppress all other ones
include/stb-master/stb_image.h://    (this will be more forward-compatible, as addition of new decoders
include/stb-master/stb_image.h://    doesn't require you to disable them explicitly):
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://        STBI_ONLY_JPEG
include/stb-master/stb_image.h://        STBI_ONLY_PNG
include/stb-master/stb_image.h://        STBI_ONLY_BMP
include/stb-master/stb_image.h://        STBI_ONLY_PSD
include/stb-master/stb_image.h://        STBI_ONLY_TGA
include/stb-master/stb_image.h://        STBI_ONLY_GIF
include/stb-master/stb_image.h://        STBI_ONLY_HDR
include/stb-master/stb_image.h://        STBI_ONLY_PIC
include/stb-master/stb_image.h://        STBI_ONLY_PNM   (.ppm and .pgm)
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://   - If you use STBI_NO_PNG (or _ONLY_ without PNG), and you still
include/stb-master/stb_image.h://     want the zlib decoder to be available, #define STBI_SUPPORT_ZLIB
include/stb-master/stb_image.h://
include/stb-master/stb_image.h://  - If you define STBI_MAX_DIMENSIONS, stb_image will reject images greater
include/stb-master/stb_image.h://    than that size (in either width or height) without further processing.
include/stb-master/stb_image.h://    This is to let programs in the wild set an upper bound to prevent
include/stb-master/stb_image.h://    denial-of-service attacks on untrusted data, as one could generate a
include/stb-master/stb_image.h://    valid image of gigantic dimensions and force stb_image to allocate a
include/stb-master/stb_image.h://    huge block of memory and spend disproportionate time decoding it. By
include/stb-master/stb_image.h://    default this is set to (1 << 24), which is 16777216, but that's still
include/stb-master/stb_image.h://    very big.
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:#ifndef STBI_NO_STDIO
include/stb-master/stb_image.h:#include <stdio.h>
include/stb-master/stb_image.h:#endif // STBI_NO_STDIO
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:#define STBI_VERSION 1
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:enum
include/stb-master/stb_image.h:{
include/stb-master/stb_image.h:   STBI_default = 0, // only used for desired_channels
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:   STBI_grey       = 1,
include/stb-master/stb_image.h:   STBI_grey_alpha = 2,
include/stb-master/stb_image.h:   STBI_rgb        = 3,
include/stb-master/stb_image.h:   STBI_rgb_alpha  = 4
include/stb-master/stb_image.h:};
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:#include <stdlib.h>
include/stb-master/stb_image.h:typedef unsigned char stbi_uc;
include/stb-master/stb_image.h:typedef unsigned short stbi_us;
include/stb-master/stb_image.h:
include/stb-master/stb_image.h:#ifdef __cplusplus
include/stb-master/stb_image.h:extern "C" {
include/stb-master/stb_image.h:#endif
include/stb-master/stb_image.h:
