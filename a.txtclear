Event.cxx:Event::Event(GLFWwindow &window) : window{window}
Event.cxx:{
Event.cxx:    glfwSetKeyCallback(&window, Event::keyPressedCallback);
Event.cxx:    glfwSetCursorPosCallback(&window, Event::cursorPositionCallback);
Event.cxx:    if (glfwRawMouseMotionSupported())
Event.cxx:    {
Event.cxx:        glfwSetInputMode(&window, GLFW_RAW_MOUSE_MOTION, GLFW_TRUE);
Event.cxx:        std::cout << "RawInput" << std::endl;
Event.cxx:    }
Event.cxx:}
Event.cxx:
Event.cxx:void Event::keyPressedCallback(GLFWwindow *window, int key, int scancode, int action, int mods)
Event.cxx:{
Event.cxx:
Event.cxx:    if (action == GLFW_REPEAT)
Event.cxx:        return;
Event.cxx:    Event *event = static_cast<Event *>(glfwGetWindowUserPointer(window));
Event.cxx:    if (!event)
Event.cxx:        return;
Event.cxx:
Event.cxx:    event->lastKeyPressedInfo.key = key;
Event.cxx:    event->lastKeyPressedInfo.action = action;
Event.cxx:
Event.cxx:    event->keyDown[key] = (action == GLFW_PRESS);
Event.cxx:}
Event.cxx:void Event::cursorPositionCallback(GLFWwindow *window, double xpos, double ypos)
Event.cxx:{
Event.cxx:    Event *event = static_cast<Event *>(glfwGetWindowUserPointer(window));
Event.cxx:    if (!event)
Event.cxx:        return;
Event.cxx:
Event.cxx:    // std::cout << "MouseCB" << time(0) << std::endl;
Event.cxx:
Event.cxx:    event->mouseX = xpos;
Event.cxx:    event->mouseY = ypos;
Event.cxx:}
