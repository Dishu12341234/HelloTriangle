intiVk.cxx:void HelloTriangleApplication::pickPhysicalDevice()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Picking Physical Device..." << std::endl;
intiVk.cxx:    physicalDevice = VK_NULL_HANDLE; // this will be implicitly cleanup when VkInstance is destroid(no additoinal cleanup needed)
intiVk.cxx:
intiVk.cxx:    uint32_t deviceCount = 0;
intiVk.cxx:    vkEnumeratePhysicalDevices(instance, &deviceCount, nullptr);
intiVk.cxx:
intiVk.cxx:    if (deviceCount == 0)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to find GPUs that support Vulkan");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    std::vector<VkPhysicalDevice> devices(deviceCount);
intiVk.cxx:    vkEnumeratePhysicalDevices(instance, &deviceCount, devices.data());
intiVk.cxx:
intiVk.cxx:    std::multimap<int, VkPhysicalDevice> candidates;
intiVk.cxx:
intiVk.cxx:    for (const auto &device : devices)
intiVk.cxx:    {
intiVk.cxx:        int score = rateDeviceSuitablity(device);
intiVk.cxx:        candidates.insert(std::make_pair(score, device));
intiVk.cxx:        std::cout << "Score: " << score << std::endl;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    if (candidates.rbegin()->first > 0)
intiVk.cxx:    {
intiVk.cxx:        physicalDevice = candidates.rbegin()->second;
intiVk.cxx:        msaaSamples = getMaxUsableSampleCount();
intiVk.cxx:    }
intiVk.cxx:    else
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("Failed to find a suitable GPU");
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// right now we only allow to use dedicated cards the support geometry shaders
intiVk.cxx:// bool HelloTriangleApplication::isDeviceSuitable(VkPhysicalDevice device)
intiVk.cxx:// {
intiVk.cxx:
intiVk.cxx://     // this controls which type of GPU to allow
intiVk.cxx://     return deviceProperties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU && deviceFeatures.geometryShader;
intiVk.cxx:// }
intiVk.cxx:
intiVk.cxx:int HelloTriangleApplication::rateDeviceSuitablity(VkPhysicalDevice device)
intiVk.cxx:{
intiVk.cxx:    VkPhysicalDeviceProperties props;
intiVk.cxx:    VkPhysicalDeviceFeatures feats;
intiVk.cxx:    vkGetPhysicalDeviceProperties(device, &props);
intiVk.cxx:    vkGetPhysicalDeviceFeatures(device, &feats);
intiVk.cxx:
intiVk.cxx:    int score = 0;
intiVk.cxx:
intiVk.cxx:    std::cout << "Device: " << props.deviceName << std::endl;
intiVk.cxx:
intiVk.cxx:    // Prefer discrete or integrated GPU
intiVk.cxx:    if (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU)
intiVk.cxx:        score += 10000;
intiVk.cxx:    else if (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU)
intiVk.cxx:        score += 5000;
intiVk.cxx:
intiVk.cxx:    // Bigger textures = better
intiVk.cxx:    score += props.limits.maxImageDimension2D;
intiVk.cxx:
intiVk.cxx:    // Useful features
intiVk.cxx:    if (feats.samplerAnisotropy)
intiVk.cxx:        score += 1000;
intiVk.cxx:    if (feats.shaderInt64)
intiVk.cxx:        score += 500;
intiVk.cxx:    if (feats.wideLines)
intiVk.cxx:        score += 300;
intiVk.cxx:
intiVk.cxx:#ifdef __APPLE__
intiVk.cxx:    // Metal backend doesn’t support geometry/tessellation shaders
intiVk.cxx:    score += 1500;
intiVk.cxx:#else
intiVk.cxx:    if (!feats.geometryShader)
intiVk.cxx:        return 0; // skip if no geometry shader
intiVk.cxx:#endif
intiVk.cxx:
intiVk.cxx:    return score;
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Queue -> a line in which a set of commands needs to be executed
intiVk.cxx:// there maybe multiple types of queues(Graphics, Computem, ...)
intiVk.cxx:// Queue Family -> Conatains multiple queues for the GPU(Note: A queue family must be homogenous)
intiVk.cxx:
intiVk.cxx:// finding queue families
intiVk.cxx:HelloTriangleApplication::QueueFamilyIndices HelloTriangleApplication::findQueueFamilies(VkPhysicalDevice device)
intiVk.cxx:{
intiVk.cxx:    QueueFamilyIndices indices;
intiVk.cxx:    uint32_t queueFamilyCount = 0;
intiVk.cxx:    vkGetPhysicalDeviceQueueFamilyProperties(device, &queueFamilyCount, nullptr); // grts all the queue families supported by the GPU
intiVk.cxx:
intiVk.cxx:    std::vector<VkQueueFamilyProperties> queueFamilies(queueFamilyCount);
intiVk.cxx:    vkGetPhysicalDeviceQueueFamilyProperties(device, &queueFamilyCount, queueFamilies.data());
intiVk.cxx:
intiVk.cxx:    int i = 0;
intiVk.cxx:    for (const auto &queueFamily : queueFamilies)
intiVk.cxx:    {
intiVk.cxx:        if (queueFamily.queueFlags & VK_QUEUE_GRAPHICS_BIT)
intiVk.cxx:            indices.graphicsFamily = i;
intiVk.cxx:
intiVk.cxx:        VkBool32 presentSupport = false;
intiVk.cxx:        vkGetPhysicalDeviceSurfaceSupportKHR(device, i, surface, &presentSupport);
intiVk.cxx:        if (presentSupport)
intiVk.cxx:            indices.presentFamily = i;
intiVk.cxx:
intiVk.cxx:        if (indices.isComplete())
intiVk.cxx:            break;
intiVk.cxx:
intiVk.cxx:        i++;
intiVk.cxx:    }
intiVk.cxx:    // NOTE: some GPU supports different graphics and presentation queues
intiVk.cxx:
intiVk.cxx:    return indices;
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Logical device -> A brige between the program and the GPU
intiVk.cxx:void HelloTriangleApplication::createLogicalDevice()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Logical Device..." << std::endl;
intiVk.cxx:    // Queue Family Stuff
intiVk.cxx:    QueueFamilyIndices indices = findQueueFamilies(physicalDevice); // get the required queue families
intiVk.cxx:    std::vector<VkDeviceQueueCreateInfo> queueCreateInfos;
intiVk.cxx:    std::set<uint32_t> uniqueQueueFamilies = {indices.graphicsFamily.value(), indices.presentFamily.value()};
intiVk.cxx:
intiVk.cxx:    // right now only creating a single queue(can create muliple)
intiVk.cxx:    float queuePriority = 1.f;
intiVk.cxx:    for (uint32_t queueFamily : uniqueQueueFamilies) // prepare each queue family
intiVk.cxx:    {
intiVk.cxx:        VkDeviceQueueCreateInfo queueCreateInfo{};
intiVk.cxx:        queueCreateInfo.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
intiVk.cxx:        queueCreateInfo.queueFamilyIndex = queueFamily;
intiVk.cxx:        queueCreateInfo.queueCount = 1;
intiVk.cxx:        queueCreateInfo.pQueuePriorities = &queuePriority;
intiVk.cxx:
intiVk.cxx:        queueCreateInfos.push_back(queueCreateInfo); // push the queue info in the vector
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // ---- Specifing which feature we wanna use ----
intiVk.cxx:    VkPhysicalDeviceFeatures deviceFeatures{};
intiVk.cxx:    deviceFeatures.samplerAnisotropy = VK_TRUE;
intiVk.cxx:    deviceFeatures.sampleRateShading = VK_TRUE;
intiVk.cxx:
intiVk.cxx:    VkDeviceCreateInfo createInfo{};
intiVk.cxx:    createInfo.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
intiVk.cxx:
intiVk.cxx:    createInfo.queueCreateInfoCount = static_cast<uint32_t>(queueCreateInfos.size());
intiVk.cxx:    createInfo.pQueueCreateInfos = queueCreateInfos.data();
intiVk.cxx:
intiVk.cxx:    createInfo.pEnabledFeatures = &deviceFeatures;
intiVk.cxx:
intiVk.cxx:#ifdef __APPLE__
intiVk.cxx:    deviceExtensions.push_back("VK_KHR_portability_subset");
intiVk.cxx:#else
intiVk.cxx:    deviceExtensions.push_back(VK_KHR_SWAPCHAIN_EXTENSION_NAME);
intiVk.cxx:#endif
intiVk.cxx:
intiVk.cxx:    createInfo.enabledExtensionCount = static_cast<uint32_t>(deviceExtensions.size());
intiVk.cxx:    createInfo.ppEnabledExtensionNames = deviceExtensions.data();
intiVk.cxx:
intiVk.cxx:    // Device specific validation layers
intiVk.cxx:    if (enableValidationLayers)
intiVk.cxx:    {
intiVk.cxx:        createInfo.enabledLayerCount = static_cast<uint32_t>(validationLayers.size());
intiVk.cxx:        createInfo.ppEnabledLayerNames = validationLayers.data();
intiVk.cxx:    }
intiVk.cxx:    else
intiVk.cxx:    {
intiVk.cxx:        createInfo.enabledLayerCount = 0;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    if (vkCreateDevice(physicalDevice, &createInfo, nullptr, &device) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("Faild to create logical device");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // ---- retrive the queues and store them into the class members ----
intiVk.cxx:    vkGetDeviceQueue(device, indices.graphicsFamily.value(), 0, &graphicsQueue);
intiVk.cxx:    vkGetDeviceQueue(device, indices.presentFamily.value(), 0, &presentQueue);
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// this is never called because I have rateDeviceSutablity
intiVk.cxx:// this is just redundent
intiVk.cxx:bool HelloTriangleApplication::isDeviceSuitable(VkPhysicalDevice device)
intiVk.cxx:{
intiVk.cxx:    QueueFamilyIndices indices = findQueueFamilies(device);
intiVk.cxx:
intiVk.cxx:    bool extensionsSupported = checkDeviceExtensionSupport(device);
intiVk.cxx:
intiVk.cxx:    bool swapChainAdequate = false;
intiVk.cxx:    if (extensionsSupported)
intiVk.cxx:    {
intiVk.cxx:        SwapChainSupportDetails swapChainSupport = querySwapChainSupport(device);
intiVk.cxx:        swapChainAdequate = !swapChainSupport.formats.empty() && !swapChainSupport.presentModes.empty();
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    return indices.isComplete() && extensionsSupported && swapChainAdequate;
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:bool HelloTriangleApplication::checkDeviceExtensionSupport(VkPhysicalDevice device)
intiVk.cxx:{
intiVk.cxx:    // ---- counting the number of extensions ----
intiVk.cxx:    uint32_t extensionCount;
intiVk.cxx:    vkEnumerateDeviceExtensionProperties(device, nullptr, &extensionCount, nullptr);
intiVk.cxx:
intiVk.cxx:    std::vector<VkExtensionProperties> availableExtansions(extensionCount);
intiVk.cxx:    vkEnumerateDeviceExtensionProperties(device, nullptr, &extensionCount, availableExtansions.data()); // all the required extensions are now retrived
intiVk.cxx:
intiVk.cxx:    std::set<std::string> requiredExtensions(deviceExtensions.begin(), deviceExtensions.end());
intiVk.cxx:
intiVk.cxx:    for (const auto &extension : availableExtansions)
intiVk.cxx:    {
intiVk.cxx:        requiredExtensions.erase(extension.extensionName);
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // if all the required extensions are supported then the 'requiredExtension' vector is empty
intiVk.cxx:    // which returns true
intiVk.cxx:    return requiredExtensions.empty();
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Swapchain -> A queue of images presented to the screen in a sequence
intiVk.cxx:// Draw to an offscreen -> present it to the current window -> repeat
intiVk.cxx:
intiVk.cxx:// This function asks the GPU about the capablitie of the SwapChain that this GPU has
intiVk.cxx:HelloTriangleApplication::SwapChainSupportDetails HelloTriangleApplication::querySwapChainSupport(VkPhysicalDevice device)
intiVk.cxx:{
intiVk.cxx:    SwapChainSupportDetails details;
intiVk.cxx:
intiVk.cxx:    // ---- Get the capabilities ----
intiVk.cxx:    vkGetPhysicalDeviceSurfaceCapabilitiesKHR(device, surface, &details.capabilities);
intiVk.cxx:
intiVk.cxx:    // ---- get the format ----
intiVk.cxx:    uint32_t formatCount;
intiVk.cxx:    vkGetPhysicalDeviceSurfaceFormatsKHR(device, surface, &formatCount, nullptr);
intiVk.cxx:
intiVk.cxx:    if (formatCount != 0)
intiVk.cxx:    {
intiVk.cxx:        details.formats.resize(formatCount);
intiVk.cxx:        vkGetPhysicalDeviceSurfaceFormatsKHR(device, surface, &formatCount, details.formats.data());
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // ---- get the presentation mode(vsync, mailbox ...) ----
intiVk.cxx:    uint32_t presentModeCount;
intiVk.cxx:    vkGetPhysicalDeviceSurfacePresentModesKHR(device, surface, &presentModeCount, nullptr);
intiVk.cxx:
intiVk.cxx:    if (presentModeCount != 0)
intiVk.cxx:    {
intiVk.cxx:        vkGetPhysicalDeviceSurfacePresentModesKHR(device, surface, &presentModeCount, details.presentModes.data());
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    return details;
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// A swap suface define how pixels are stored(RGB vs BRGA or linear vs sRGB)
intiVk.cxx:VkSurfaceFormatKHR HelloTriangleApplication::chooseSwapSurfaceFormat(const std::vector<VkSurfaceFormatKHR> &availableFormats)
intiVk.cxx:{
intiVk.cxx:    {
intiVk.cxx:        for (const auto &availableFormat : availableFormats)
intiVk.cxx:        {
intiVk.cxx:            if (availableFormat.format == VK_FORMAT_B8G8R8A8_SRGB && availableFormat.colorSpace == VK_COLORSPACE_SRGB_NONLINEAR_KHR)
intiVk.cxx:            {
intiVk.cxx:                return availableFormat;
intiVk.cxx:            }
intiVk.cxx:        }
intiVk.cxx:
intiVk.cxx:        return availableFormats.at(0);
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// this specifies how to presnet the images to the screen (vsync or mailbox or normal)
intiVk.cxx:VkPresentModeKHR HelloTriangleApplication::chooseSwapPresentMode(const std::vector<VkPresentModeKHR> &availablePresentModes)
intiVk.cxx:{
intiVk.cxx:    {
intiVk.cxx:        for (const auto &availablePresentMode : availablePresentModes)
intiVk.cxx:        {
intiVk.cxx:            if (availablePresentMode == VK_PRESENT_MODE_MAILBOX_KHR)
intiVk.cxx:            {
intiVk.cxx:                return availablePresentMode;
intiVk.cxx:            }
intiVk.cxx:        }
intiVk.cxx:
intiVk.cxx:        return VK_PRESENT_MODE_FIFO_KHR;
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Extent defines the resolution of the image
intiVk.cxx:// MacOS has a fixed extent while other windowing systems have a varible extent which is clamped to the window bounds
intiVk.cxx:// also High-DPI displays like Apple Liquid Retina displays have to be configure in a sepreate way
intiVk.cxx:VkExtent2D HelloTriangleApplication::chooseSwapExtent(const VkSurfaceCapabilitiesKHR &capabilities)
intiVk.cxx:{
intiVk.cxx:#ifdef __APPLE__
intiVk.cxx:    // MoltenVK on macOS (Retina-safe)
intiVk.cxx:    int width, height;
intiVk.cxx:    glfwGetFramebufferSize(_window, &width, &height);
intiVk.cxx:
intiVk.cxx:    VkExtent2D actualExtent = {
intiVk.cxx:        static_cast<uint32_t>(width),
intiVk.cxx:        static_cast<uint32_t>(height)};
intiVk.cxx:
intiVk.cxx:    return actualExtent; // Always use framebuffer size on Retina
intiVk.cxx:#else
intiVk.cxx:    // Metal IE: the size is predifined and is not UINT 32 max. therefore, use the size provided by the system
intiVk.cxx:    if (capabilities.currentExtent.width != std::numeric_limits<uint32_t>::max())
intiVk.cxx:    {
intiVk.cxx:        return capabilities.currentExtent;
intiVk.cxx:    }
intiVk.cxx:    // The surface does not have a fixed size and you must create it by yourself
intiVk.cxx:    else
intiVk.cxx:    {
intiVk.cxx:        int width, height;
intiVk.cxx:        glfwGetFramebufferSize(_window, &width, &height);
intiVk.cxx:
intiVk.cxx:        VkExtent2D actualExtent =
intiVk.cxx:            {
intiVk.cxx:                static_cast<uint32_t>(width),
intiVk.cxx:                static_cast<uint32_t>(height)};
intiVk.cxx:
intiVk.cxx:        actualExtent.width = std::clamp(actualExtent.width, capabilities.minImageExtent.width, capabilities.maxImageExtent.width);
intiVk.cxx:
intiVk.cxx:        actualExtent.height = std::clamp(actualExtent.height, capabilities.minImageExtent.height, capabilities.maxImageExtent.height);
intiVk.cxx:
intiVk.cxx:        return actualExtent;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:#endif
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// In a swapchain we only use color images as that is all the is need to simply draw on the screen
intiVk.cxx:// Depth buffers and other stuff is handled in other places
intiVk.cxx:void HelloTriangleApplication::createSwapChain()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Swap Chain..." << std::endl;
intiVk.cxx:    // ---- get the swapchain capabilities
intiVk.cxx:    SwapChainSupportDetails swapChainSupport = querySwapChainSupport(physicalDevice);
intiVk.cxx:
intiVk.cxx:    // pick the best options
intiVk.cxx:    VkSurfaceFormatKHR surfaceFormat = chooseSwapSurfaceFormat(swapChainSupport.formats);
intiVk.cxx:    VkPresentModeKHR presentMode = chooseSwapPresentMode(swapChainSupport.presentModes);
intiVk.cxx:    VkExtent2D extent = chooseSwapExtent(swapChainSupport.capabilities);
intiVk.cxx:
intiVk.cxx:    // ---- save the format and extent ----
intiVk.cxx:    swapChainImageFormat = surfaceFormat.format;
intiVk.cxx:    swapChainExtent = extent;
intiVk.cxx:
intiVk.cxx:    // add one to allow triple buffering
intiVk.cxx:    // Metal limits the max to 3 so only +1 one is allowed while NVIDIA and AMD has no limits
intiVk.cxx:    uint32_t imageCount = swapChainSupport.capabilities.minImageCount + 1;
intiVk.cxx:
intiVk.cxx:    // Check to not exeed the maximum
intiVk.cxx:    // 0 is a special number meaning that there is not upper limit
intiVk.cxx:    if (swapChainSupport.capabilities.maxImageCount > 0 && imageCount > swapChainSupport.capabilities.maxImageCount)
intiVk.cxx:    {
intiVk.cxx:        imageCount = swapChainSupport.capabilities.maxImageCount;
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    VkSwapchainCreateInfoKHR createInfo{};
intiVk.cxx:    createInfo.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
intiVk.cxx:    createInfo.surface = surface; // surface
intiVk.cxx:
intiVk.cxx:    // ---- Image settings ----
intiVk.cxx:    createInfo.minImageCount = imageCount;
intiVk.cxx:    createInfo.imageFormat = surfaceFormat.format;
intiVk.cxx:    createInfo.imageColorSpace = surfaceFormat.colorSpace;
intiVk.cxx:    createInfo.imageExtent = extent;
intiVk.cxx:    createInfo.imageArrayLayers = 1;
intiVk.cxx:    createInfo.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT; // for post VFX use VK_IMAGE_TRANSFER_DST_BIT
intiVk.cxx:
intiVk.cxx:    // ---- graphics and present queue familiy equality check
intiVk.cxx:    QueueFamilyIndices indices = findQueueFamilies(physicalDevice);
intiVk.cxx:    uint32_t queueFamilyIndices[] = {indices.graphicsFamily.value(), indices.presentFamily.value()};
intiVk.cxx:
intiVk.cxx:    // If not same then use concurrent which means that we dont have to worry about the manual ownership
intiVk.cxx:    // If same then use exclusive which is faster
intiVk.cxx:    if (indices.graphicsFamily != indices.presentFamily)
intiVk.cxx:    {
intiVk.cxx:        createInfo.imageSharingMode = VK_SHARING_MODE_CONCURRENT;
intiVk.cxx:        createInfo.queueFamilyIndexCount = 2;
intiVk.cxx:        createInfo.pQueueFamilyIndices = queueFamilyIndices;
intiVk.cxx:    }
intiVk.cxx:    else
intiVk.cxx:    {
intiVk.cxx:        createInfo.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
intiVk.cxx:        createInfo.queueFamilyIndexCount = 0;     // Optional
intiVk.cxx:        createInfo.pQueueFamilyIndices = nullptr; // Optional
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // how to transform the present
intiVk.cxx:    // IE: tell vulkan how to handle rotations. We just use what the windowing system provides
intiVk.cxx:    createInfo.preTransform = swapChainSupport.capabilities.currentTransform;
intiVk.cxx:    createInfo.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR; // how shall this window blend with other windows
intiVk.cxx:
intiVk.cxx:    createInfo.presentMode = presentMode;
intiVk.cxx:    createInfo.clipped = VK_TRUE; // don't care about the pixels that are not seen on the screen
intiVk.cxx:
intiVk.cxx:    createInfo.oldSwapchain = VK_NULL_HANDLE; // later stuff
intiVk.cxx:
intiVk.cxx:    if (vkCreateSwapchainKHR(device, &createInfo, nullptr, &swapChain) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to create swap chain!");
intiVk.cxx:    }
intiVk.cxx:
intiVk.cxx:    // ---- Retrive the images ----
intiVk.cxx:    vkGetSwapchainImagesKHR(device, swapChain, &imageCount, nullptr);
intiVk.cxx:    swapChainImages.resize(imageCount);
intiVk.cxx:    vkGetSwapchainImagesKHR(device, swapChain, &imageCount, swapChainImages.data());
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Images views: VkImage is just raw memory. Image views provide the GPU with all the neseccary context and information to present the data correctly
intiVk.cxx:// We did specify in the swapchain what formats and options to use, then why an image view?
intiVk.cxx:// Because a VkImage by itself proved no indication of the location and size of the contents
intiVk.cxx:// An Image view providies those important information to the GPU
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::createImageViews()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Image Views..." << std::endl;
intiVk.cxx:    swapChainImageViews.resize(swapChainImages.size());
intiVk.cxx:
intiVk.cxx:    for (size_t i = 0; i < swapChainImages.size(); i++)
intiVk.cxx:    {
intiVk.cxx:        VkImageViewCreateInfo createInfo{};
intiVk.cxx:        createInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
intiVk.cxx:        createInfo.image = swapChainImages[i];
intiVk.cxx:
intiVk.cxx:        // specifing how shall the images be interpreted
intiVk.cxx:        createInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
intiVk.cxx:        createInfo.format = swapChainImageFormat;
intiVk.cxx:
intiVk.cxx:        // mapping the color channels to defaults
intiVk.cxx:        // VK_COMPONENT_SWIZZLE_IDENTITY → use the original channel layout.
intiVk.cxx:        createInfo.components.r = VK_COMPONENT_SWIZZLE_IDENTITY;
intiVk.cxx:        createInfo.components.g = VK_COMPONENT_SWIZZLE_IDENTITY;
intiVk.cxx:        createInfo.components.b = VK_COMPONENT_SWIZZLE_IDENTITY;
intiVk.cxx:        createInfo.components.a = VK_COMPONENT_SWIZZLE_IDENTITY;
intiVk.cxx:
intiVk.cxx:        // specifing how shall the images be use(their purpose)
intiVk.cxx:        createInfo.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; // color targets
intiVk.cxx:        createInfo.subresourceRange.baseMipLevel = 0;
intiVk.cxx:        createInfo.subresourceRange.levelCount = 1;
intiVk.cxx:        createInfo.subresourceRange.baseArrayLayer = 0;
intiVk.cxx:        createInfo.subresourceRange.layerCount = 1;
intiVk.cxx:
intiVk.cxx:        if (vkCreateImageView(device, &createInfo, nullptr, &swapChainImageViews[i]) != VK_SUCCESS)
intiVk.cxx:        {
intiVk.cxx:            throw std::runtime_error("Failed to create image views");
intiVk.cxx:        }
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:// Render pass
intiVk.cxx:// It tells vulkan what attachment to use
intiVk.cxx:// How to use
intiVk.cxx:// Layout transitions
intiVk.cxx:void HelloTriangleApplication::createRenderPass()
intiVk.cxx:{
intiVk.cxx:    std::cout << "Creating Render Pass..." << std::endl;
intiVk.cxx:    // ---- describing what rescources we will be using ----
intiVk.cxx:    VkAttachmentDescription depthAttachment{};
intiVk.cxx:    depthAttachment.format = VK_FORMAT_D32_SFLOAT;
intiVk.cxx:    depthAttachment.samples = msaaSamples;
intiVk.cxx:    depthAttachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
intiVk.cxx:    depthAttachment.storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
intiVk.cxx:    depthAttachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
intiVk.cxx:    depthAttachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
intiVk.cxx:    depthAttachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
intiVk.cxx:    depthAttachment.finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
intiVk.cxx:
intiVk.cxx:    VkAttachmentReference depthAttachmentRef{};
intiVk.cxx:    depthAttachmentRef.attachment = 1;
intiVk.cxx:    depthAttachmentRef.layout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
intiVk.cxx:
intiVk.cxx:    VkAttachmentDescription colorAttachment{};
intiVk.cxx:    colorAttachment.format = swapChainImageFormat;
intiVk.cxx:    colorAttachment.samples = msaaSamples;
intiVk.cxx:
intiVk.cxx:    colorAttachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;   // what to do with the framebuffer after the render pass has started
intiVk.cxx:    colorAttachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE; // what to do with the memory(store it in the vram or not)
intiVk.cxx:
intiVk.cxx:    // don't care about the stencil
intiVk.cxx:    colorAttachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
intiVk.cxx:    colorAttachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
intiVk.cxx:
intiVk.cxx:    colorAttachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
intiVk.cxx:    colorAttachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
intiVk.cxx:
intiVk.cxx:    VkAttachmentReference colorAttachmentRef{};
intiVk.cxx:    colorAttachmentRef.attachment = 0; // IDX to the attachment
intiVk.cxx:    colorAttachmentRef.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
intiVk.cxx:
intiVk.cxx:    VkAttachmentDescription colorAttachmentResolve{};
intiVk.cxx:    colorAttachmentResolve.format = swapChainImageFormat;
intiVk.cxx:    colorAttachmentResolve.samples = VK_SAMPLE_COUNT_1_BIT;
intiVk.cxx:    colorAttachmentResolve.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
intiVk.cxx:    colorAttachmentResolve.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
intiVk.cxx:    colorAttachmentResolve.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
intiVk.cxx:    colorAttachmentResolve.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
intiVk.cxx:    colorAttachmentResolve.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
intiVk.cxx:    colorAttachmentResolve.finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
intiVk.cxx:
intiVk.cxx:    VkAttachmentReference colorAttachmentResolveRef{};
intiVk.cxx:    colorAttachmentResolveRef.attachment = 2;
intiVk.cxx:    colorAttachmentResolveRef.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
intiVk.cxx:
intiVk.cxx:    VkSubpassDescription subpass{};
intiVk.cxx:    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS; // alternative is compute
intiVk.cxx:
intiVk.cxx:    subpass.colorAttachmentCount = 1;
intiVk.cxx:    subpass.pColorAttachments = &colorAttachmentRef;
intiVk.cxx:    subpass.pDepthStencilAttachment = &depthAttachmentRef;
intiVk.cxx:    subpass.pResolveAttachments = &colorAttachmentResolveRef;
intiVk.cxx:
intiVk.cxx:    std::array<VkAttachmentDescription, 3> attachments = {colorAttachment, depthAttachment, colorAttachmentResolve};
intiVk.cxx:    VkRenderPassCreateInfo renderPassInfo{};
intiVk.cxx:    renderPassInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
intiVk.cxx:    renderPassInfo.attachmentCount = static_cast<uint32_t>(attachments.size());
intiVk.cxx:    renderPassInfo.pAttachments = attachments.data();
intiVk.cxx:    renderPassInfo.subpassCount = 1;
intiVk.cxx:    renderPassInfo.pSubpasses = &subpass;
intiVk.cxx:
intiVk.cxx:    VkSubpassDependency dependency{};
intiVk.cxx:    dependency.srcSubpass = VK_SUBPASS_EXTERNAL;
intiVk.cxx:    dependency.dstSubpass = 0;
intiVk.cxx:
intiVk.cxx:    dependency.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
intiVk.cxx:    dependency.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
intiVk.cxx:    ;
intiVk.cxx:
intiVk.cxx:    dependency.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
intiVk.cxx:    dependency.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
intiVk.cxx:
intiVk.cxx:    renderPassInfo.dependencyCount = 1;
intiVk.cxx:    renderPassInfo.pDependencies = &dependency;
intiVk.cxx:
intiVk.cxx:    if (vkCreateRenderPass(device, &renderPassInfo, nullptr, &renderPass) != VK_SUCCESS)
intiVk.cxx:    {
intiVk.cxx:        throw std::runtime_error("failed to create render pass!");
intiVk.cxx:    }
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:VkCommandBuffer HelloTriangleApplication::beginSingleTimeCommands()
intiVk.cxx:{
intiVk.cxx:    VkCommandBufferAllocateInfo allocInfo{};
intiVk.cxx:    allocInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
intiVk.cxx:    allocInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
intiVk.cxx:    allocInfo.commandPool = commandPool;
intiVk.cxx:    allocInfo.commandBufferCount = 1;
intiVk.cxx:
intiVk.cxx:    VkCommandBuffer commandBuffer;
intiVk.cxx:    vkAllocateCommandBuffers(device, &allocInfo, &commandBuffer);
intiVk.cxx:
intiVk.cxx:    VkCommandBufferBeginInfo beginInfo{};
intiVk.cxx:    beginInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
intiVk.cxx:    beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
intiVk.cxx:
intiVk.cxx:    vkBeginCommandBuffer(commandBuffer, &beginInfo);
intiVk.cxx:
intiVk.cxx:    return commandBuffer;
intiVk.cxx:}
intiVk.cxx:
intiVk.cxx:void HelloTriangleApplication::endSingleTimeCommands(VkCommandBuffer commandBuffer)
intiVk.cxx:{
intiVk.cxx:    vkEndCommandBuffer(commandBuffer);
intiVk.cxx:
intiVk.cxx:    VkSubmitInfo submitInfo{};
intiVk.cxx:    submitInfo.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
intiVk.cxx:    submitInfo.commandBufferCount = 1;
intiVk.cxx:    submitInfo.pCommandBuffers = &commandBuffer;
intiVk.cxx:
intiVk.cxx:    vkQueueSubmit(graphicsQueue, 1, &submitInfo, VK_NULL_HANDLE);
intiVk.cxx:    vkQueueWaitIdle(graphicsQueue);
intiVk.cxx:
intiVk.cxx:    vkFreeCommandBuffers(device, commandPool, 1, &commandBuffer);
intiVk.cxx:}
