include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:// This is the data structure you fill out. Most of the arrays can be
include/stb-master/stb_voxel_render.h:// NULL, except when one is required to get the value to index another.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// The compass system used in the following descriptions is:
include/stb-master/stb_voxel_render.h://     east means increasing x
include/stb-master/stb_voxel_render.h://     north means increasing y
include/stb-master/stb_voxel_render.h://     up means increasing z
include/stb-master/stb_voxel_render.h:struct stbvox_input_description
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   unsigned char lighting_at_vertices;
include/stb-master/stb_voxel_render.h:   // The default is lighting values (i.e. ambient occlusion) are at block
include/stb-master/stb_voxel_render.h:   // center, and the vertex light is gathered from those adjacent block
include/stb-master/stb_voxel_render.h:   // centers that the vertex is facing. This makes smooth lighting
include/stb-master/stb_voxel_render.h:   // consistent across adjacent faces with the same orientation.
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // Setting this flag to non-zero gives you explicit control
include/stb-master/stb_voxel_render.h:   // of light at each vertex, but now the lighting/ao will be
include/stb-master/stb_voxel_render.h:   // shared by all vertices at the same point, even if they
include/stb-master/stb_voxel_render.h:   // have different normals.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   // these are mostly 3D maps you use to define your voxel world, using x_stride and y_stride
include/stb-master/stb_voxel_render.h:   // note that for cache efficiency, you want to use the block_foo palettes as much as possible instead
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   stbvox_rgb *rgb;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinate.
include/stb-master/stb_voxel_render.h:   // 24-bit voxel color for STBVOX_CONFIG_MODE = 20 or 21 only
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned char *lighting;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinate. The lighting value / ambient occlusion
include/stb-master/stb_voxel_render.h:   // value that is used to define the vertex lighting values.
include/stb-master/stb_voxel_render.h:   // The raw lighting values are defined at the center of blocks
include/stb-master/stb_voxel_render.h:   // (or at vertex if 'lighting_at_vertices' is true).
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // If the macro STBVOX_CONFIG_ROTATION_IN_LIGHTING is defined,
include/stb-master/stb_voxel_render.h:   // then an additional 2-bit block rotation value is stored
include/stb-master/stb_voxel_render.h:   // in this field as well.
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_LIGHTING_EXT(lighting,rot)--here
include/stb-master/stb_voxel_render.h:   // 'lighting' should still be 8 bits, as the macro will
include/stb-master/stb_voxel_render.h:   // discard the bottom bits automatically. Similarly, if
include/stb-master/stb_voxel_render.h:   // using STBVOX_CONFIG_VHEIGHT_IN_LIGHTING, encode with
include/stb-master/stb_voxel_render.h:   // STBVOX_MAKE_LIGHTING_EXT(lighting,vheight).
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // (Rationale: rotation needs to be independent of blocktype,
include/stb-master/stb_voxel_render.h:   // but is only 2 bits so doesn't want to be its own array.
include/stb-master/stb_voxel_render.h:   // Lighting is the one thing that was likely to already be
include/stb-master/stb_voxel_render.h:   // in use and that I could easily steal 2 bits from.)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   stbvox_block_type *blocktype;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinate. This is a core "block type" value, which is used
include/stb-master/stb_voxel_render.h:   // to index into other arrays; essentially a "palette". This is much more
include/stb-master/stb_voxel_render.h:   // memory-efficient and performance-friendly than storing the values explicitly,
include/stb-master/stb_voxel_render.h:   // but only makes sense if the values are always synchronized.
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // If a voxel's blocktype is 0, it is assumed to be empty (STBVOX_GEOM_empty),
include/stb-master/stb_voxel_render.h:   // and no other blocktypes should be STBVOX_GEOM_empty. (Only if you do not
include/stb-master/stb_voxel_render.h:   // have blocktypes should STBVOX_GEOM_empty ever used.)
include/stb-master/stb_voxel_render.h:   //
include/stb-master/stb_voxel_render.h:   // Normally it is an unsigned byte, but you can override it to be
include/stb-master/stb_voxel_render.h:   // a short if you have too many blocktypes.
