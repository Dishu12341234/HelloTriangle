include/stb-master/deprecated/stretchy_buffer.h:
include/stb-master/deprecated/stretchy_buffer.h:static void * stb__sbgrowf(void *arr, int increment, int itemsize)
include/stb-master/deprecated/stretchy_buffer.h:{
include/stb-master/deprecated/stretchy_buffer.h:   int dbl_cur = arr ? 2*stb__sbm(arr) : 0;
include/stb-master/deprecated/stretchy_buffer.h:   int min_needed = stb_sb_count(arr) + increment;
include/stb-master/deprecated/stretchy_buffer.h:   int m = dbl_cur > min_needed ? dbl_cur : min_needed;
include/stb-master/deprecated/stretchy_buffer.h:   int *p = (int *) realloc(arr ? stb__sbraw(arr) : 0, itemsize * m + sizeof(int)*2);
include/stb-master/deprecated/stretchy_buffer.h:   if (p) {
