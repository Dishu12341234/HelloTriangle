include/stb-master/stb_truetype.h:         ++i;
include/stb-master/stb_truetype.h:         --j;
include/stb-master/stb_truetype.h:      }
include/stb-master/stb_truetype.h:      /* recurse on smaller side, iterate on larger */
include/stb-master/stb_truetype.h:      if (j < (n-i)) {
