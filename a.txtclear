GameObject.cxx:std::atomic<uint32_t> GameObject::globalGOIDCounter{0};
GameObject.cxx:
GameObject.cxx:GameObject::GameObject(VulkanContext vkContext)
GameObject.cxx:{
GameObject.cxx:    GOID = globalGOIDCounter.fetch_add(1, std::memory_order_relaxed);
GameObject.cxx:    this->vkContext = vkContext;
GameObject.cxx:}
