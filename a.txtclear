include/stb-master/stb_voxel_render.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Uniform sample code
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:#if 0
include/stb-master/stb_voxel_render.h:// Run this once per frame before drawing all the meshes.
include/stb-master/stb_voxel_render.h:// You still need to separately set the 'transform' uniform for every mesh.
include/stb-master/stb_voxel_render.h:void setup_uniforms(GLuint shader, float camera_pos[4], GLuint tex1, GLuint tex2)
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   int i;
include/stb-master/stb_voxel_render.h:   glUseProgram(shader); // so uniform binding works
include/stb-master/stb_voxel_render.h:   for (i=0; i < STBVOX_UNIFORM_count; ++i) {
include/stb-master/stb_voxel_render.h:      stbvox_uniform_info sui;
include/stb-master/stb_voxel_render.h:      if (stbvox_get_uniform_info(&sui, i)) {
include/stb-master/stb_voxel_render.h:         GLint loc = glGetUniformLocation(shader, sui.name);
include/stb-master/stb_voxel_render.h:         if (loc != -1) {
include/stb-master/stb_voxel_render.h:            switch (i) {
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_camera_pos: // only needed for fog
include/stb-master/stb_voxel_render.h:                  glUniform4fv(loc, sui.array_length, camera_pos);
include/stb-master/stb_voxel_render.h:                  break;
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_tex_array: {
include/stb-master/stb_voxel_render.h:                  GLuint tex_unit[2] = { 0, 1 }; // your choice of samplers
include/stb-master/stb_voxel_render.h:                  glUniform1iv(loc, 2, tex_unit);
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:                  glActiveTexture(GL_TEXTURE0 + tex_unit[0]); glBindTexture(GL_TEXTURE_2D_ARRAY, tex1);
include/stb-master/stb_voxel_render.h:                  glActiveTexture(GL_TEXTURE0 + tex_unit[1]); glBindTexture(GL_TEXTURE_2D_ARRAY, tex2);
include/stb-master/stb_voxel_render.h:                  glActiveTexture(GL_TEXTURE0); // reset to default
include/stb-master/stb_voxel_render.h:                  break;
include/stb-master/stb_voxel_render.h:               }
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_face_data:
include/stb-master/stb_voxel_render.h:                  glUniform1i(loc, SAMPLER_YOU_WILL_BIND_PER_MESH_FACE_DATA_TO);
include/stb-master/stb_voxel_render.h:                  break;
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_ambient:     // you definitely want to override this
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_color_table: // you might want to override this
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_texscale:    // you may want to override this
include/stb-master/stb_voxel_render.h:                  glUniform4fv(loc, sui.array_length, sui.default_value);
include/stb-master/stb_voxel_render.h:                  break;
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_normals:     // you never want to override this
include/stb-master/stb_voxel_render.h:               case STBVOX_UNIFORM_texgen:      // you never want to override this
include/stb-master/stb_voxel_render.h:                  glUniform3fv(loc, sui.array_length, sui.default_value);
include/stb-master/stb_voxel_render.h:                  break;
include/stb-master/stb_voxel_render.h:            }
include/stb-master/stb_voxel_render.h:         }
include/stb-master/stb_voxel_render.h:      }
include/stb-master/stb_voxel_render.h:   }
include/stb-master/stb_voxel_render.h:}
include/stb-master/stb_voxel_render.h:#endif
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:#ifdef __cplusplus
include/stb-master/stb_voxel_render.h:}
include/stb-master/stb_voxel_render.h:#endif
