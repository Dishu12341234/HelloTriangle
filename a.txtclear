include/stb-master/stb_perlin.h:// public domain single-file C implementation by Sean Barrett
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// LICENSE
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h://   See end of file.
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// to create the implementation,
include/stb-master/stb_perlin.h://     #define STB_PERLIN_IMPLEMENTATION
include/stb-master/stb_perlin.h:// in *one* C/CPP file that includes this file.
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// Documentation:
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// float  stb_perlin_noise3( float x,
include/stb-master/stb_perlin.h://                           float y,
include/stb-master/stb_perlin.h://                           float z,
include/stb-master/stb_perlin.h://                           int   x_wrap=0,
include/stb-master/stb_perlin.h://                           int   y_wrap=0,
include/stb-master/stb_perlin.h://                           int   z_wrap=0)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// This function computes a random value at the coordinate (x,y,z).
include/stb-master/stb_perlin.h:// Adjacent random values are continuous but the noise fluctuates
include/stb-master/stb_perlin.h:// its randomness with period 1, i.e. takes on wholly unrelated values
include/stb-master/stb_perlin.h:// at integer points. Specifically, this implements Ken Perlin's
include/stb-master/stb_perlin.h:// revised noise function from 2002.
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// The "wrap" parameters can be used to create wraparound noise that
include/stb-master/stb_perlin.h:// wraps at powers of two. The numbers MUST be powers of two. Specify
include/stb-master/stb_perlin.h:// 0 to mean "don't care". (The noise always wraps every 256 due
include/stb-master/stb_perlin.h:// details of the implementation, even if you ask for larger or no
include/stb-master/stb_perlin.h:// wrapping.)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// float  stb_perlin_noise3_seed( float x,
include/stb-master/stb_perlin.h://                                float y,
include/stb-master/stb_perlin.h://                                float z,
include/stb-master/stb_perlin.h://                                int   x_wrap=0,
include/stb-master/stb_perlin.h://                                int   y_wrap=0,
include/stb-master/stb_perlin.h://                                int   z_wrap=0,
include/stb-master/stb_perlin.h://                                int   seed)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// As above, but 'seed' selects from multiple different variations of the
include/stb-master/stb_perlin.h:// noise function. The current implementation only uses the bottom 8 bits
include/stb-master/stb_perlin.h:// of 'seed', but possibly in the future more bits will be used.
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// Fractal Noise:
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// Three common fractal noise functions are included, which produce
include/stb-master/stb_perlin.h:// a wide variety of nice effects depending on the parameters
include/stb-master/stb_perlin.h:// provided. Note that each function will call stb_perlin_noise3
include/stb-master/stb_perlin.h:// 'octaves' times, so this parameter will affect runtime.
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// float stb_perlin_ridge_noise3(float x, float y, float z,
include/stb-master/stb_perlin.h://                               float lacunarity, float gain, float offset, int octaves)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// float stb_perlin_fbm_noise3(float x, float y, float z,
include/stb-master/stb_perlin.h://                             float lacunarity, float gain, int octaves)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// float stb_perlin_turbulence_noise3(float x, float y, float z,
include/stb-master/stb_perlin.h://                                    float lacunarity, float gain, int octaves)
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// Typical values to start playing with:
include/stb-master/stb_perlin.h://     octaves    =   6     -- number of "octaves" of noise3() to sum
include/stb-master/stb_perlin.h://     lacunarity = ~ 2.0   -- spacing between successive octaves (use exactly 2.0 for wrapping output)
include/stb-master/stb_perlin.h://     gain       =   0.5   -- relative weighting applied to each successive octave
include/stb-master/stb_perlin.h://     offset     =   1.0?  -- used to invert the ridges, may need to be larger, not sure
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h://
include/stb-master/stb_perlin.h:// Contributors:
include/stb-master/stb_perlin.h://    Jack Mott - additional noise functions
include/stb-master/stb_perlin.h://    Jordan Peck - seeded noise
include/stb-master/stb_perlin.h://
