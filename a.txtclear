include/stb-master/tests/caveview/stb_gl.h:extern void stbgl_initCamera_zup_facing_y(void);
include/stb-master/tests/caveview/stb_gl.h:extern void stbgl_positionCameraWithEulerAngles(float *loc, float *ang);
