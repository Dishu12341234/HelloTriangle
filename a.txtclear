include/stb-master/stb_leakcheck.h:struct malloc_info
include/stb-master/stb_leakcheck.h:{
include/stb-master/stb_leakcheck.h:   const char *file;
include/stb-master/stb_leakcheck.h:   int line;
include/stb-master/stb_leakcheck.h:   size_t size;
