include/stb-master/stb_truetype.h:   /* threshold for transitioning to insertion sort */
include/stb-master/stb_truetype.h:   while (n > 12) {
include/stb-master/stb_truetype.h:      stbtt__edge t;
include/stb-master/stb_truetype.h:      int c01,c12,c,m,i,j;
include/stb-master/stb_truetype.h:
include/stb-master/stb_truetype.h:      /* compute median of three */
include/stb-master/stb_truetype.h:      m = n >> 1;
include/stb-master/stb_truetype.h:      c01 = STBTT__COMPARE(&p[0],&p[m]);
include/stb-master/stb_truetype.h:      c12 = STBTT__COMPARE(&p[m],&p[n-1]);
include/stb-master/stb_truetype.h:      /* if 0 >= mid >= end, or 0 < mid < end, then use mid */
include/stb-master/stb_truetype.h:      if (c01 != c12) {
