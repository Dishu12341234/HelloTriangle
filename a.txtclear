include/stb-master/stb_truetype.h:      stbtt_MakeCodepointBitmapSubpixel(&font, &screen[baseline + y0][(int) xpos + x0], x1-x0,y1-y0, 79, scale,scale,x_shift,0, text[ch]);
include/stb-master/stb_truetype.h:      // note that this stomps the old data, so where character boxes overlap (e.g. 'lj') it's wrong
include/stb-master/stb_truetype.h:      // because this API is really for baking character bitmaps into textures. if you want to render
include/stb-master/stb_truetype.h:      // a sequence of characters, you really need to render each bitmap to a temp buffer, then
include/stb-master/stb_truetype.h:      // "alpha blend" that into the working buffer
