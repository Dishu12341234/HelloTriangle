include/stb-master/stb_voxel_render.h:   unsigned char *texlerp_simple;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinates, this is the smallest texlerp encoding
include/stb-master/stb_voxel_render.h:   // that can do useful work. It consits of three values: baselerp,
include/stb-master/stb_voxel_render.h:   // vertlerp, and face_vertlerp. Baselerp defines the value
include/stb-master/stb_voxel_render.h:   // to use on all of the faces but one, from the STBVOX_TEXLERP_BASE
include/stb-master/stb_voxel_render.h:   // values. face_vertlerp is one of the 6 face values (or STBVOX_FACE_NONE)
include/stb-master/stb_voxel_render.h:   // which specifies the face should use the vertlerp values.
include/stb-master/stb_voxel_render.h:   // Vertlerp defines a lerp value at every vertex of the mesh.
include/stb-master/stb_voxel_render.h:   // Thus, one face can have per-vertex texlerp values, and those
include/stb-master/stb_voxel_render.h:   // values are encoded in the space so that they will be shared
include/stb-master/stb_voxel_render.h:   // by adjacent faces that also use vertlerp, allowing continuity
include/stb-master/stb_voxel_render.h:   // (this is used for the "texture crossfade" bit of the release video).
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_TEXLERP_SIMPLE(baselerp, vertlerp, face_vertlerp)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   // The following texlerp encodings are experimental and maybe not
include/stb-master/stb_voxel_render.h:   // that useful.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned char *texlerp;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinates, this defines four values:
include/stb-master/stb_voxel_render.h:   //   vertlerp is a lerp value at every vertex of the mesh (using STBVOX_TEXLERP_BASE values).
include/stb-master/stb_voxel_render.h:   //   ud is the value to use on up and down faces, from STBVOX_TEXLERP_FACE values
include/stb-master/stb_voxel_render.h:   //   ew is the value to use on east and west faces, from STBVOX_TEXLERP_FACE values
include/stb-master/stb_voxel_render.h:   //   ns is the value to use on north and south faces, from STBVOX_TEXLERP_FACE values
include/stb-master/stb_voxel_render.h:   // If any of ud, ew, or ns is STBVOX_TEXLERP_FACE_use_vert, then the
include/stb-master/stb_voxel_render.h:   // vertlerp values for the vertices are gathered and used for those faces.
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_TEXLERP(vertlerp,ud,ew,sw)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned short *texlerp_vert3;
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinates, this works with texlerp and
include/stb-master/stb_voxel_render.h:   // provides a unique texlerp value for every direction at
include/stb-master/stb_voxel_render.h:   // every vertex. The same rules of whether faces share values
include/stb-master/stb_voxel_render.h:   // applies. The STBVOX_TEXLERP_FACE vertlerp value defined in
include/stb-master/stb_voxel_render.h:   // texlerp is only used for the down direction. The values at
include/stb-master/stb_voxel_render.h:   // each vertex in other directions are defined in this array,
include/stb-master/stb_voxel_render.h:   // and each uses the STBVOX_TEXLERP3 values (i.e. full precision
include/stb-master/stb_voxel_render.h:   // 3-bit texlerp values).
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_VERT3(vertlerp_e,vertlerp_n,vertlerp_w,vertlerp_s,vertlerp_u)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned short *texlerp_face3;          // e:3,n:3,w:3,s:3,u:2,d:2
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinates, this provides a compact way to
include/stb-master/stb_voxel_render.h:   // fully specify the texlerp value indepenendly for every face,
include/stb-master/stb_voxel_render.h:   // but doesn't allow per-vertex variation. E/N/W/S values are
include/stb-master/stb_voxel_render.h:   // encoded using STBVOX_TEXLERP3 values, whereas up and down
include/stb-master/stb_voxel_render.h:   // use STBVOX_TEXLERP_SIMPLE values.
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_FACE3(face_e,face_n,face_w,face_s,face_u,face_d)
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned char *vheight;                 // STBVOX_MAKE_VHEIGHT   -- sw:2, se:2, nw:2, ne:2, doesn't rotate
include/stb-master/stb_voxel_render.h:   // Indexed by 3D coordinates, this defines the four
include/stb-master/stb_voxel_render.h:   // vheight values to use if the geometry is STBVOX_GEOM_vheight*.
include/stb-master/stb_voxel_render.h:   // See the vheight discussion.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:   unsigned char *packed_compact;
include/stb-master/stb_voxel_render.h:   // Stores block rotation, vheight, and texlerp values:
include/stb-master/stb_voxel_render.h:   //    block rotation: 2 bits
include/stb-master/stb_voxel_render.h:   //    vertex vheight: 2 bits
include/stb-master/stb_voxel_render.h:   //    use_texlerp   : 1 bit
include/stb-master/stb_voxel_render.h:   //    vertex texlerp: 3 bits
include/stb-master/stb_voxel_render.h:   // If STBVOX_CONFIG_UP_TEXLERP_PACKED is defined, then 'vertex texlerp' is
include/stb-master/stb_voxel_render.h:   // used for up faces if use_texlerp is 1. If STBVOX_CONFIG_DOWN_TEXLERP_PACKED
include/stb-master/stb_voxel_render.h:   // is defined, then 'vertex texlerp' is used for down faces if use_texlerp is 1.
include/stb-master/stb_voxel_render.h:   // Note if those symbols are defined but packed_compact is NULL, the normal
include/stb-master/stb_voxel_render.h:   // texlerp default will be used.
include/stb-master/stb_voxel_render.h:   // Encode with STBVOX_MAKE_PACKED_COMPACT(rot, vheight, texlerp, use_texlerp)
include/stb-master/stb_voxel_render.h:};
include/stb-master/stb_voxel_render.h:// @OPTIMIZE allow specializing; build a single struct with all of the
include/stb-master/stb_voxel_render.h:// 3D-indexed arrays combined so it's AoS instead of SoA for better
include/stb-master/stb_voxel_render.h:// cache efficiency
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h://////////////////////////////////////////////////////////////////////////////
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://  VHEIGHT DOCUMENTATION
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://  "vheight" is the internal name for the special block types
include/stb-master/stb_voxel_render.h://  with sloped tops or bottoms. "vheight" stands for "vertex height".
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://  Note that these blocks are very flexible (there are 256 of them,
include/stb-master/stb_voxel_render.h://  although at least 17 of them should never be used), but they
include/stb-master/stb_voxel_render.h://  also have a disadvantage that they generate extra invisible
include/stb-master/stb_voxel_render.h://  faces; the generator does not currently detect whether adjacent
include/stb-master/stb_voxel_render.h://  vheight blocks hide each others sides, so those side faces are
include/stb-master/stb_voxel_render.h://  always generated. For a continuous ground terrain, this means
include/stb-master/stb_voxel_render.h://  that you may generate 5x as many quads as needed. See notes
include/stb-master/stb_voxel_render.h://  on "improvements for shipping products" in the introduction.
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:enum
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   STBVOX_VERTEX_HEIGHT_0,
include/stb-master/stb_voxel_render.h:   STBVOX_VERTEX_HEIGHT_half,
include/stb-master/stb_voxel_render.h:   STBVOX_VERTEX_HEIGHT_1,
include/stb-master/stb_voxel_render.h:   STBVOX_VERTEX_HEIGHT_one_and_a_half,
include/stb-master/stb_voxel_render.h:};
include/stb-master/stb_voxel_render.h:// These are the "vheight" values. Vheight stands for "vertex height".
include/stb-master/stb_voxel_render.h:// The idea is that for a "floor vheight" block, you take a cube and
include/stb-master/stb_voxel_render.h:// reposition the top-most vertices at various heights as specified by
include/stb-master/stb_voxel_render.h:// the vheight values. Similarly, a "ceiling vheight" block takes a
include/stb-master/stb_voxel_render.h:// cube and repositions the bottom-most vertices.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// A floor block only adjusts the top four vertices; the bottom four vertices
include/stb-master/stb_voxel_render.h:// remain at the bottom of the block. The height values are 2 bits,
include/stb-master/stb_voxel_render.h:// measured in halves of a block; so you can specify heights of 0/2,
include/stb-master/stb_voxel_render.h:// 1/2, 2/2, or 3/2. 0 is the bottom of the block, 1 is halfway
include/stb-master/stb_voxel_render.h:// up the block, 2 is the top of the block, and 3 is halfway up the
include/stb-master/stb_voxel_render.h:// next block (and actually outside of the block). The value 3 is
include/stb-master/stb_voxel_render.h:// actually legal for floor vheight (but not ceiling), and allows you to:
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h://     (A) have smoother terrain by having slopes that cross blocks,
include/stb-master/stb_voxel_render.h://         e.g. (1,1,3,3) is a regular-seeming slope halfway between blocks
include/stb-master/stb_voxel_render.h://     (B) make slopes steeper than 45-degrees, e.g. (0,0,3,3)
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// (Because only z coordinates have half-block precision, and x&y are
include/stb-master/stb_voxel_render.h:// limited to block corner precision, it's not possible to make these
include/stb-master/stb_voxel_render.h:// things "properly" out of blocks, e.g. a half-slope block on its side
include/stb-master/stb_voxel_render.h:// or a sloped block halfway between blocks that's made out of two blocks.)
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// If you define STBVOX_CONFIG_OPTIMIZED_VHEIGHT, then the top face
include/stb-master/stb_voxel_render.h:// (or bottom face for a ceiling vheight block) will be drawn as a
include/stb-master/stb_voxel_render.h:// single quad even if the four vertex heights aren't planar, and a
include/stb-master/stb_voxel_render.h:// single normal will be used over the entire quad. If you
include/stb-master/stb_voxel_render.h:// don't define it, then if the top face is non-planar, it will be
include/stb-master/stb_voxel_render.h:// split into two triangles, each with their own normal/lighting.
include/stb-master/stb_voxel_render.h:// (Note that since all output from stb_voxel_render is quad meshes,
include/stb-master/stb_voxel_render.h:// triangles are actually rendered as degenerate quads.) In this case,
include/stb-master/stb_voxel_render.h:// the distinction between STBVOX_GEOM_floor_vheight_03 and
include/stb-master/stb_voxel_render.h:// STBVOX_GEOM_floor_vheight_12 comes into play; the former introduces
include/stb-master/stb_voxel_render.h:// an edge from the SW to NE corner (i.e. from <0,0,?> to <1,1,?>),
include/stb-master/stb_voxel_render.h:// while the latter introduces an edge from the NW to SE corner
include/stb-master/stb_voxel_render.h:// (i.e. from <0,1,?> to <1,0,?>.) For a "lazy mesh" look, use
include/stb-master/stb_voxel_render.h:// exclusively _03 or _12. For a "classic mesh" look, alternate
include/stb-master/stb_voxel_render.h:// _03 and _12 in a checkerboard pattern. For a "smoothest surface"
include/stb-master/stb_voxel_render.h:// look, choose the edge based on actual vertex heights.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// The four vertex heights can come from several places. The simplest
include/stb-master/stb_voxel_render.h:// encoding is to just use the 'vheight' parameter which stores four
include/stb-master/stb_voxel_render.h:// explicit vertex heights for every block. This allows total independence,
include/stb-master/stb_voxel_render.h:// but at the cost of the largest memory usage, 1 byte per 3D block.
include/stb-master/stb_voxel_render.h:// Encode this with STBVOX_MAKE_VHEIGHT(vh_sw, vh_se, vh_nw, vh_ne).
include/stb-master/stb_voxel_render.h:// These coordinates are absolute, not affected by block rotations.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// An alternative if you just want to encode some very specific block
include/stb-master/stb_voxel_render.h:// types, not all the possibilities--say you just want half-height slopes,
include/stb-master/stb_voxel_render.h:// so you want (0,0,1,1) and (1,1,2,2)--then you can use block_vheight
include/stb-master/stb_voxel_render.h:// to specify them. The geometry rotation will cause block_vheight values
include/stb-master/stb_voxel_render.h:// to be rotated (because it's as if you're just defining a type of
include/stb-master/stb_voxel_render.h:// block). This value is also encoded with STBVOX_MAKE_VHEIGHT.
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// If you want to save memory and you're creating a "continuous ground"
include/stb-master/stb_voxel_render.h:// sort of effect, you can make each vertex of the lattice share the
include/stb-master/stb_voxel_render.h:// vheight value; that is, two adjacent blocks that share a vertex will
include/stb-master/stb_voxel_render.h:// always get the same vheight value for that vertex. Then you need to
include/stb-master/stb_voxel_render.h:// store two bits of vheight for every block, which you do by storing it
include/stb-master/stb_voxel_render.h:// as part another data structure. Store the south-west vertex's vheight
include/stb-master/stb_voxel_render.h:// with the block. You can either use the "geometry" mesh variable (it's
include/stb-master/stb_voxel_render.h:// a parameter to STBVOX_MAKE_GEOMETRY) or you can store it in the
include/stb-master/stb_voxel_render.h:// "lighting" mesh variable if you defined STBVOX_CONFIG_VHEIGHT_IN_LIGHTING,
include/stb-master/stb_voxel_render.h:// using STBVOX_MAKE_LIGHTING_EXT(lighting,vheight).
include/stb-master/stb_voxel_render.h://
include/stb-master/stb_voxel_render.h:// Note that if you start with a 2D height map and generate vheight data from
include/stb-master/stb_voxel_render.h:// it, you don't necessarily store only one value per (x,y) coordinate,
include/stb-master/stb_voxel_render.h:// as the same value may need to be set up at multiple z heights. For
include/stb-master/stb_voxel_render.h:// example, if height(8,8) = 13.5, then you want the block at (8,8,13)
include/stb-master/stb_voxel_render.h:// to store STBVOX_VERTEX_HEIGHT_half, and this will be used by blocks
include/stb-master/stb_voxel_render.h:// at (7,7,13), (8,7,13), (7,8,13), and (8,8,13). However, if you're
include/stb-master/stb_voxel_render.h:// allowing steep slopes, it might be the case that you have a block
include/stb-master/stb_voxel_render.h:// at (7,7,12) which is supposed to stick up to 13.5; that means
include/stb-master/stb_voxel_render.h:// you also need to store STBVOX_VERTEX_HEIGHT_one_and_a_half at (8,8,12).
include/stb-master/stb_voxel_render.h:
include/stb-master/stb_voxel_render.h:enum
include/stb-master/stb_voxel_render.h:{
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_FACE_0,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_FACE_half,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_FACE_1,
include/stb-master/stb_voxel_render.h:   STBVOX_TEXLERP_FACE_use_vert,
include/stb-master/stb_voxel_render.h:};
include/stb-master/stb_voxel_render.h:
